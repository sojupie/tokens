# Go build cache, crawler payload cache, and other generated caches.
.cache/
.tokens/

# Generated crawler evidence. Crawl receipts are local run output; curated,
# reviewed snapshots are intentionally added to Git.
crawl-results/*.json
sources/raw/
sources/normalized/
sources/runs/

# New captures stay local; deliberately selected snapshot fixtures may be
# force-added. Existing tracked snapshots remain tracked.
/snapshots/material-token-data/*/

# Rebuildable publications and local review output.
/published/
/published-*/
/review/

# Local diagnostics and build output.
bin/
inspect.txt
coverage/
dist/
*.log
*.tmp
.idea/
.vscode/

# Local environment overrides.
.env
.env.*
*.env
!.env.example

# Platform files.
.DS_Store
Thumbs.db
