# Go build cache, crawler payload cache, and other generated caches.
.cache/
.tokens/

# Generated crawler evidence and receipts stay local.
crawl-results/*
!crawl-results/.gitkeep
sources/raw/
sources/normalized/
sources/runs/

# Snapshot payloads and token data stay local or on production volumes;
# Google Material Design 3 tokens are fetched during deployment.
/snapshots/material-token-data/*
!/snapshots/material-token-data/.gitkeep

# Rebuildable publications and local review output.
/published/
/published-*/
/review/

# Local diagnostics and build output.
bin/
inspect.txt
coverage/
dist/
*.log
*.tmp
.idea/
.vscode/

# Local environment overrides.
.env
.env.*
*.env
!.env.example

# Platform files.
.DS_Store
Thumbs.db

# Token build dependencies and generated assets.
node_modules/

# Rendered documentation captures and version receipts.
/snapshots/material-guidance/

# Immutable local implementation assessment snapshots.
/snapshots/implementation-baselines/

# Local motion inspection recordings and measurements.
/snapshots/motion/
