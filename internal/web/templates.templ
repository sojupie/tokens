package web

import (
	"github.com/sojupie/m3-source/internal/publish"
)

templ layout(title string) {
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" href="/static/app.css"/>
		<link rel="stylesheet" href="/static/token-table.css?v=20261005-timeline"/>
		<script src="/static/htmx.min.js" defer></script>
		<title>{ title } · Source Loom</title>
	</head>
	<body class="sl-body">
		<header class="sl-site-header">
			<nav class="sl-primary-nav" aria-label="Primary">
				<a class="sl-brand typo-page-title" href="/">Source Loom</a>
				<div class="sl-nav-links">
					<a class="sl-nav-link typo-nav" href="/components">Components</a>
					<a class="sl-nav-link typo-nav" href="/styles">Styles and token sources</a>
					<a class="sl-nav-link typo-nav" href="/changes">Change log</a>
				</div>
			</nav>
		</header>
		<main class="sl-main">
			{ children... }
		</main>
	</body>
</html>
}

templ overviewPage(snapshot publish.SnapshotView, subjects []publish.SubjectView) {
@layout("Published Material tokens") {
		<h1 class="typo-page-title">Published Material tokens</h1>
		<p class="typo-page-deck">Current snapshot: <code class="sl-code">{ snapshot.ID }</code></p>
		<p class="sl-metadata">Detected: { snapshot.CreatedAt }</p>

		<section class="sl-section" aria-labelledby="components-heading">
			<h2 class="typo-section-header" id="components-heading">Components</h2>
			<ul class="sl-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind == publish.SubjectComponent {
						<li class="sl-card"><a class="sl-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="typo-sublabel">({ len(subject.Tokens) } tokens)</small></li>
					}
				}
			</ul>
		</section>

		<section class="sl-section" aria-labelledby="styles-heading">
			<h2 class="typo-section-header" id="styles-heading">Styles and token sources</h2>
			<ul class="sl-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind != publish.SubjectComponent {
						<li class="sl-card"><a class="sl-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="typo-sublabel">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></li>
					}
				}
			</ul>
		</section>
}
}

templ subjectListPage(snapshot publish.SnapshotView, subjects []publish.SubjectView, styles bool, query string) {
@layout("Published Material subjects") {
		if styles {
			<h1 class="typo-page-title">Styles and token sources</h1>
		} else {
			<h1 class="typo-page-title">Components</h1>
		}
		<p class="sl-metadata">Current snapshot: <code class="sl-code">{ snapshot.ID }</code></p>
		<form class="sl-search-form" method="get" action={ subjectListPath(styles) } role="search">
			<label class="typo-sublabel" for="subject-search">Search by name or slug</label>
			<input class="sl-search-input" id="subject-search" type="search" name="q" value={ query } autocomplete="off"
				hx-get={ subjectListPath(styles) }
				hx-target="#subject-list"
				hx-trigger="input changed delay:250ms"
				hx-push-url="true"/>
		</form>
		<div id="subject-list" class="sl-list-panel">
			@subjectList(subjects)
		</div>
}
}

templ subjectList(subjects []publish.SubjectView) {
	<ul class="sl-subject-list">
		for _, subject := range subjects {
			<li class="sl-list-item"><a class="sl-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="typo-sublabel">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></li>
		}
		if len(subjects) == 0 {
			<li class="sl-empty typo-sublabel">No matching subjects.</li>
		}
	</ul>
}

templ subjectPage(subject publish.SubjectView, changes []publish.ChangeView, browser tokenBrowser) {
    @subjectPageComponent(subject, changes, browser)
}

templ changesPage(snapshots []publish.SnapshotView, subject string, baseURL string, changes []publish.ChangeView, page int, total int, hasPrevious bool, hasNext bool) {
@layout(changePageTitle(subject)) {
		<h1 class="typo-page-title">{ changePageTitle(subject) }</h1>
		<p class="sl-metadata">{ historyCoverage(snapshots) }</p>
		<p>Dates show when Source Loom observed a change, not when Material published it. The first snapshot is the starting point.</p>
		if total > 0 {
			<p class="sl-metadata">Showing page { page } of { (total + 49) / 50 } · { total } total changes</p>
		}
		if len(changes) == 0 {
			if len(snapshots) < 2 {
				<p>At least two snapshots are needed to detect changes.</p>
			} else {
				<p>No changes were detected in the retained snapshot history.</p>
			}
		}
		for _, batch := range changeBatches(changes, snapshots) {
			<section class="sl-section sl-timeline-batch">
				<h2 class="typo-section-header">Observed <time datetime={ batch.DetectedAt }>{ observationDate(batch.DetectedAt) }</time></h2>
				if batch.PreviousAt != "" {
					<p class="sl-metadata">Compared with { observationDate(batch.PreviousAt) }</p>
				}
		for _, change := range batch.Changes {
			<article class="sl-change-card">
				<h3>{ changeTypeLabel(change.Type) }: <code>{ change.Name }</code></h3>
				if change.Subject != "" {
					<p>Subject: <code>{ change.Subject }</code></p>
				}
				<div class="sl-change-values sl-change-summary">
					<div>
						<p class="typo-sublabel">Before</p>
						<code>{ changeSummaryValue(change.Before) }</code>
					</div>
					<div class="sl-change-arrow" aria-hidden="true">→</div>
					<div>
						<p class="typo-sublabel">After</p>
						<code>{ changeSummaryValue(change.After) }</code>
					</div>
				</div>
			</article>
		}
			</section>
		}
		if hasPrevious || hasNext {
			<nav class="sl-pagination" aria-label="Change log pages">
				if hasPrevious {
					<a class="sl-link" href={ changesPageURL(baseURL, page - 1) }>Previous</a>
				}
				<span class="typo-sublabel">Page { page }</span>
				if hasNext {
					<a class="sl-link" href={ changesPageURL(baseURL, page + 1) }>Next</a>
				}
			</nav>
		}
}
}
