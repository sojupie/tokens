package web

import (
	"strings"
	"github.com/sojupie/tokens/internal/publish"
)

templ layout(title string) {
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<script src={ staticURL("theme.js") }></script>
		<link rel="stylesheet" href={ themeURL(ctx) }/>
		<link rel="stylesheet" href={ staticURL("app.css") }/>
		<link rel="stylesheet" href={ staticURL("token-table.css") }/>
		<script src={ staticURL("htmx.min.js") } defer></script>
		<script src={ staticURL("token-table.js") } defer></script>
		<link rel="icon" type="image/png" sizes="250x250" href={ staticURL("logo-250x250.png") }/>
		<link rel="apple-touch-icon" href={ staticURL("logo-250x250.png") }/>
		<title>{ pageTitle(ctx, title) } · Tokens</title>
		<meta name="description" content={ metadata(ctx).Description }/>
		if metadata(ctx).AgentDiscovery {
			<link rel="describedby" href="/agents.json" type="application/json"/>
			<link rel="describedby" href="/llms.txt" type="text/plain"/>
			<link rel="service-desc" href="/openapi.json" type="application/json"/>
		}
		if metadata(ctx).JSONAlternate != "" {
			<link rel="alternate" href={ templ.SafeURL(metadata(ctx).JSONAlternate) } type="application/json" title="Token data for this view"/>
		}
		if metadata(ctx).Canonical != "" {
			<link rel="canonical" href={ templ.SafeURL(metadata(ctx).Canonical) }/>
		}
		if metadata(ctx).NoIndex {
			<meta name="robots" content="noindex, follow"/>
		}
	</head>
	<body class="tokens-body">
		<header class="tokens-site-header">
			<nav class="tokens-primary-nav" aria-label="Primary">
				<a class="tokens-brand md-typescale-headline-medium" href="/"><img class="tokens-brand-logo" src={ staticURL("logo-250x250.png") } alt="" width="40" height="40"/>Tokens</a>
				<div class="tokens-nav-links">
					<a class="tokens-nav-link md-typescale-label-large" href="/components">Components</a>
					<a class="tokens-nav-link md-typescale-label-large" href="/styles">Styles and token sources</a>
					<a class="tokens-nav-link md-typescale-label-large" href="/changes">Change log</a>
				</div>
				<div class="tokens-theme-controls" role="group" aria-label="Site appearance">
					<button type="button" data-app-theme aria-label="Dark mode" aria-pressed="false" title="Dark mode" disabled>
						<span data-theme-icon="light">
							@materialSymbol("dark_mode")
						</span>
						<span data-theme-icon="dark" hidden>
							@materialSymbol("light_mode")
						</span>
					</button>
					<div class="tokens-contrast-buttons" role="group" aria-label="Contrast">
						<button type="button" data-app-contrast="default" aria-label="Standard contrast" aria-pressed="true" title="Standard contrast" disabled>
							@materialSymbol("brightness_low")
						</button>
						<button type="button" data-app-contrast="medium" aria-label="Medium contrast" aria-pressed="false" title="Medium contrast" disabled>
							@materialSymbol("brightness_medium")
						</button>
						<button type="button" data-app-contrast="high" aria-label="High contrast" aria-pressed="false" title="High contrast" disabled>
							@materialSymbol("brightness_high")
						</button>
					</div>
				</div>
			</nav>
		</header>
		<main class="tokens-main">
			{ children... }
		</main>
		<footer class="tokens-site-footer">
			<div class="tokens-footer-content">
				<div>
					<p class="md-typescale-title-medium">Tokens</p>
					<p class="md-typescale-body-medium">Browse Material Design tokens and track their changes.</p>
					<p class="md-typescale-body-medium">Independent project. Not affiliated with Google.</p>
				</div>
				<div>
					<p class="md-typescale-title-medium">Resources</p>
					if metadata(ctx).AgentDiscovery {
						<a class="tokens-link md-typescale-body-medium" href="/llms-full.txt">API and agent guide</a>
					}
					@siteDownloadMenu()
				</div>
				<div>
					<p class="md-typescale-title-medium">About</p>
					<p class="md-typescale-body-medium">Made by Olle Marmenlind</p>
					<a class="tokens-link md-typescale-body-medium" href="https://marmenlind.com">marmenlind.com</a>
				</div>
			</div>
		</footer>
	</body>
</html>
}

templ overviewPage(snapshot publish.SnapshotView, subjects []publish.SubjectView) {
@layout("Published Material tokens") {
		<header class="tokens-subject-heading">
			<h1 class="md-typescale-headline-medium">Published Material tokens</h1>
			@siteDownloadButton("all")
		</header>
		<p class="md-typescale-body-large">Current snapshot: <code class="tokens-code">{ snapshot.ID }</code></p>
		<p class="tokens-metadata">Detected: { snapshot.CreatedAt }</p>

		<section class="tokens-section" aria-labelledby="components-heading">
			<h2 class="md-typescale-title-medium" id="components-heading">Components</h2>
			<ul class="tokens-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind == publish.SubjectComponent {
						<li class="tokens-card"><a class="tokens-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="md-typescale-body-small">({ len(subject.Tokens) } tokens)</small></li>
					}
				}
			</ul>
		</section>

		<section class="tokens-section" aria-labelledby="styles-heading">
			<h2 class="md-typescale-title-medium" id="styles-heading">Styles and token sources</h2>
			<ul class="tokens-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind != publish.SubjectComponent {
						<li class="tokens-card"><a class="tokens-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="md-typescale-body-small">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></li>
					}
				}
			</ul>
		</section>
}
}

templ subjectListPage(snapshot publish.SnapshotView, subjects []publish.SubjectView, styles bool, query string) {
@layout("Published Material subjects") {
		<header class="tokens-subject-heading">
		if styles {
			<h1 class="md-typescale-headline-medium">Styles and token sources</h1>
			@siteDownloadButton("styles")
		} else {
			<h1 class="md-typescale-headline-medium">Components</h1>
			@siteDownloadButton("components")
		}
		</header>
		<p class="tokens-metadata">Current snapshot: <code class="tokens-code">{ snapshot.ID }</code></p>
		<form class="tokens-search-form" method="get" action={ subjectListPath(styles) } role="search">
			<label class="md-typescale-body-medium" for="subject-search">Search by name or slug</label>
			<input class="tokens-search-input" id="subject-search" type="search" name="q" value={ query } autocomplete="off"
				hx-get={ subjectListPath(styles) }
				hx-target="#subject-list"
				hx-trigger="input changed delay:250ms"
				hx-push-url="true"/>
		</form>
		<div id="subject-list" class="tokens-list-panel">
			@subjectList(subjects)
		</div>
}
}

templ siteDownloadButton(scope string) {
	<div class="tokens-token-download">
		<button type="button" data-site-download-open={ scope } aria-haspopup="dialog" aria-controls="tokens-site-download">Download JSON</button>
	</div>
}

templ siteDownloadMenu() {
	<div class="tokens-token-download">
		<button type="button" data-download-open aria-haspopup="dialog" aria-controls="tokens-site-download">Download JSON</button>
		<dialog id="tokens-site-download" aria-labelledby="tokens-site-download-title">
			<form method="get" action="/downloads/tokens.json">
				<h2 id="tokens-site-download-title">Download tokens</h2>
				<fieldset>
					<legend>What should the file include?</legend>
					<label class="tokens-download-option"><input type="radio" name="scope" value="components"/><span><strong>Components</strong><small>Every component, token set and supported context.</small></span></label>
					<label class="tokens-download-option"><input type="radio" name="scope" value="styles"/><span><strong>Styles and token sources</strong><small>All style and foundation tokens, with every supported context.</small></span></label>
					<label class="tokens-download-option"><input type="radio" name="scope" value="all" checked/><span><strong>All tokens</strong><small>Everything in the current publication, including components and styles.</small></span></label>
				</fieldset>
				<footer><button type="button" data-download-cancel>Cancel</button><button type="submit">Download JSON</button></footer>
			</form>
		</dialog>
		<noscript>
			<a class="tokens-link" href="/downloads/tokens.json?scope=components">Download components</a>
			<a class="tokens-link" href="/downloads/tokens.json?scope=styles">Download styles</a>
			<a class="tokens-link" href="/downloads/tokens.json?scope=all">Download all tokens</a>
		</noscript>
	</div>
}

templ subjectList(subjects []publish.SubjectView) {
	<ul class="tokens-subject-list">
		for _, subject := range subjects {
			<li class="tokens-list-item"><a class="tokens-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="md-typescale-body-small">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></li>
		}
		if len(subjects) == 0 {
			<li class="tokens-empty md-typescale-body-large">No matching subjects.</li>
		}
	</ul>
}

templ subjectPage(subject publish.SubjectView, changes []publish.ChangeView, browser tokenBrowser) {
    @subjectPageComponent(subject, changes, browser)
}

templ tokenSetPicker(subject publish.SubjectView, browser tokenBrowser) {
	<button class="tokens-token-set" type="button" popovertarget="tokens-token-set-menu" aria-label={ "Token set: " + tokenSetLabel(browser.Selected) }>
		{ tokenSetLabel(browser.Selected) }
		@materialSymbol("expand_more")
	</button>
	<nav class="tokens-token-set-menu" id="tokens-token-set-menu" popover="auto" aria-label="Token sets">
		<a class="tokens-link tokens-token-set-overview" href={ subjectURL(subject) }>{ subject.Name } overview</a>
		for _, group := range tokenSetMenuGroups(browser.Sets) {
			<section>
				<h3 class="md-typescale-title-medium">{ group.Label }</h3>
				<ul>
					for _, set := range group.Sets {
						<li>
							<a href={ tokenSetLinkURL(subject, set, browser) } aria-current={ currentTokenSet(set.Key == browser.Selected.Key) }>
								@materialSymbol("check")
								{ tokenSetMenuLabel(set) }
							</a>
						</li>
					}
				</ul>
			</section>
		}
	</nav>
}

templ changesPage(state publish.PublishedState, subject string, baseURL string, filters changeFilters, counts string, changes []publish.ChangeView, page int, total int, hasPrevious bool, hasNext bool) {
@layout(timelineTitle(subject, state.Subjects)) {
		<h1 class="md-typescale-headline-medium">{ timelineTitle(subject, state.Subjects) }</h1>
		<p class="tokens-metadata">{ historyCoverage(state.Snapshots) }</p>
		<p class="md-typescale-body-medium">Dates show when we detected changes, not when Material published them.</p>
		@changeFilterForm(filters, baseURL)
		if total > 0 && subject != "" {
			<p class="tokens-metadata">Showing page { page } of { (total + 49) / 50 } · { total } total changes</p>
			<p class="tokens-change-counts">{ counts }. One token can have changes in several settings.</p>
		}
		if len(changes) == 0 {
			if len(state.Snapshots) < 2 {
				<p>At least two snapshots are needed to detect changes.</p>
			} else if len(state.Changes) > 0 {
				<p>No changes match these filters.</p>
			} else {
				<p>No changes were detected in the retained snapshot history.</p>
			}
		}
		for _, batch := range changeBatches(changes, state.Snapshots) {
			<section class="tokens-section tokens-timeline-batch">
				<h2 class="md-typescale-title-medium">Observed <time datetime={ batch.DetectedAt }>{ observationDate(batch.DetectedAt) }</time></h2>
				if batch.PreviousAt != "" {
					<p class="tokens-metadata">Compared with { observationDate(batch.PreviousAt) }</p>
				}
		for _, group := range changeGroups(batch.Changes, state.Subjects) {
			if subject == "" {
				<article class="tokens-change-summary">
					<h3 class="md-typescale-title-medium">
						if group.URL != "" {
							<a class="tokens-link" href={ group.URL }>{ group.Label }</a>
						} else {
							{ group.Label }
						}
					</h3>
					<p>
						if changedItemCount(group.Changes) == 1 {
							1 item changed
						} else {
							{ changedItemCount(group.Changes) } items changed
						}
					</p>
					<a class="tokens-link" href={ groupChangelogURL(baseURL, group, batch.Changes[0].SnapshotID) }>
						View changes
						@materialSymbol("chevron_right")
					</a>
				</article>
			} else {
				if group.URL != "" {
					<p><a class="tokens-link" href={ group.URL }>Browse tokens</a></p>
				}
				@changeRecordList(group.Changes)
			}
		}
			</section>
		}
		if hasPrevious || hasNext {
			<nav class="tokens-pagination" aria-label="Change log pages">
				if hasPrevious {
					<a class="tokens-link" href={ changesPageURL(baseURL, page - 1) }>Previous</a>
				}
				<span class="md-typescale-body-small">Page { page }</span>
				if hasNext {
					<a class="tokens-link" href={ changesPageURL(baseURL, page + 1) }>Next</a>
				}
			</nav>
		}
}
}

templ changeFilterForm(filters changeFilters, baseURL string) {
	<form class="tokens-change-filters" method="get" action={ strings.SplitN(baseURL, "?", 2)[0] }>
		if !filters.FixedSubject {
			<label>Component or style<select name="subject"><option value="">All components and styles</option>
				for _, option := range filters.Subjects {
					<option value={ option.Value } selected?={ option.Value == filters.Subject }>{ option.Label }</option>
				}
			</select></label>
		}
		<label>Observed<select name="snapshot"><option value="">All dates</option>
			for _, option := range filters.Snapshots {
				<option value={ option.Value } selected?={ option.Value == filters.Snapshot }>{ option.Label }</option>
			}
		</select></label>
		<label>Change<select name="type">
			<option value="">All changes</option>
			<option value="changed" selected?={ filters.Type == "changed" }>Updated</option>
			<option value="added" selected?={ filters.Type == "added" }>Added</option>
			<option value="removed" selected?={ filters.Type == "removed" }>Removed</option>
		</select></label>
		<label>Token name<input type="search" name="q" value={ filters.Query } placeholder="e.g. width or font"/></label>
		<div class="tokens-change-filter-actions">
			<button type="submit">Apply filters</button>
			<a class="tokens-link" href={ strings.SplitN(baseURL, "?", 2)[0] }>Reset</a>
		</div>
	</form>
}

templ changeRecordList(changes []labeledChange) {
		for _, change := range changes {
			<details class="tokens-change-card tokens-change-disclosure">
				<summary class="tokens-change-heading">
					@materialSymbol("chevron_right")
					<h4>{ change.Name }</h4>
					<span class="tokens-change-status" data-change-type={ change.Type }>{ changeTypeLabel(change.Type) }</span>
					if context := changeContext(change.ChangeView); context != "" {
						<span class="tokens-change-context tokens-change-context-summary">{ context }</span>
					}
				</summary>
				if len(change.Hierarchy) > 0 {
					<ol class="tokens-change-hierarchy" aria-label="Token hierarchy">
						for index, part := range change.Hierarchy {
							<li>
								if index > 0 {
									@materialSymbol("chevron_right")
								}
								{ part }
							</li>
							}
					</ol>
				}
				<table class="tokens-change-table">
					<thead><tr><th scope="col">Property</th><th scope="col">Previous value</th><th scope="col">New value</th></tr></thead>
					<tbody>
						for _, value := range changedValues(change.ChangeView) {
							<tr><th scope="row">{ value.Field }</th><td>{ value.Before }</td><td>{ value.After }</td></tr>
						}
					</tbody>
				</table>
			</details>
		}
}
