{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleDetection": "legacy"
  },
  "include": [
    "forge/**/*.ts",
    "forge/**/*.cts",
    "catalog/**/*.ts",
    "cmd/**/*.ts"
  ]
}
