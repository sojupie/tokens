{
  "name": "token-catalog-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:components": "node forge/components/build-assets.ts && node catalog/web/build-assets.ts",
    "check:components": "npm run check:types && node forge/components/build-assets.ts --check && node catalog/web/build-assets.ts --check",
    "build:tokens": "node forge/build-tokens.mjs",
    "test:tokens": "node --test forge/*.test.mjs forge/*.test.ts forge/material/*.test.mjs",
    "test:ui": "node --test catalog/web/ui_test.cjs catalog/web/dialog_demo_test.cjs forge/components/*_test.cjs",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "postcss": "8.5.31",
    "style-dictionary": "5.6.1",
    "typescript": "7.0.2"
  }
}
