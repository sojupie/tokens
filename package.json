{
  "name": "token-catalog-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:components": "node forge/components/build-assets.mjs",
    "check:components": "node forge/components/build-assets.mjs --check",
    "build:tokens": "node forge/build-tokens.mjs",
    "test:tokens": "node --test forge/*.test.mjs forge/material/*.test.mjs",
    "test:ui": "node --test catalog/web/ui_test.cjs forge/components/*_test.cjs forge/motion/*_test.cjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "esbuild": "0.25.12",
    "postcss": "8.5.31",
    "style-dictionary": "5.6.1"
  }
}
