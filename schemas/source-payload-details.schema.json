{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sojupie/tokens/schemas/source-payload-details.schema.json",
  "title": "Token Catalog source-payload details",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 3},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pageUrls", "sourcePayloadUrl"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pageUrls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "sourcePayloadUrl": {"type": "string", "format": "uri"},
          "sourcePayloadKind": {"type": "string"},
          "sourceArea": {"type": "string"},
          "sourceSubject": {"type": "string"},
          "sourcePageType": {"type": "string"},
          "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact": {"type": "string"},
          "retrievedAt": {"type": "string", "format": "date-time"},
          "etag": {"type": "string"},
          "lastModified": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    }
  }
}
