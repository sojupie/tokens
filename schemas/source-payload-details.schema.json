{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sojupie/m3-source/schemas/source-payload-details.schema.json",
  "title": "Source Loom source-payload details",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pageUrl", "payloadUrl"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pageUrl": {"type": "string", "format": "uri"},
          "payloadUrl": {"type": "string", "format": "uri"},
          "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact": {"type": "string"},
          "retrievedAt": {"type": "string", "format": "date-time"},
          "etag": {"type": "string"},
          "lastModified": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    }
  }
}
