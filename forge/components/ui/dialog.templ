package ui

templ Dialog(id, titleID, title, class string, actions templ.Component) {
	@Modal(DialogProps{ID: id, TitleID: titleID, Title: title, Actions: actions, Attrs: templ.Attributes{"class": class}, ContentAttrs: templ.Attributes{"tabindex": "0"}}) {
		{ children... }
	}
}

// Modal owns presentation. The host supplies content, actions and save policy.
templ Modal(p DialogProps) {
	@Require("dialog")
	<dialog { p.Attributes()... }>
		if p.FullScreen {
			<header class="md-full-header">
				@Button(attributes(templ.Attributes{"class": "md-icon-button md-standard-icon-button", "type": "button", "aria-label": "Close", "data-dialog-close": p.ID}, p.CloseAttrs)) {
					@Icon("close")
				}
				if !p.HideTitle {
					<h2 id={ p.titleID() }>{ p.Title }</h2>
				}
				if !p.BottomActions {
					if p.HeaderActions!=nil {
						@p.HeaderActions
					} else if p.Actions!=nil {
						@p.Actions
					}
				}
				if p.Dividers {
					<hr class="md-divider"/>
				}
			</header>
		} else {
			<header class="md-basic-header">
				if p.Icon!=nil {
					<span data-slot="icon" aria-hidden="true">
						@p.Icon
					</span>
				}
				if !p.HideTitle {
					<h2 id={ p.titleID() }>{ p.Title }</h2>
				}
				if p.Dividers {
					<hr class="md-divider"/>
				}
			</header>
		}
		<div { attributes(templ.Attributes{"class":"md-dialog-content","data-dialog-content":""},p.ContentAttrs)... }>
			if p.Description!="" {
				<p data-slot="supporting-text" id={ p.ID + "-support" }>{ p.Description }</p>
			}
			{ children... }
		</div>
		if p.Actions!=nil&&(!p.FullScreen||p.BottomActions) {
			<footer class={ templ.KV("md-basic-actions",!p.FullScreen),templ.KV("md-full-action-bar",p.FullScreen) }>
				if p.Dividers {
					<hr class="md-divider"/>
				}
				@p.Actions
			</footer>
		}
	</dialog>
}

templ DialogTrigger(target, label string, p ButtonProps) {
	{{
		attrs := p.Attributes()
		attrs["data-dialog-open"] = target
		attrs["aria-controls"] = target
		attrs["aria-haspopup"] = "dialog"
		attrs["aria-expanded"] = "false"
	}}
	@Button(attrs) {
		{ label }
	}
}

templ DialogClose(target, label, value string, p ButtonProps) {
	{{
		attrs := p.Attributes()
		attrs["data-dialog-close"] = target
		attrs["data-dialog-result"] = value
	}}
	@Button(attrs) {
		{ label }
	}
}
