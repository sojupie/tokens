package ui

templ SplitButton(p SplitButtonProps) {
	@Require("split")
	<div { p.Attributes()... }>
		<button { p.action(false)... }>
			if p.Content!="label"&&p.Icon!="" {
				@Icon(p.Icon)
			}
			if p.Content!="icon" {
				<span>{ p.Label }</span>
			}
		</button>
		<button { p.action(true)... }>
			@Icon("expand_more")
		</button>
	</div>
}

templ SplitHost() {
	@Require("split")
	<div class="md-split-demo">
		{ children... }
	</div>
}

templ SplitMenu(id, label string) {
	@Require("split")
	<nav class="md-menu md-split-menu" data-variant="standard" id={ id + "-menu" } popover="auto" role="menu" aria-label={ label }>
		<ul>
			{ children... }
		</ul>
	</nav>
}
