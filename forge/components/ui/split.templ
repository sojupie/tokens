package ui

templ SplitButton(p SplitButtonProps) {
	@Require("split")
	<div { p.Attributes()... }>
		<button { p.action(false)... }>
			if p.Content!="label"&&p.Icon!="" {
				@Icon(p.Icon)
			}
			if p.Content!="icon" {
				<span>{ p.Label }</span>
			}
		</button>
		<button { p.action(true)... }>
			@Icon("expand_more")
		</button>
	</div>
}

templ SplitHost(attrs ...templ.Attributes) {
	@Require("split")
	<div { attributes(templ.Attributes{"class":"md-split-demo"},firstAttrs(attrs))... }>
		{ children... }
	</div>
}

templ SplitMenu(id, label string, attrs ...templ.Attributes) {
	@Require("split")
	<nav { attributes(templ.Attributes{"class":"md-menu md-split-menu","data-variant":"standard","id":id+"-menu","popover":"auto","role":"menu","aria-label":label},firstAttrs(attrs))... }>
		<ul>
			{ children... }
		</ul>
	</nav>
}
