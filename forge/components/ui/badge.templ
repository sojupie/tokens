package ui

templ Badge(variant string, content string, attrs templ.Attributes) {
	@Require("badge")
	<span { badgeAttributes(variant,content,attrs)... }>
		if variant == "labeled" {
			{ BadgeContent(content) }
		}
	</span>
}

templ BadgeAnchor() {
	@Require("badge")
	<span class="md-badge-anchor">{ children... }
</span>
}
