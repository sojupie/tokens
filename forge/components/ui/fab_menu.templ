package ui

templ FABMenu(p FABMenuProps) {
	@Require("fab-menu", "fab")
	<div { p.Attributes()... }>
		if !p.Inline {
			<button { p.opener()... }>
				@Icon("add")
			</button>
		}
		<div { p.panel()... }>
			<ul role="menu" aria-label={ p.Label }>
				{ children... }
			</ul>
 if p.Close!=nil {
 @p.Close
 }
		</div>
	</div>
}

templ FABMenuItem(p FABMenuItemProps) {
	@Require("fab-menu")
	<li role="none">
		<button { attributes(templ.Attributes{"class":"md-button md-fab-menu-item","type":"button","role":"menuitem","data-fab-menu-action":"","data-size":"small","tabindex":"-1"},p.Attrs)... }>
			<span class="md-fab-menu-item-content">
				@Icon(p.Icon)
				<span>{ p.Label }</span>
			</span>
		</button>
	</li>
}
