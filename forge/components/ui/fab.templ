package ui

templ FAB(p FABProps) {
	@Require("fab")
	<button { p.Attributes()... }>
		@Icon(p.Icon)
		if p.Extended {
			<span>{ p.Label }</span>
		}
	</button>
}

templ FABLink(href string, p FABProps) {
	@Require("fab")
	{{
		attrs := p.Attributes()
		delete(attrs, "type")
		delete(attrs, "disabled")
	}}
	<a href={ templ.SafeURL(href) } { attrs... }>
		@Icon(p.Icon)
		if p.Extended {
			<span>{ p.Label }</span>
		}
	</a>
}
