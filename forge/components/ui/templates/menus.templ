package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

//forge:internal
func MenuItemAttributes(attrs templ.Attributes) templ.Attributes {
	defaults := templ.Attributes{"type": "button", "class": "md-menu-item", "role": "menuitem", "tabindex": "-1"}
	return model.Attributes(defaults, attrs)
}

// MenuItem is the compact form of MenuEntry.
templ MenuItem(attrs templ.Attributes, label string, leading templ.Component, trailing templ.Component) {
	@MenuEntry(model.MenuEntryProps{Attrs: attrs, Label: label, Leading: leading, Trailing: trailing})
}

// MenuEntry owns item slots; the application supplies command and selection semantics.
templ MenuEntry(p model.MenuEntryProps) {
	@model.Require("common")
	<button { MenuItemAttributes(p.Attrs)... }>
		if p.Leading!=nil {
			<span data-slot="leading-icon" aria-hidden="true">
				@p.Leading
			</span>
		}
		if !p.IconOnly {
			<span class="md-menu-item-text">
				<span>{ p.Label }</span>
				if p.Supporting!="" {
					<span data-slot="supporting-text">{ p.Supporting }</span>
				}
			</span>
			if p.Trailing!=nil {
				<span data-slot="trailing-icon" aria-hidden="true">
					@p.Trailing
				</span>
			}
			if p.Shortcut!=nil {
				<small class="md-menu-shortcut" data-slot="trailing-supporting-text" aria-label={ p.ShortcutLabel }>
					@p.Shortcut
				</small>
			}
		}
	</button>
}

// MenuSurface accepts application attributes for static, popover and nested menus.
templ MenuSurface(attrs templ.Attributes, heading string) {
	@model.Require("common")
	<div { model.Attributes(templ.Attributes{"class":"md-menu","data-menu-panel":"","data-variant":"standard","data-orientation":"vertical","role":"menu"},attrs)... }>
		<section>
			if heading!="" {
				<h3>{ heading }</h3>
			}
			<ul role="presentation">
				{ children... }
			</ul>
		</section>
	</div>
}

templ Menu(id string, label string, main bool) {
	@MenuSurface(templ.Attributes{"id": id, "popover": "auto", "data-menu-main": main, "aria-label": label}, "") {
		{ children... }
	}
}

// MenuLink keeps command-like navigation as a native link.
templ MenuLink(href string, attrs templ.Attributes, trailing ...templ.Component) {
	@model.Require("common")
	<a href={ templ.SafeURL(href) } { model.Attributes(templ.Attributes{"class":"md-menu-item","role":"menuitem","data-menu-action":""},attrs)... }>
		<span class="md-menu-item-text">
			{ children... }
		</span>
		if len(trailing)>0 {
			<span data-slot="trailing-icon" aria-hidden="true">
				@trailing[0]
			</span>
		}
	</a>
}

templ MenuHost(attrs templ.Attributes) {
	@model.Require("common")
	<div { model.Attributes(templ.Attributes{"data-menu-example":""},attrs)... }>
		{ children... }
	</div>
}

templ MenuPanel(attrs templ.Attributes) {
	@model.Require("common")
	<nav { model.Attributes(templ.Attributes{"class":"md-menu","role":"menu","popover":"auto"},attrs)... }>
		{ children... }
	</nav>
}

// MenuSelectionIcon owns the two icon states coordinated by the menu controller.
templ MenuSelectionIcon(selected bool, icon string) {
 <span data-menu-checked-icon hidden?={ !selected }>@model.Icon("check")</span>
 if icon != "" {
  <span data-menu-unchecked-icon hidden?={ selected }>@model.Icon(icon)</span>
 }
}
