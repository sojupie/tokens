package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

import "fmt"

templ ProgressIndicator(attrs templ.Attributes) {
	@model.Require("progress")
	<div { model.Attributes(templ.Attributes{"class":"md-progress","role":"progressbar"},attrs)... }>
		<noscript><progress max="100" aria-label={ fmt.Sprint(attrs["aria-label"]) } if attrs["aria-valuenow"]!=nil { value={ fmt.Sprint(attrs["aria-valuenow"]) } }></progress></noscript>
		<svg width="48" height="4" aria-hidden="true"><path class="md-progress-track"></path><path class="md-progress-active"></path><path class="md-progress-active md-progress-second"></path><rect class="md-progress-stop"></rect></svg>
	</div>
}

// Progress renders a determinate or indeterminate linear/circular indicator.
templ Progress(p model.ProgressProps) {
	{{ attrs := p.Attributes(false) }}
	if p.CSSOnly && attrs["data-variant"] == "linear" && attrs["data-control"] == "indeterminate" && attrs["data-shape"] == "flat" && attrs["data-size"] == "thin" {
		@model.Require("common")
		{{ attrs["class"] = model.Attributes(templ.Attributes{"class": "md-progress-css"}, p.Attrs)["class"] }}
		<div { attrs... }></div>
	} else {
		@ProgressIndicator(attrs)
	}
}
