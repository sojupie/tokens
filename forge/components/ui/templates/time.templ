package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

import "fmt"

templ TimePicker(p model.TimePickerProps) {
	@model.Require("time")
	<div { model.Attributes(templ.Attributes{"class":"md-time-picker","data-time-picker":""},p.Attrs)... }>
		if !p.Inline {
			@Button(templ.Attributes{"class": "md-button md-outlined-button", "data-time-open": "", "aria-controls": p.ID + "-time", "aria-haspopup": "dialog", "aria-expanded": "false"}) {
				{ model.Fallback(p.Label,"Choose time") }
			}
		}

		@TimePickerPanel(p)
		<input class="md-native-time md-native-control" aria-label={ model.Fallback(p.Label,"Time") } type="time" name={ p.Name } value={ fmt.Sprintf("%02d:%02d", p.HourResolved(), p.MinuteResolved()) } data-time-value-input/>
		<output class="md-typescale-body-small" data-time-output aria-live="polite"></output>
	</div>
}

templ TimePickerPanel(p model.TimePickerProps) {
	@model.Require("time")
	<dialog { p.PanelResolved()... }>
		<h3 class="md-time-title" data-time-title>Select time</h3>
		<div class="md-time-body">
			<div class="md-time-selectors">
				<div class="md-time-hour">
					<button { p.ValueResolved("hour")... }>{ fmt.Sprintf("%02d",p.DisplayHourResolved()) }</button>
					<label class="md-time-field-wrap"><input { p.InputResolved("hour")... }/><span class="md-time-supporting">Hour</span></label>
				</div>
				<span class="md-time-separator" aria-hidden="true">:</span>
				<div class="md-time-minute">
					<button { p.ValueResolved("minute")... }>{ fmt.Sprintf("%02d",p.MinuteResolved()) }</button>
					<label class="md-time-field-wrap"><input { p.InputResolved("minute")... }/><span class="md-time-supporting">Minute</span></label>
				</div>
				<div class="md-time-period-group" role="group" aria-label="Period" hidden?={ p.Format24 }>
					<button { p.PeriodResolved("am")... }>AM</button><button { p.PeriodResolved("pm")... }>PM</button>
				</div>
			</div>
			<div { p.DialResolved()... }>
				<span class="md-time-hand" aria-hidden="true"><span class="md-time-handle"><span class="md-time-dot"></span></span></span>
				<span class="md-time-center" aria-hidden="true"></span>
				<div class="md-time-labels" aria-hidden="true">
					for _,tick:=range p.Ticks() {
						<span class="md-time-tick" style={ tick.Style() }>{ tick.Label }</span>
					}
				</div>
				<div class="md-time-selected-labels" aria-hidden="true">
					for _,tick:=range p.Ticks() {
						<span class="md-time-tick" style={ tick.Style() }>{ tick.Label }</span>
					}
				</div>
			</div>
		</div>
		<p class="md-time-error md-typescale-body-small" id={ p.ID + "-error" } data-time-error role="alert"></p>
		<footer class="md-time-actions">
			<button class="md-icon-button md-standard-icon-button" data-size="small" data-shape="round" type="button" data-time-mode aria-label={ p.ModeLabelResolved() }>
				@model.Icon("keyboard")
				@model.Icon("schedule")
			</button><span></span><button class="md-button md-text-button" type="button" data-time-cancel>Cancel</button><button class="md-button md-text-button" type="button" data-time-save>OK</button>
		</footer>
	</dialog>
}
