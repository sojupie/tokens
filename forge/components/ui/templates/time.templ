package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

import "fmt"

templ TimePicker(p model.TimePickerProps) {
	<div { model.Attributes(templ.Attributes{"class":"md-time-picker","data-time-picker":""},p.Attrs)... }>
		if !p.IsInline() && !p.Preview {
			@DialogTrigger(p.ID + "-time", model.Fallback(p.Label,"Choose time"), model.ButtonProps{Variant: "outlined", Attrs: templ.Attributes{"data-time-open": ""}})
		}

		@timePickerSurface(p, false)
		@timePickerValue(p)
		<output class="md-typescale-body-small" data-time-output aria-live="polite"></output>
	</div>
}

templ TimePickerPanel(p model.TimePickerProps) {
	@timePickerSurface(p, true)
}

templ timePickerValue(p model.TimePickerProps) {
	<input class="md-native-time md-native-control" aria-label={ model.Fallback(p.Label,"Time") } type="time" name={ p.Name } value={ fmt.Sprintf("%02d:%02d", p.HourResolved(), p.MinuteResolved()) } data-time-value-input/>
}

templ timePickerSurface(p model.TimePickerProps, standalone bool) {
	@model.Require("time")
	if p.IsInline() {
		<div { p.PanelResolved()... }>
			@timePickerContent(p, standalone)
		</div>
	} else {
		@DialogSurface(p.PanelResolved()) {
			@timePickerContent(p, standalone)
		}
	}
}

templ timePickerContent(p model.TimePickerProps, standalone bool) {
		<h3 class="md-time-title" data-time-title>Select time</h3>
		<div class="md-time-body">
			<div class="md-time-selectors">
				<div class="md-time-hour">
					<button { p.ValueResolved("hour")... }>{ fmt.Sprintf("%02d",p.DisplayHourResolved()) }</button>
					@TimePickerField(p, "hour", "Hour")
					if p.Expressive {
						@ScrollField(p.ScrollField("hour"))
					}
				</div>
				<span class="md-time-separator" aria-hidden="true">:</span>
				<div class="md-time-minute">
					<button { p.ValueResolved("minute")... }>{ fmt.Sprintf("%02d",p.MinuteResolved()) }</button>
					@TimePickerField(p, "minute", "Minute")
					if p.Expressive {
						@ScrollField(p.ScrollField("minute"))
					}
				</div>
				if p.IsInline() && !p.Preview {
					<div class="md-time-side-controls">
						@TimePickerPeriod(p)
						@TimePickerMode(p)
					</div>
				} else {
					@TimePickerPeriod(p)
				}
			</div>
			<div { p.DialResolved()... }>
				<span class="md-time-hand" aria-hidden="true"><span class="md-time-handle"><span class="md-time-dot"></span></span></span>
				<span class="md-time-center" aria-hidden="true"></span>
				<div class="md-time-choices"></div>
				<div class="md-time-labels" aria-hidden="true">
					for _,tick:=range p.Ticks() {
						<span class="md-time-tick" style={ tick.Style() }>{ tick.Label }</span>
					}
				</div>
				<div class="md-time-selected-labels" aria-hidden="true">
					for _,tick:=range p.Ticks() {
						<span class="md-time-tick" style={ tick.Style() }>{ tick.Label }</span>
					}
				</div>
			</div>
		</div>
		<p class="md-time-error md-typescale-body-small" id={ p.ID + "-error" } data-time-error role="alert"></p>
		if !p.IsInline() || p.Preview {
			<footer class="md-time-actions">
				@TimePickerMode(p)
				<span></span>
				@Action(model.ButtonProps{Variant: "text", Attrs: templ.Attributes{"data-time-cancel": ""}}) { Cancel }
				@Action(model.ButtonProps{Variant: "text", Attrs: templ.Attributes{"data-time-save": ""}}) { OK }
			</footer>
		}
		if standalone {
			@timePickerValue(p)
		}
}

templ TimePickerField(p model.TimePickerProps, part, caption string) {
	<label class="md-time-field-wrap">
		<input { p.InputResolved(part)... }/>
		if !p.Expressive {
			<span class="md-time-supporting">{ caption }</span>
		}
	</label>
}

templ TimePickerPeriod(p model.TimePickerProps) {
	<div class="md-time-period-group" role="radiogroup" aria-label="Period" hidden?={ p.Format24 }>
		<button { p.PeriodResolved("am")... }>AM</button>
		<button { p.PeriodResolved("pm")... }>PM</button>
	</div>
}

templ TimePickerMode(p model.TimePickerProps) {
	@IconButtonContent(model.IconButtonProps{Label: p.ModeLabelResolved(), Attrs: templ.Attributes{"data-time-mode": ""}}) {
		@model.Icon("keyboard")
		@model.Icon("schedule")
		if p.Expressive {
			@model.Icon("swipe")
		}
	}
}
