package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

templ Carousel(p model.CarouselProps, count int) {
	@model.Require("carousel")
	<section { p.Attributes()... }>
		if p.Header!=nil {
			@p.Header
		}
		<div class="md-carousel-viewport" aria-label="Carousel items">
			<div class="md-carousel-scroll-track">
				<div class="md-carousel-snaps" aria-hidden="true">
					for range count {
						<span class="md-carousel-snap"></span>
					}
				</div>
				<ol class="md-carousel-track">
					{ children... }
				</ol>
			</div>
		</div>
		if p.Actions!=nil {
			@p.Actions
		}
		if p.Controls!=nil {
			@p.Controls
		}
	</section>
}

templ CarouselItem(p model.CarouselItemProps) {
	@model.Require("carousel")
	<li { p.SlotResolved()... }>
		if p.Before!=nil {
			<div class="md-carousel-before">
				@p.Before
			</div>
		}
		<button { p.Attributes()... }>
			if p.ImageSrc!="" {
				<span class="md-carousel-art" aria-hidden="true"><img src={ templ.SafeURL(p.ImageSrc) } alt={ p.ImageAlt } width="1200" height="800" draggable="false"
 if p.ImagePosition!="" || p.ImageScale>0 {
 style={ p.ImageStyleResolved() }
 }/></span>
			}
			if p.Content!=nil {
				@p.Content
			}
			{ children... }
		</button>
		if p.After!=nil {
			<div class="md-carousel-after">
				@p.After
			</div>
		}
	</li>
}

templ CarouselHeader() {
	@model.Require("carousel")
	<header class="md-carousel-header">
		{ children... }
	</header>
}

templ CarouselAction() {
	@model.Require("carousel")
	<div class="md-carousel-all-action">
		{ children... }
	</div>
}

templ CarouselControls() {
	@model.Require("carousel")
	<div class="md-carousel-controls">
		@IconButton(model.IconButtonProps{Label: "Previous item", Icon: "chevron_left", Attrs: templ.Attributes{"data-carousel-step": "-1"}})
		@CarouselPagination()
		@IconButton(model.IconButtonProps{Label: "Next item", Icon: "chevron_right", Attrs: templ.Attributes{"data-carousel-step": "1"}})
	</div>
}

// CarouselText is optional overlay content supplied by the consumer.
templ CarouselText() {
	<span class="md-carousel-caption md-typescale-title-medium">
		{ children... }
	</span>
}

// Pagination is populated from the actual distinct scroll stops.
templ CarouselPagination() {
	<span class="md-carousel-pagination" role="img" aria-label="Carousel position"></span>
}
