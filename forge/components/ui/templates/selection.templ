package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

// Checkbox is a labeled form field. CheckboxControl is the same control for list or custom label slots.
templ Checkbox(id string, label string) {
	@CheckboxField(model.ChoiceProps{ID: id, Label: label})
}

templ CheckboxField(p model.ChoiceProps) {
	<span class="md-checkbox-choice">
		@CheckboxControl(p)
		<label for={ p.ID }>{ p.Label }</label>
	</span>
}

templ CheckboxControl(p model.ChoiceProps) {
	@model.Require("checkbox")
	<label { model.Attributes(templ.Attributes{"class":"md-checkbox"},p.Attrs)... }>
		<input { p.InputResolved("checkbox")... }/>
		<span class="md-checkbox-box" aria-hidden="true"><svg class="md-checkbox-check" viewBox="0 0 18 18" fill="none"><path d="m4 9 3 3 7-7" stroke="currentColor" stroke-width="2"></path></svg><svg class="md-checkbox-dash" viewBox="0 0 18 18" fill="none"><path d="M4 9h10" stroke="currentColor" stroke-width="2"></path></svg></span>
	</label>
}

templ Switch(p model.ChoiceProps) {
	<span class="md-switch-choice">
		@SwitchControl(p)
		<label for={ p.ID }>{ p.Label }</label>
	</span>
}

templ SwitchControl(p model.ChoiceProps) {
	@model.Require("switch")
	{{
		input := p.InputResolved("checkbox")
		input["role"] = "switch"
	}}
	<label { model.Attributes(templ.Attributes{"class":"md-switch"},p.Attrs)... }><input { input... }/><span class="md-switch-track" aria-hidden="true"></span><span class="md-switch-handle" aria-hidden="true"><svg class="md-switch-on" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2"></path></svg><svg class="md-switch-off" viewBox="0 0 24 24" fill="none"><path d="m7 7 10 10M7 17 17 7" stroke="currentColor" stroke-width="2"></path></svg></span></label>
}

templ RadioControl(p model.ChoiceProps) {
	@model.Require("radio")
	<span { model.Attributes(templ.Attributes{"class":"md-radio"},p.Attrs)... }><input { p.InputResolved("radio")... }/><span class="md-radio-icon" aria-hidden="true"></span></span>
}

templ Radio(p model.ChoiceProps) {
	{{ p.VisibleLabel = true }}
	<label class="md-radio-choice">
		@RadioControl(p)
		<span class="md-radio-label">{ p.Label }</span>
	</label>
}

// RadioGroup owns native grouping; callers supply the choices and form values.
templ RadioGroup(label string, attrs templ.Attributes) {
 @model.Require("radio")
 <fieldset { model.Attributes(templ.Attributes{"class":"md-radio-group","role":"radiogroup"},attrs)... }>
  <legend>{ label }</legend>
  { children... }
 </fieldset>
}
