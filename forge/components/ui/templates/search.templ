package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

import "fmt"

templ Search(p model.SearchProps) {
	{{ p.Disclosure = true }}
	@model.Require("search")
	<div { model.Attributes(templ.Attributes{"class":"md-search-demo","data-interactive":"true","data-disclosure":fmt.Sprint(p.Expanded)},p.Attrs)... }>
		<div class="md-search-scene">
			<section class="md-search-page" data-search-background>
				if p.Page!=nil {
					@p.Page
				}
			</section>@SearchScrim()
			@SearchView(p) {
				{ children... }
			}
		</div>
	</div>
}

templ SearchScrim() {
	@model.Require("search")
	<button class="md-search-scrim" type="button" aria-label="Dismiss search" tabindex="-1" hidden></button>
}

templ SearchResult(label string) {
	@model.Require("search", "list")
	<li data-search-result={ label }>
		<button class="md-list-item" type="button">
			@ListContent(model.ListItemProps{Label: label, LeadingKind: model.LeadingIcon, Leading: model.Icon("search"), SingleLine: true})
		</button>
	</li>
}

templ SearchBarSurface(p model.SearchProps) {
	@model.Require("search")
	<div class="md-search-view" data-variant="docked" data-layout="inline" data-control={ model.Fallback(p.Control, "contained") } data-open="false" role="search" aria-label={ p.Label }>
		@SearchBar(p, p.Label, p.Value, false)
	</div>
}

templ SearchActions(p model.SearchProps) {
	<div class="md-search-actions">
		if p.SearchHasAction("clear") {
			<span class="md-search-action-target" hidden?={ p.Value=="" } data-search-clear-target>
				<button class="md-icon-button md-standard-icon-button md-search-action" data-size="small" data-shape="round" type="button" aria-label="Clear search" data-search-clear>
					@model.Icon("close")
				</button>
			</span>
		}
		if p.SearchHasAction("settings") {
			<span class="md-search-action-target">
				<button class="md-icon-button md-standard-icon-button md-search-action" data-size="small" data-shape="round" type="button" aria-label="Search options" popovertarget={ p.SearchOptionsID() }>
					@model.Icon("settings_outline")
				</button>
			</span>
			<div class="md-search-options" id={ p.SearchOptionsID() } popover="auto" role="dialog" aria-label="Search options">
				if p.Options!=nil {
					@p.Options
				}
			</div>
		}
		if p.SearchHasAction("avatar") {
			<button class="md-icon-button md-standard-icon-button md-search-avatar" data-size="small" data-shape="round" type="button" aria-label="Profile">
				<span aria-hidden="true">
					if p.AvatarText!="" {
						{ p.AvatarText }
					} else {
						@model.Icon("person")
					}
				</span>
			</button>
		}
	</div>
}

templ SearchView(p model.SearchProps) {
	if p.Action!="" {
		<noscript><form method="get" action={ templ.SafeURL(p.Action) }><label>{ p.Label }<input type="search" name={ model.Fallback(p.Name,"q") } value={ p.Value }/></label><button class="md-button md-outlined-button" type="submit">Search</button></form></noscript>
	}
	@model.Require("search")
	@model.Require("list")
	<div { p.SearchPanel()... }>
		@SearchBar(p, p.Label, p.Value, p.Disclosure)
		<div class={ "md-search-results",templ.KV("md-elevation",p.Elevation=="token") } id={ p.ID + "-results" } hidden?={ !p.Expanded }>
			<h3 class="md-search-results-heading" data-search-heading tabindex="-1">Suggestions</h3>
			@List(model.ListProps{Label: "Search suggestions and results", Lines: model.OneLine, Appearance: model.Baseline}) {
				{ children... }
			}
			<p class="md-typescale-body-medium" data-search-empty hidden>No results</p>
		</div>
		<output class="md-search-status" aria-live="polite"></output>
	</div>
}

templ SearchBar(p model.SearchProps, label string, value string, disclosure bool) {
	@model.Require("search")
	<div { p.SearchBar()... }>
		<span class="md-search-leading-slot">
			if p.Leading=="icon" {
				<span class="md-search-leading" aria-hidden="true">
					@model.Icon("search")
				</span>
			}
			if p.Leading=="menu" {
                @model.Require("navigation")
				<button class="md-icon-button md-standard-icon-button md-search-navigation" data-size="small" data-shape="round" type="button" data-search-navigation data-navigation-open aria-label="Open navigation" aria-haspopup="dialog" aria-controls={ p.ID + "-navigation" }>
					@model.Icon("menu")
				</button>
			}
			<button class="md-icon-button md-standard-icon-button md-search-back" data-size="small" data-shape="round" type="button" aria-label="Close search" data-search-back hidden?={ !p.Expanded }>
				@model.Icon("arrow_back")
			</button>
		</span>
		<input
			type="search"
			class="md-search-input"
			aria-label={ label }
			if disclosure {
				aria-expanded={ fmt.Sprint(p.Expanded) }
				aria-controls={ p.ID + "-results" }
			}
			placeholder={ label }
			value={ value }
			autocomplete="off"
			readonly?={ disclosure && !p.Expanded }
		/>
		@SearchActions(p)
	</div>
}
