package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

templ Dialog(id, titleID, title, class string, actions templ.Component) {
	@Modal(model.DialogProps{ID: id, TitleID: titleID, Title: title, Actions: actions, Attrs: templ.Attributes{"class": class}, ContentAttrs: templ.Attributes{"tabindex": "0"}}) {
		{ children... }
	}
}

// Modal owns presentation. The host supplies content, actions and save policy.
templ Modal(p model.DialogProps) {
	@model.Require("dialog")
	<dialog { p.Attributes()... }>
		if p.FullScreen {
			<header class="md-full-header">
				@Button(model.Attributes(templ.Attributes{"class": "md-icon-button md-standard-icon-button", "type": "button", "aria-label": "Close", "data-dialog-close": p.ID}, p.CloseAttrs)) {
					@model.Icon("close")
				}
				if !p.HideTitle {
					<h2 id={ p.TitleIDResolved() }>{ p.Title }</h2>
				}
				if !p.BottomActions {
					if p.HeaderActions!=nil {
						@p.HeaderActions
					} else if p.Actions!=nil {
						@p.Actions
					}
				}
				if p.Dividers {
					<hr class="md-divider"/>
				}
			</header>
		} else {
			<header class="md-basic-header">
				if p.Icon!=nil {
					<span data-slot="icon" aria-hidden="true">
						@p.Icon
					</span>
				}
				if !p.HideTitle {
					<h2 id={ p.TitleIDResolved() }>{ p.Title }</h2>
				}
				if p.Dividers {
					<hr class="md-divider"/>
				}
			</header>
		}
		@DialogContent(p) {
			{ children... }
		}
		if p.Actions!=nil&&(!p.FullScreen||p.BottomActions) {
			<footer { model.Attributes(templ.Attributes{"class":templ.Classes(templ.KV("md-basic-actions",!p.FullScreen),templ.KV("md-full-action-bar",p.FullScreen)).String()},p.ActionsAttrs)... }>
				if p.Dividers {
					<hr class="md-divider"/>
				}
				@p.Actions
			</footer>
		}
	</dialog>
}

templ DialogTrigger(target, label string, p model.ButtonProps) {
	{{
		attrs := p.Attributes()
		attrs["commandfor"] = target
		attrs["command"] = "show-modal"
		attrs["data-dialog-open"] = target
		attrs["aria-controls"] = target
		attrs["aria-haspopup"] = "dialog"
		attrs["aria-expanded"] = "false"
	}}
	@Button(attrs) {
		{ label }
	}
}

templ DialogClose(target, label, value string, p model.ButtonProps) {
	{{
		attrs := p.Attributes()
		attrs["commandfor"] = target
		attrs["command"] = "close"
		attrs["data-dialog-close"] = target
		attrs["data-dialog-result"] = value
	}}
	@Button(attrs) {
		{ label }
	}
}

// DialogSurface is for content-slot compositions and static illustration fixtures.
templ DialogSurface(attrs templ.Attributes) {
	@model.Require("dialog")
	<dialog { attrs... }>
		{ children... }
	</dialog>
}

templ DialogContent(p model.DialogProps) {
	{{ attrs := model.Attributes(templ.Attributes{"class": "md-dialog-content", "data-dialog-content": ""}, p.ContentAttrs) }}
	if p.FormAttrs!=nil {
		<form { model.Attributes(attrs,p.FormAttrs)... }>
			@DialogContentBody(p) {
				{ children... }
			}
		</form>
	} else {
		<div { attrs... }>
			@DialogContentBody(p) {
				{ children... }
			}
		</div>
	}
}

templ DialogContentBody(p model.DialogProps) {
	if p.Description!="" {
		<p data-slot="supporting-text" id={ p.DescriptionIDResolved() }>{ p.Description }</p>
	}
	{ children... }
}
