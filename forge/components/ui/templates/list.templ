package render

import model "github.com/sojupie/tokens/forge/components/ui/internal/model"

import "strconv"

templ List(p model.ListProps) {
	@model.Require("list")
	if p.Ordered {
		<ol { p.Attributes()... }>
			{ children... }
		</ol>
	} else {
		<ul { p.Attributes()... }>
			{ children... }
		</ul>
	}
}

templ ListLink(href string, p model.ListItemProps) {
	@model.Require("list")
	<li>
		<a href={ templ.SafeURL(href) } { p.Attributes()... }>
			@ListContent(p)
		</a>
	</li>
}

templ ListButton(p model.ListItemProps) {
	@model.Require("list")
	<li>
		if p.Selected != nil {
			<noscript><label class="md-list-item"><input type="checkbox" checked?={ *p.Selected } disabled?={ p.Disabled } aria-label={ p.Label }/><span class="md-list-body"><span class="md-list-label">{ p.Label }</span><span class="md-list-supporting">{ p.Supporting }</span></span></label></noscript>
		}
		<button data-list-selectable?={ p.Selected!=nil } type="button" disabled?={ p.Disabled } if p.Selected != nil { aria-pressed={ strconv.FormatBool(*p.Selected) } } { p.Attributes()... }>
			@ListContent(p)
		</button>
	</li>
}

templ ListRow(p model.ListItemProps) {
	@model.Require("list")
	<li>
		<div { p.Attributes()... }>
			@ListContent(p)
		</div>
	</li>
}

// Compatibility for existing consumers; new callers use ListButton or ListLink.
templ ListItem(attrs templ.Attributes, label string) {
	@model.Require("list")
	<button type="button" { model.Attributes(templ.Attributes{"class":"md-list-item"},attrs)... }>
		@ListContent(model.ListItemProps{Label: label, SingleLine: true})
	</button>
}

// ListContent also serves playground rows with selection, reveal or reorder wrappers.
templ ListContent(p model.ListItemProps) {
	@model.Require("list")
	if p.LeadingKind!="" && p.LeadingKind!=model.NoLeading {
		<span class={ "md-list-leading md-list-" + string(p.LeadingKind) } aria-hidden={ strconv.FormatBool(p.LeadingKind != model.LeadingCheckbox && p.LeadingKind != model.LeadingRadio) }>
			if p.Leading!=nil {
				@p.Leading
			} else if p.LeadingKind==model.LeadingAvatar {
				<span class="md-list-avatar-label">{ p.Avatar }</span>
			} else if p.LeadingKind==model.LeadingImage {
				<img src={ templ.SafeURL(p.ImageSrc) } alt="" width="100" height="100" loading="lazy" draggable="false"/>
			}
			if p.Badge!=nil {
				@p.Badge
			}
		</span>
	}
	<span class="md-list-body">
		if p.Overline!="" {
			<span class="md-list-overline">{ p.Overline }</span>
		}
		if p.LabelFor!="" {
			<label class="md-list-label" for={ p.LabelFor }>{ p.Label }</label>
		} else {
			<span class="md-list-label">{ p.Label }</span>
		}
		if !p.SingleLine {
			<span class="md-list-supporting">{ p.Supporting }</span>
		}
	</span>
	if p.Trailing!=nil || p.Metadata!="" {
		<span class="md-list-tail">
			if p.Metadata!="" {
				<span class="md-list-meta">{ p.Metadata }</span>
			}
			if p.Trailing!=nil {
				@p.Trailing
			}
		</span>
	}
}

// ListRowFrame owns the interaction wrappers shared by advanced lists.
templ ListRowFrame(p model.ListRowFrameProps) {
	@model.Require("list")
	<li { p.Attrs... }>
		<div { model.Attributes(templ.Attributes{"class":"md-list-row"},p.FrameAttrs)... }>
			if p.Before!=nil {
				@p.Before
			}
			if p.Native {
				<div { p.ContentAttrs... }>
					@p.Content
				</div>
			} else {
				@Button(p.ContentAttrs) {
					@p.Content
				}
			}
			if p.After!=nil {
				@p.After
			}
		</div>
		if p.Expanded!=nil {
			<ul { model.Attributes(templ.Attributes{"class":"md-list-expand-content"},p.ChildrenAttrs)... }>
				@p.Expanded
			</ul>
		}
	</li>
}

templ ListReorderSheet(id string) {
	@model.Require("sheet", "list")
	<dialog class="md-sheet md-bottom-sheet md-list-reorder-sheet" data-control="standard" data-variant="expanded" data-list-reorder-sheet id={ id } aria-label="Reorder item" tabindex="-1">
		<div class="md-sheet-content">
			<div class="md-sheet-body">
				<div class="md-list" data-variant="standard" data-size="one-line" data-shape="baseline" data-width="icon">
					{ children... }
				</div>
			</div><output class="tokens-visually-hidden" data-list-move-status aria-live="polite"></output>
		</div>
	</dialog>
}

templ ListIcon(name string, disclosure bool) {
	@model.Require("list")
	<span class={ templ.KV("md-list-expand-icon",disclosure),templ.KV("md-list-trailing-icon",!disclosure) }>@model.Icon(name)
</span>
}

// ListHost owns announcement and interaction scope for advanced list compositions.
templ ListHost(attrs templ.Attributes) {
 @model.Require("list")
 <div { model.Attributes(templ.Attributes{"class":"md-list-host","data-list-host":""},attrs)... }>
  { children... }
  <output class="tokens-visually-hidden" data-list-status aria-live="polite"></output>
 </div>
}
