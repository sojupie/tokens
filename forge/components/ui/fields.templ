package ui

import "fmt"

type Option struct {
	Value, Label            string
	Disabled, DividerBefore bool
	Leading                 templ.Component
	Attrs                   templ.Attributes
}

templ NumberField(id, label, value, min, max string) {
	<div class="field-row">
		@TextField(TextFieldProps{ID: id, Label: label, Value: value, Type: "number", InputAttrs: templ.Attributes{"min": min, "max": max, "step": "1"}})
	</div>
}

// Select retains the native select used by existing tool integrations.
templ Select(id, label string, options []Option, selected ...string) {
	@SelectField(SelectProps{ID: id, Label: label, Options: options, Value: selectInitial(options, selected).Value, InputAttrs: templ.Attributes{"id": "filter-" + id}}) {
		<select id={ id } aria-label={ label } hidden>
			for _,option:=range options {
				<option value={ option.Value } selected?={ option.Value==selectInitial(options,selected).Value }>{ option.Label }</option>
			}
		</select>
	}
}

// OptionList is shared by select, autocomplete and chip-style fields.
templ OptionList(id, label, selected string, options []Option, attrs templ.Attributes) {
	@Require("common")
	<div { attributes(templ.Attributes{"class":"md-field-menu md-menu","data-variant":"standard","data-orientation":"vertical","id":id+"-options","role":"listbox","aria-label":label,"popover":"auto"},attrs)... }>
		<section>
			<ul role="presentation">
				for index,option:=range options {
					if option.DividerBefore {
						<li role="separator"><hr class="md-field-menu-divider" aria-hidden="true"/></li>
					}
					@selectOptionEntry(fmt.Sprintf("%s-option-%d", id, index), option, option.Value == selected)
				}
			</ul>
		</section>
		<p class="md-field-empty" role="option" aria-disabled="true" hidden>No matches</p>
	</div>
}

// SelectOption retains the public entry point for tool-owned option menus.
templ SelectOption(id, value, label string, selected bool) {
	@selectOptionEntry(id, Option{Value: value, Label: label}, selected)
}

templ selectOptionEntry(id string, option Option, selected bool) {
	@Require("common")
	<li role="presentation">
		<div { attributes(templ.Attributes{"class":"md-menu-item","id":id,"role":"option","aria-selected":fmt.Sprint(selected),"aria-disabled":fmt.Sprint(option.Disabled),"data-field-option":option.Label,"data-field-value":option.Value},option.Attrs)... }>
			if option.Leading!=nil {
				<span data-slot="leading-icon" aria-hidden="true">
					@option.Leading
				</span>
			}
			<span data-option-label>{ option.Label }</span>
			<span data-slot="trailing-icon" aria-hidden="true">
				@Icon("check")
			</span>
		</div>
	</li>
}

templ SelectField(p SelectProps) {
	@Require("common")
	<div { p.Attributes()... }>
		if p.Outlined {
			@FieldOutline(p.Label)
			<label for={ fmt.Sprint(p.InputAttributes()["id"]) } data-slot="label">{ p.Label }</label>
			<input { p.InputAttributes()... }/>
			<button type="button" class="md-field-toggle" data-field-toggle tabindex="-1" aria-label={ "Show " + p.Label + " options" } aria-controls={ p.ID + "-options" } disabled?={ p.Disabled }>
				<span data-slot="trailing-icon">
					@Icon("expand_more")
				</span>
			</button>
		} else {
			<button { p.InputAttributes()... }>
				if !p.HideLabel {
					<span>{ p.Label+":" }</span>
				}
				<span data-field-display>{ p.displayLabel() }</span>
				<span class="md-chip-icon" data-slot="trailing-icon" aria-hidden="true">
					@Icon("expand_more")
				</span>
			</button>
		}
		<input type="hidden" name={ p.Name } value={ p.Value } disabled?={ p.Disabled } data-field-value/>
		{ children... }
		@OptionList(p.ID, p.Label, p.Value, p.Options, p.MenuAttrs)
	</div>
}

func selectInitial(options []Option, selected []string) Option {
	if len(selected) > 0 {
		for _, option := range options {
			if option.Value == selected[0] {
				return option
			}
		}
	}
	if len(options) > 0 {
		return options[0]
	}
	return Option{}
}

templ FieldOutline(label string) {
	<fieldset class="md-field-outline" aria-hidden="true"><legend>{ label }</legend></fieldset>
	<fieldset class="md-field-outline md-field-focus-outline" aria-hidden="true"><legend>{ label }</legend></fieldset>
}

templ TextField(p TextFieldProps) {
	@Require("common")
	{{
		variant := "outlined"
		if p.Filled {
			variant = "filled"
		}
	}}
	<div { attributes(templ.Attributes{"class":"md-"+variant+"-text-field","data-invalid":p.Invalid},p.Attrs)... }>
		if !p.Filled {
			@FieldOutline(p.Label)
		}
		<label for={ fmt.Sprint(p.input()["id"]) } data-slot="label">{ p.Label }</label>
		if p.Leading!=nil {
			<span data-slot="leading-icon" aria-hidden="true">
				@p.Leading
			</span>
		}
		<input { p.input()... }/>
		if p.Trailing!=nil {
			<span data-slot="trailing-icon">
				@p.Trailing
			</span>
		}
		if p.Supporting!="" {
			<small data-slot="supporting-text" id={ p.ID + "-help" }>{ p.Supporting }</small>
		}
	</div>
}
