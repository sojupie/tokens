package ui

templ LoadingIndicator(attrs templ.Attributes) {
	@LoadingSurface(attributes(templ.Attributes{"class": "md-loading", "role": "progressbar", "data-control": "indeterminate", "data-variant": "uncontained"}, attrs), initialLoadingPath, "rotate(90 .5 .5)")
}

templ loadingGraphic() {
	@Require("loading")
	@loadingSVG(initialLoadingPath, "rotate(90 .5 .5)")
}

templ Loading(p ProgressProps) {
	{{
		control := "indeterminate"
		if p.Value != nil {
			control = "determinate"
		}
	}}
	@LoadingSurface(p.Attributes(true), loadingPaths[control], loadingRotation(control))
}

// LoadingSurface lets the playground supply its captured initial morph geometry.
templ LoadingSurface(attrs templ.Attributes, path, rotation string) {
	@Require("loading", "progress")
	<div { attrs... }>
		@loadingSVG(path, rotation)
	</div>
}

templ loadingSVG(path, rotation string) {
	<svg width="38" height="38" viewBox="0 0 1 1" aria-hidden="true"><g transform={ rotation }><path d={ path }></path></g></svg>
}
