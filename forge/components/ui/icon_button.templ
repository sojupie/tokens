package ui

templ IconButton(p IconButtonProps) {
	@IconButtonContent(p) {
		@Icon(p.Icon)
	}
}

// IconButtonContent allows a consumer to supply changing icon slots.
templ IconButtonContent(p IconButtonProps) {
	@Require("common")
	<button { p.Attributes()... }>
		{ children... }
	</button>
}

templ IconButtonLink(href string, p IconButtonProps) {
	@Require("common")
	{{
		attrs := p.Attributes()
		delete(attrs, "type")
		delete(attrs, "disabled")
	}}
	<a href={ templ.SafeURL(href) } { attrs... }>
		if p.Icon!="" {
			@Icon(p.Icon)
		}
		{ children... }
	</a>
}
