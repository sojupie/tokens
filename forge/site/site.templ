package site

import "github.com/sojupie/tokens/forge/components/ui"

templ Header(config Config) {
	<header class="tokens-site-header" id="tokens-site-header" hx-preserve data-component-assets data-drawer-breakpoint={ config.drawerBreakpoint() }>
		<div class="tokens-primary-nav">
			@ui.DrawerToggle("tokens-site-menu", "Open navigation")
			<a class="tokens-brand md-typescale-title-large" href={ templ.SafeURL(config.Catalog + "/") }>
				@templ.Raw(brandLogo)
				Token Catalog
			</a>
		</div>
		<div id="tokens-site-rail">
			@Rail(config)
		</div>
		@ui.Drawer("tokens-site-menu", true, "Token Catalog", drawerBrand(config)) {
			<div id="tokens-site-destinations">
				@Destinations(config)
			</div>
			<div class="tokens-drawer-appearance">
				<div id="tokens-site-appearance" class="tokens-appearance-content">
					{ children... }
				</div>
			</div>
		}
		@templ.Raw("<script>" + initialLayout + "</script>")
	</header>
}

templ Footer(config Config) {
	<footer class="tokens-site-footer" data-component-assets>
		<div class="tokens-footer-content tokens-layout-content">
			<div class="tokens-footer-credit">
				<a class="tokens-link" href="https://marmenlind.com">Made by Olle Marmenlind</a>
				<p>Independent project. Not affiliated with Google.</p>
			</div>
			<nav class="tokens-footer-links" aria-label="Project links">
				<a class="tokens-link" href="https://github.com/sojupie/tokens">GitHub</a>
				if config.Agents {
					<a class="tokens-link" href={ templ.SafeURL(config.Catalog + "/llms-full.txt") }>API reference</a>
				}
				{ children... }
			</nav>
		</div>
	</footer>
}

templ drawerBrand(config Config) {
	<a class="tokens-brand tokens-drawer-brand" href={ templ.SafeURL(config.Catalog + "/") }>
		@templ.Raw(brandLogo)
		Token Catalog
	</a>
}

// Only this region changes during page navigation; the surrounding shell stays mounted.
templ Destinations(config Config) {
	<div class="tokens-site-navigation" data-site-navigation data-active-section={ config.panelSection() } data-active-page={ config.Active }>
		<nav class="md-nav-items tokens-site-main" aria-label="Main destinations" data-navigation-group>
			@ui.NavigationItem(ui.NavigationItemProps{Label: "Home", Icon: "home", Href: config.Catalog + "/", Current: config.Active == "/"})
			for _, section := range config.sections() {
				if len(section.Items)>0 {
					@ui.NavigationItem(ui.NavigationItemProps{Label: section.Name, Icon: section.Icon, Current: config.section() == section.Path, Attrs: templ.Attributes{"data-site-section": section.Path, "aria-controls": "tokens-site-section-" + section.Path[1:], "aria-expanded": "false"}}) {
						@ui.Icon("chevron_right")
					}
				} else {
					@ui.NavigationItem(ui.NavigationItemProps{Label: section.Name, Icon: section.Icon, Href: config.Catalog + section.Path, Current: config.section() == section.Path})
				}
			}
		</nav>
		for _, section := range config.sections() {
			if len(section.Items)>0 {
				<section id={ "tokens-site-section-" + section.Path[1:] } class="tokens-site-section" data-site-panel={ section.Path } aria-label={ section.Name } hidden?={ config.section()!=section.Path }>
					<div class="tokens-section-header">
						@ui.Action(ui.ButtonProps{Variant: ui.Text, Attrs: templ.Attributes{"data-site-back": true, "class": "md-button md-text-button tokens-site-back"}}) {
							@ui.Icon("arrow_back")
							<span>Main menu</span>
						}
					</div>
					<nav class="md-nav-items tokens-section-links" aria-label={ section.Name + " pages" } data-navigation-group data-site-scroll={ section.Path }>
						@ui.DrawerLink(config.Catalog+section.Path, templ.Attributes{"aria-current": config.destinationCurrent(Destination{URL: section.Path})}, section.Name+" overview")
						for _, item := range section.Items {
							@ui.DrawerLink(config.destinationURL(item), templ.Attributes{"aria-current": config.destinationCurrent(item), "hx-boost": map[bool]string{true: "false", false: "true"}[section.Path == "/tools"]}, item.Name)
						}
					</nav>
				</section>
			}
		}
	</div>
}

// The rail is a sibling of the modal drawer, never a drawer descendant.
templ Rail(config Config) {
	<div class="tokens-site-rail-column">
		<a class="tokens-brand tokens-rail-brand" href={ templ.SafeURL(config.Catalog + "/") } aria-label="Token Catalog home">
			@templ.Raw(brandLogo)
		</a>
		@ui.NavigationRail(ui.RailProps{NavigationProps: ui.NavigationProps{Label: "Primary", Variant: "collapsed", Alignment: "top", Attrs: templ.Attributes{"class": "md-navigation md-navigation-rail tokens-site-rail"}}}) {
			@ui.NavigationItem(ui.NavigationItemProps{Label: "Home", Icon: "home", Href: config.Catalog + "/", Current: config.Active == "/"})
			for _, section := range config.sections() {
				@ui.NavigationItem(ui.NavigationItemProps{Label: section.Name, Icon: section.Icon, Href: config.Catalog + section.Path, Current: config.section() == section.Path, Attrs: templ.Attributes{"data-site-rail-section": section.Path}})
			}
		}
	</div>
}
