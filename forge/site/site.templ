package site

import "github.com/sojupie/tokens/forge/components/ui"

templ Header(config Config) {
	<header class="tokens-site-header" id="tokens-site-header" hx-preserve data-component-assets data-drawer-breakpoint={ config.drawerBreakpoint() }>
		<div class="tokens-primary-nav">
			@ui.DrawerToggle("tokens-site-menu", "Open navigation")
			<a class="tokens-brand md-typescale-title-large" href={ templ.SafeURL(config.Catalog + "/") }>
				@templ.Raw(brandLogo)
				Token Catalog
			</a>
		</div>
		@ui.Drawer("tokens-site-menu", true, "Token Catalog", drawerBrand(config)) {
			<nav class="md-nav-items" aria-label="Primary">
				@navLink(config, "/components", "Components")
				@navLink(config, "/styles", "Styles")
				@navLink(config, "/changes", "Changes")
				if config.Agents {
					@navLink(config, "/for-agents", "For agents")
				}
				<hr/>
				@navLink(config, "/tools", "Tools")
				<div class="tokens-tool-destinations" role="group" aria-label="Tools destinations">
					for _, tool := range config.Tools {
						@ui.DrawerLink(tool.URL, templ.Attributes{"hx-boost": "false", "aria-current": toolCurrent(config, tool)}, tool.Name)
					}
				</div>
			</nav>
			<div class="tokens-drawer-appearance">
				{ children... }
			</div>
		}
		@templ.Raw("<script>" + initialLayout + "</script>")
	</header>
}

templ Footer(config Config) {
	<footer class="tokens-site-footer" data-component-assets>
		<div class="tokens-footer-content">
			<div class="tokens-footer-credit">
				<a class="tokens-link" href="https://marmenlind.com">Made by Olle Marmenlind</a>
				<p>Independent project. Not affiliated with Google.</p>
			</div>
			<nav class="tokens-footer-links" aria-label="Project links">
				<a class="tokens-link" href="https://github.com/sojupie/tokens">GitHub</a>
				if config.Agents {
					<a class="tokens-link" href={ templ.SafeURL(config.Catalog + "/llms-full.txt") }>API reference</a>
				}
				{ children... }
			</nav>
		</div>
	</footer>
}

templ navLink(config Config, path string, label string) {
	@ui.DrawerLink(config.Catalog+path, templ.Attributes{"aria-current": config.current(path)}, label)
}

templ drawerBrand(config Config) {
	<a class="tokens-brand tokens-drawer-brand" href={ templ.SafeURL(config.Catalog + "/") }>
				@templ.Raw(brandLogo)
				Token Catalog
			</a>
}
