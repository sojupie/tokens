    {
      "id": "time-picker-dial-vertical-measurements",
      "statement": "For vertical dial layout, use dynamic container dimensions with left-aligned headline and 24dp padding on all sides; time selector width 96dp (114dp for 24-hour vertical layout) by 80dp high; vertical period selector 52×80dp; horizontal period selector 216×38dp; dial 256dp, selector handle 48dp, center 8dp, and track 2dp wide.",
      "condition": "When sizing a vertical dial time picker and its controls.",
      "basis": "explicit",
