    {
      "id": "split-button-use-and-size",
      "statement": "Use a split button to pair a main action with a menu of related actions, reducing visual complexity by hiding extra options. It may stand alone or accompany common buttons and icon buttons/button groups. Choose among XS, S, M, L, and XL to match button/icon-button sizes; the default is S. Scale up at large breakpoints or to add emphasis, and sizes may differ from other page controls because split buttons take more space. The menu may open another component, but keep the menu standard rather than unusually modified.",
      "condition": "When choosing and placing a split button in a product.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
        {
          "change": "added",
          "date": "2026-10-25",
          "url": "https://m3.material.io/components/split-button/guidelines",
          "section": "3b1eb38f-c709-4028-bbaf-cb221e6a3426",
          "capture": "snapshots/material-guidance/20261025T165911.881828085Z-88544552/capture.json",
          "markdownSha256": "a602a1bfeac7d40c335882b685e6fbea6f3cfa9d1900027283c8077af90c21ae",
          "extractorVersion": 2,
          "summary": "Usage guidance covers main/menu purpose, grouping, size selection and emphasis, and expected menu behavior."
        }
      ],
      "implementation": {
        "status": "unassessed",
        "sourceRevision": 1,
        "evidence": [],
        "notes": ""
      },
      "fixes": []
    },
    {
      "id": "split-button-label-icon-rtl",
      "statement": "Keep the leading action label brief (one or two words) with an icon that matches the action. Keep the trailing expand/collapse icon and do not replace it. Mirror component element order in RTL languages.",
      "condition": "When labeling or localizing split buttons.",
      "basis": "explicit",
      "notes": "",
