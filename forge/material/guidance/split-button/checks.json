      "id": "split-button-menu-placement",
      "statement": "Align an opened menu with the trailing button when possible; otherwise align it with a side of either button and keep it 4dp from the split button. Adapt the aligned edge to breakpoint, scroll position, and available space.",
      "condition": "When positioning the menu opened by the trailing button.",
      "basis": "explicit",
      "notes": "",
