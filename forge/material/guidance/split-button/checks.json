    {
      "id": "split-button-measurements",
      "statement": "Optically center text and icons when the buttons are asymmetrical and center them normally when symmetrical. Keep the inner space at 2dp. Use inner corner radii of 4dp for XS/S/M, 8dp for L, and 12dp for XL. Unselected menu icon offsets from center are XS/S −1dp, M −2dp, L −3dp, and XL −6dp.",
      "condition": "When sizing and centering split-button content.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
        {
          "change": "added",
          "date": "2026-10-25",
          "url": "https://m3.material.io/components/split-button/specs",
          "section": "2a1bfc70-e042-485e-a5e2-b2d464b97fd8",
          "capture": "snapshots/material-guidance/20261025T165911.881828085Z-88544552/capture.json",
          "markdownSha256": "cd7fd5f03974503dab91f1301932cc50f3b2d8d379f50b1a2d04b303cade8d75",
          "extractorVersion": 2,
          "summary": "Measurement text gives optical-centering behavior, inner spacing/radii, and size-specific icon offsets."
        }
      ],
      "implementation": {
        "status": "unassessed",
        "sourceRevision": 1,
