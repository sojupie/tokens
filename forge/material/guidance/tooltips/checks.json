      "id": "tooltip-overview-variants",
      "statement": "Use plain tooltips to briefly label an element or action, especially icon-only controls. Use rich tooltips for more details; they may include a title, links, or buttons.",
      "condition": "When selecting a tooltip variant and content.",
      "basis": "explicit",
      "notes": "",
