    {
      "id": "tooltip-variant-use",
      "statement": "Use a plain tooltip to briefly label an unlabeled element such as an icon-only button or field; avoid repeating an existing visible label. Use a rich tooltip to add context, definitions, explanations, or actions, but keep critical information out of tooltips because it is easy to miss; use an interruptive dialog for critical information.",
      "condition": "When selecting tooltip type and content.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
        {
          "change": "added",
          "date": "2026-10-25",
          "url": "https://m3.material.io/components/tooltips/guidelines",
          "section": "58bfadc9-b084-400a-88df-31aeeaf117d7",
          "capture": "snapshots/material-guidance/20261025T170049.028123329Z-1117351123/capture.json",
          "markdownSha256": "b8cf137fea326344d961b2d0d092c59748eca39a06048465dad26a1db8117e39",
          "extractorVersion": 2,
          "summary": "Usage guidance distinguishes label/help uses from detailed and critical information."
        }
      ],
      "implementation": {
        "status": "unassessed",
        "sourceRevision": 1,
        "evidence": [],
        "notes": ""
      },
      "fixes": []
