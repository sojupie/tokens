    {
      "id": "rich-tooltip-placement",
      "statement": "Place rich tooltips at the parent's bottom-right by default and adjust their position in 8dp increments to stay onscreen. Do not cover the parent. On desktop they may be centered below the parent and remain visible while the pointer moves within the target region.",
      "condition": "When positioning a rich tooltip.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
