    {
      "id": "tooltip-transient-behavior",
      "statement": "On desktop, hover the parent to show a tooltip; on mobile, tap and hold. Persistent rich tooltips require a click or tap. Both variants disappear 1.5 seconds after leaving the target region, and opening a new tooltip closes any other one.",
      "condition": "When showing transient tooltips or opening a new tooltip.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
