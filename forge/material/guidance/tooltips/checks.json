    {
      "id": "tooltip-persistent-rich",
      "statement": "Show persistent rich tooltips after a parent click or on page load to explain a new feature; keep them visible after the pointer leaves and dismiss only when another UI element is used. Do not trigger them on hover and avoid using them on icon buttons.",
      "condition": "When using a persistent rich tooltip.",
      "basis": "explicit",
