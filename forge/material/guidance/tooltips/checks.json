    {
      "id": "tooltip-accessible-lifetime",
      "statement": "Keep plain and rich tooltips without required actions visible long enough to read without disrupting the existing task. Tooltips may appear on hover or focus but must not hide crucial information; rich tooltips may also appear when an element is selected.",
      "condition": "When showing tooltips to assistive-technology users.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
        {
          "change": "added",
          "date": "2026-10-25",
