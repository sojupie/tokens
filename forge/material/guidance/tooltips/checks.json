    {
      "id": "plain-tooltip-placement",
      "statement": "Place a plain tooltip above its parent by default, 4dp away when the parent has a visible boundary and 8dp away when it has none. In an app bar, place it below the element at the same distance.",
      "condition": "When positioning a plain tooltip.",
      "basis": "explicit",
      "notes": "",
      "sourceHistory": [
