package web
import "github.com/sojupie/tokens/forge/components/ui"
templ specimenDate(c componentCase){ @ui.DatePicker(c.datePickerProps()) }
templ dateEntryField(c componentCase,part string){ @ui.DateEntryField(c.datePickerProps(),part) }
templ datePickerPanel(c componentCase){ @ui.DatePickerPanel(c.datePickerProps()) }
