package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

// Catalog owns these simulated pages, viewports and controls. Component slots
// below use Forge APIs; md-* host classes remain as compatibility hooks.
templ playgroundAppbar(c componentCase) {
	@useComponentAssets("appbar")
	if c.Control=="search" && c.State=="interactive" {
		<div class="md-appbar-demo md-search-demo" data-interactive="true">
			<div class="md-search-scene md-appbar-search-scene">
				<section class="md-search-page" data-search-background data-appbar-demo data-interactive="true">
					@appbarSurface(c, "Title")
					<div class="md-appbar-content">
						<h3 data-search-page-title tabindex="-1">Component library</h3>
						<p data-search-page-description>Find controls and patterns for your next screen.</p>
						for i := range 12 {
							<p>{ fmt.Sprintf("Preview content %d",i+1) }</p>
						}
					</div>
				</section>
				@searchScrim()
				@searchView(c.AppbarSearch())
			</div>
			<output class="md-typescale-body-small" data-search-feedback aria-live="polite"></output>
		</div>
	} else {
		<div class="md-appbar-demo" data-appbar-demo data-interactive={ fmt.Sprint(c.State == "interactive") }>
			@appbarSurface(c, "Title")
			if c.State=="interactive" && c.Variant!="bottom" {
				<div class="md-appbar-content" tabindex="0" role="region" aria-label="Scrollable preview content">
					for i := range 12 {
						<p class="md-typescale-body-medium">{ fmt.Sprintf("Preview content %d",i+1) }</p>
					}
				</div>
			}
		</div>
	}
}

templ playgroundBottomSheet(c componentCase) {
	@useComponentAssets("sheet")
	<div class="md-sheet-demo" data-interactive={ fmt.Sprint(c.State == "interactive") } data-kind={ c.Family }>
		if c.State=="interactive" {
			@ui.Button(c.SheetOpener()) {
				Open sheet
			}
		}
		<div class="md-sheet-frame">
			if c.State=="interactive" {
				<span class="md-typescale-body-medium md-sheet-page-label">Page content</span>
			}
			@sheetSurface(c) {
				@sheetExampleContents(c)
			}
		</div>
		if c.State=="interactive" {
			<output class="md-typescale-body-small" data-sheet-status aria-live="polite"></output>
		}
	</div>
}

templ playgroundSearch(c componentCase) {
	@useComponentAssets("search")
	<div { c.Attributes()... }>
		if c.Variant=="adaptive" {
			@useComponentAssets("card")
			@useComponentAssets("fab")
			<label class="md-search-composition-size">Composition width <input type="range" min="320" max="1200" value="1200" step="1" data-search-composition-width/><output data-search-composition-width-label>Fit to available space</output></label>
			<div class="md-search-workspace" data-search-viewport>
				<div class="md-search-app">
					<div class="md-search-mail-navigation" data-search-background>
						@searchCompositionNavigation(c)
					</div>
					@searchScene(c)
					@ui.CardSurface(ui.CardProps{Variant:"filled",Attrs: c.SearchMessageSurface()}) {
						@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Back to inbox", Attrs: templ.Attributes{"type": "button", "class": "md-search-message-back", "data-search-message-back": true}, Size: ui.Size("small"), Shape: ui.ButtonShape("round")}) {
							@materialSymbol("arrow_back")
						}
						<h3 data-search-page-title tabindex="-1">Buttons</h3>
						<p class="md-search-mail-sender">Design team · 09:30</p>
						<p>Hello,</p>
						<p data-search-page-description>Review the latest component updates and examples.</p>
						<p>The updated examples are ready for review. Let us know what you think.</p>@ui.Action(c.SearchReply()) {
	@materialSymbol("reply")
	<span>Reply</span>
}
					}
					@searchScrim()
				</div>
			</div>
		} else {
			@searchScene(c)
		}
		<output class="md-typescale-body-small" data-search-feedback aria-live="polite"></output>
	</div>
}

templ playgroundNavRail(c componentCase) {
	@ui.RailFrame(c.RailFrame(), navigationExampleSurface(c), persistentRailToggle(c)) {
		<header>
			if c.NavCollapse == "hidden" {
				<span class="md-rail-menu-slot" aria-hidden="true"></span>
			}
			<span>Workspace</span>
		</header>
		<section class="md-rail-screen" id={ c.ID() + "-screen" }>
			<h3 data-navigation-title tabindex="-1">
				if c.Selected {
					Home
				} else {
					Files
				}
			</h3>
			<p data-navigation-description>Documents and collections in your workspace.</p>
			for _, label := range []string{"Project notes","Weekend plans","Reading list","Ideas","References","Shared documents","Drafts","Resources","Planning","Archive"} {
				<article>
					<span>
						@materialSymbol("folder")
					</span>
					<div><strong>{ label }</strong><p>Updated recently</p></div>
				</article>
			}
		</section>
	}
}

templ playgroundToolbar(c componentCase) {
	@useComponentAssets("toolbar")
	<div class="md-toolbar-scene">
		<p class="md-typescale-body-medium md-toolbar-page">Document content</p>
		<div class="md-toolbar-demo" data-menu-example data-orientation={ c.Orientation }>
			@ui.ToolbarSurface(ui.ToolbarProps{Label: "Editing tools", Attrs: c.Attributes(), Orientation: c.Orientation}) {
				for i := range 3 {
					@ui.Button(c.BarAction(i)) {
						if c.Shape!="label" {
							if i==0 {
								@materialSymbol("edit")
							} else if i==1 {
								@materialSymbol("check")
							} else {
								@materialSymbol("more_vert")
							}
						}
						if c.Shape!="icon" {
							if i==0 {
								<span>Edit</span>
							} else if i==1 {
								<span>Save</span>
							} else {
								<span>More</span>
							}
						}
					}
				}
			}
			if c.Variant=="floating" && c.Size!="none" {
				@useComponentAssets("fab")
				@ui.Button(c.BarFAB()) {
					@materialSymbol("add")
				}
			}
			@ui.MenuSurface(templ.Attributes{"class": "md-toolbar-menu", "id": c.ID() + "-toolbar-menu", "data-menu-main": "", "aria-label": "More editing tools", "popover": "auto"}, "") {
				<li data-toolbar-overflow="0" hidden>
					@ui.MenuItem(templ.Attributes{"role": "menuitemcheckbox", "aria-checked": fmt.Sprint(c.Selected), "data-toolbar-proxy": "0", "data-menu-action": ""}, "Edit", toolbarExampleCheck(c), nil)
				</li>
				<li data-toolbar-overflow="1" hidden>
					@ui.MenuItem(templ.Attributes{"data-toolbar-proxy": "1", "data-menu-action": ""}, "Save", nil, nil)
				</li>
				<li>
					@ui.MenuItem(templ.Attributes{"data-menu-action": ""}, "Share", nil, nil)
				</li>
				<li>
					@ui.MenuItem(templ.Attributes{"data-menu-action": ""}, "Print", nil, nil)
				</li>
			}
			<output class="tokens-visually-hidden" data-menu-output aria-live="polite"></output>
		</div>
	</div>
}

templ playgroundList(c componentCase) {
	@useComponentAssets("list")
	@ui.ListHost(templ.Attributes{"class":templ.Classes("md-list-demo",templ.KV("md-sheet-demo",c.Control=="reorder")).String(),"data-interactive":"true","data-native-selection":fmt.Sprint(c.Control=="select")}) {
		if c.Control=="select" {
			<noscript><fieldset><legend>Select items</legend>
				for index:=range 3 {
					if c.Selection=="single" {
						@ui.Radio(ui.ChoiceProps{Name:c.ID()+"-native-selection",Label:c.ListLabel(index),Checked:c.ListSelected(index),Disabled:index==0&&c.State=="disabled"})
					} else {
						@ui.CheckboxField(ui.ChoiceProps{ID:fmt.Sprintf("%s-native-%d",c.ID(),index),Label:c.ListLabel(index),Checked:c.ListSelected(index),Disabled:index==0&&c.State=="disabled"})
					}
				}
			</fieldset></noscript>
		}
		@ui.List(ui.ListProps{Attrs: c.ListContainerAttributes()}) {
			for index:=range 3 {
				@ui.ListRowFrame(ui.ListRowFrameProps{Attrs: templ.Attributes{"role": c.ListRowRole(), "data-list-row": "", "data-list-label": c.ListLabel(index), "data-list-expanded": fmt.Sprint(c.Control == "expand" && c.Expanded && index == 0)}, ContentAttrs: c.ListItem(index), Native: c.ListNativeKind() != "", Content: listContents(c, index), Before: listExampleBefore(c, index), After: listExampleAfter(c, index), Expanded: listExampleExpanded(c, index), ChildrenAttrs: templ.Attributes{"aria-label": c.ListLabel(index) + " items", "id": fmt.Sprintf("%s-children-%d", c.ID(), index), "hidden": !(c.Expanded && index == 0)}})
			}
		}
		if c.Control=="reorder" {
			@ui.ListReorderSheet(c.ID() + "-reorder") {
				for _,direction:=range []string{"up","down"} {
					@ui.Button(c.ListMoveAction(0, direction)) {
						@ui.ListContent(ui.ListItemProps{Label: "Move " + direction, SingleLine: true, LeadingKind: ui.LeadingIcon, Leading: ui.Icon(map[string]string{"up": "arrow_upward", "down": "arrow_downward"}[direction])})
					}
				}
			}
		}
		<output class="md-typescale-body-small" aria-live="polite"></output>
	}
}
