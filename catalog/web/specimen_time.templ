package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenTime(c componentCase) {
	@useComponentAssets("time")
	<div { c.Attributes()... }>
		if c.State=="interactive" {
			@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: templ.Attributes{"data-time-open": true, "aria-controls": c.ID() + "-time", "aria-haspopup": "dialog", "aria-expanded": "false"}}) {
				Choose time
			}
		}
		@timePickerPanel(c)
		<output class="md-typescale-body-small" data-time-output aria-live="polite"></output>
	</div>
}

// Time picker anatomy; the host owns its opener and surrounding application.
templ timePickerPanel(c componentCase) {
	@ui.TimePickerPanel(c.timePickerProps())
}
