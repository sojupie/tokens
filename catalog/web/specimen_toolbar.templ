package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenToolbar(c componentCase) {
	@playgroundToolbar(c)
}

templ toolbarExampleCheck(c componentCase) {
	<span data-menu-checked-icon hidden?={ !c.Selected }>
		@ui.Icon("check")
	</span>
	<span data-menu-unchecked-icon hidden?={ c.Selected }>
		@ui.Icon("edit")
	</span>
}
