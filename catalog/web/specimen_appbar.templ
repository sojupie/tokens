package web

import "fmt"

templ specimenAppbar(c componentCase) {
	@useComponentAssets("appbar")
	if c.Control=="search" && c.State=="interactive" {
  <div class="md-appbar-demo md-search-demo" data-interactive="true">
   <div class="md-search-scene md-appbar-search-scene">
    <section class="md-search-page" data-appbar-demo data-interactive="true">
     @appbarSurface(c)
     <div class="md-appbar-content">
      <h3 data-search-page-title tabindex="-1">Component library</h3>
      <p data-search-page-description>Find controls and patterns for your next screen.</p>
      for i := range 12 {
       <p>{ fmt.Sprintf("Preview content %d",i+1) }</p>
      }
     </div>
    </section>
    @searchScrim()
    @searchView(c.AppbarSearch())
   </div>
   <output class="md-typescale-body-small" data-search-feedback aria-live="polite"></output>
  </div>
 } else {
	<div class="md-appbar-demo" data-appbar-demo data-interactive={ fmt.Sprint(c.State == "interactive") }>
		@appbarSurface(c)
		if c.State=="interactive" && c.Variant!="bottom" {
			<div class="md-appbar-content" tabindex="0" role="region" aria-label="Scrollable preview content">
				for i := range 12 {
					<p class="md-typescale-body-medium">{ fmt.Sprintf("Preview content %d",i+1) }</p>
				}
			</div>
		}
	</div>
 }
}

templ appbarSurface(c componentCase) {
	<div { c.Attributes()... } role="group" aria-label="App bar">
		<div class="md-appbar-row">
			<button { c.BarAction(0)... }>@materialSymbol("arrow_back")
</button>
			if c.Variant!="bottom" && !c.BarExpanded() {
				if c.Control=="search" {
      if c.State=="interactive" {
       <button class="md-button md-appbar-search" type="button" data-search-open aria-label="Search" aria-haspopup="dialog" aria-expanded="false" aria-controls={ c.AppbarSearch().ID()+"-view" }>@materialSymbol("search")<span>Search</span></button>
      } else {
					<label class="md-appbar-search">@materialSymbol("search")
<input type="search" placeholder="Search" aria-label="Search preview"/></label>
      }
				} else {
					<span class="md-appbar-copy">
						<h3 class="md-appbar-title">Title</h3>
						if c.Control=="subtitle" {
							<span class="md-appbar-subtitle">Subtitle</span>
						}
					</span>
				}
			}
			<div class="md-appbar-actions">
				<button { c.BarAction(1)... }>@materialSymbol("star")
</button>
				if c.Control=="avatar" {
					<span class="md-appbar-avatar-slot"><span class="md-appbar-avatar" role="img" aria-label="Profile">A</span></span>
				} else {
					<button { c.BarAction(2)... }>@materialSymbol("menu")
</button>
				}
				if c.Control=="fab" {
					@useComponentAssets("fab")
					<button class="md-button md-fab" data-variant="secondary-container" data-size="default" type="button" aria-label="Create">@materialSymbol("add")
</button>
				}
			</div>
		</div>
		if c.BarExpanded() {
			<div class="md-appbar-copy md-appbar-expanded">
				<h3 class="md-appbar-title">Title</h3>
				if c.Control=="subtitle" {
					<span class="md-appbar-subtitle">Subtitle</span>
				}
			</div>
		}
	</div>
}
