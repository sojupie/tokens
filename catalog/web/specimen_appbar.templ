package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenAppbar(c componentCase) {
	@playgroundAppbar(c)
}

templ appbarSurface(c componentCase, title string) {
	{{
		p := ui.AppBarProps{Title: title, Expanded: c.BarExpanded(), Variant: c.Variant, Attrs: c.Attributes(), Leading: appbarExampleLeading(c), Actions: appbarExampleActions(c)}
		if c.Control == "subtitle" {
			p.Subtitle = "Subtitle"
		}
		if c.Control == "search" {
			p.Search = appbarExampleSearch(c)
		}
	}}
	@ui.AppBar(p)
}

templ appbarExampleLeading(c componentCase) {
	@ui.Button(c.BarAction(0)) {
		@ui.Icon("arrow_back")
	}
}

templ appbarExampleActions(c componentCase) {
	@ui.Button(c.BarAction(1)) {
		@ui.Icon("star")
	}
	if c.Control=="avatar" {
		@ui.AppBarAvatar("A", "Profile")
	} else {
		@ui.Button(c.BarAction(2)) {
			@ui.Icon("menu")
		}
	}
	if c.Control=="fab" {
		@ui.FAB(ui.FABProps{Label: "Create", Icon: "add", Variant: "secondary-container"})
	}
}

templ appbarExampleSearch(c componentCase) {
	@ui.AppBarSearch(c.AppbarSearch().ID()+"-view", "Search", c.State == "interactive")
}

// Content app bars share the same anatomy and generated bindings as specimens.
// The host provides meaningful actions and chooses whether a subtitle is needed.
templ contentAppBar(c componentCase, title, subtitle string) {
	@ui.AppBar(ui.AppBarProps{Title: title, Subtitle: subtitle, Expanded: c.BarExpanded(), Attrs: c.Attributes()}) {
		{ children... }
	}
}
