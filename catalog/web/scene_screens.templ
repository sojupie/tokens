package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ sceneReviewPage(items []sceneReviewItem) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light" data-contrast="default">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>Scene review · Token Catalog</title>
			<link rel="stylesheet" href="/theme.css"/>
			<link rel="stylesheet" href={ staticURL("app.css") }/>
			<link rel="stylesheet" href={ staticURL("buttons.css") }/>
			<link rel="stylesheet" href={ staticURL("scene-screens.css") }/>
			<script src={ staticURL("scene-review.js") } defer></script>
		</head>
		<body class="scene-review-page">
			<header class="scene-review-controls">
				<div><h1 class="md-typescale-title-large">Component scenes</h1><p class="md-typescale-body-medium">Live markup · Phone 412 × 892 · Tablet 840 × 1120 · Desktop 1440 × 1000</p></div>
				<label><input type="checkbox" data-review-grid/> Column overlay</label>
				<label>Appearance <select data-review-theme><option value="light">Light</option><option value="dark">Dark</option></select></label>
				<label>Contrast <select data-review-contrast><option value="default">Default</option><option value="medium">Medium</option><option value="high">High</option></select></label>
			</header>
			<nav class="scene-review-index" aria-label="Scenes">
				for _,item:=range items {
					<a href={ templ.SafeURL("#review-" + item.Path[len("/components/"):]) }>{ item.Name }</a>
				}
			</nav>
			<main>
				for _,item:=range items {
					<section class="scene-review-entry" id={ "review-" + item.Path[len("/components/"):] }>
						<header><h2 class="md-typescale-title-large">{ item.Name }</h2><span class="md-typescale-body-medium">{ fmt.Sprintf("%s · %d × %d",item.Device,item.Width,item.Height) }</span><a href={ templ.SafeURL("/illustrations/render" + item.Path + "?view=review") } target="_blank" rel="noopener">Open at native size</a></header>
						<div class="scene-review-viewport" style={ templ.SafeCSS(fmt.Sprintf("--frame-width:%d;--frame-height:%d", item.Width, item.Height)) }>
							<iframe title={ item.Name + " app scene" } src={ "/illustrations/render" + item.Path + "?view=review" } width={ fmt.Sprint(item.Width) } height={ fmt.Sprint(item.Height) } loading="lazy"></iframe>
						</div>
					</section>
				}
			</main>
		</body>
	</html>
}

// Scene composition owns application layout and content. Forge owns each control.
templ sceneScreen(c componentCase) {
	@useComponentAssets("card")
	@useComponentAssets("list")
	<section class="scene-screen" data-device={ sceneDevice(c.Family) } data-family={ c.Family } style={ sceneFrameStyle(c) }>
		if sceneDevice(c.Family)!="desktop" {
			<div class="scene-system-bar md-typescale-label-medium">
				<span>9:30</span>
				<span aria-label="Connected, battery full">
					@materialSymbol("wifi")
					@materialSymbol("battery_full")
				</span>
			</div>
		}
		<div class="scene-workspace">
			if c.Family=="nav-drawer" || c.Family=="nav-rail" {
				@sceneNavigation(c)
			}
			<div class="scene-primary tokens-layout">
				if sceneUsesAppBar(c.Family) {
					@sceneBar(c)
				}
				@sceneScreenContent(c)
				<div class="scene-column-overlay tokens-layout-content" aria-hidden="true">
					for range 12 {
						<span></span>
					}
				</div>
			</div>
		</div>
		if sceneDevice(c.Family)!="desktop" {
			<div class="scene-system-bottom"><span></span></div>
		}
	</section>
}

templ sceneIcon(icon string, label string) {
	@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: label, Attrs: templ.Attributes{"type": "button"}, Size: ui.Size("small"), Shape: ui.ButtonShape("round")}) {
		@materialSymbol(icon)
	}
}

templ sceneBar(c componentCase) {
	{{ bar := sceneBarCase(c.Family, c.sceneTitle()) }}
	@ui.AppBar(ui.AppBarProps{Title: c.sceneTitle(), Variant: bar.Variant, Expanded: bar.BarExpanded(), Attrs: bar.Attributes(), Leading: sceneIcon(map[bool]string{true: "menu", false: "arrow_back"}[c.Family == "extended-fab" || c.Family == "fab-menu"], "Navigation"), Actions: sceneBarActions(c)})
}

templ sceneBarActions(c componentCase) {
	if c.Family=="date" || c.Family=="time" {
		@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
			Save
		}
	} else if c.Family=="loading" {
		@sceneIcon("call", "Call Maya")
		@sceneIcon("more_vert", "Conversation options")
	} else if c.Family!="radio" && c.Family!="divider" && c.Family!="switch" {
		@sceneIcon("search", "Search")
		if c.Family=="appbar" {
			@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Account: Maya Chen", Size: ui.Size("small")}) {
				@materialSymbol("person")
			}
		} else {
			@sceneIcon("more_vert", "More options")
		}
	}
}

templ sceneDataRows(rows [][4]string, avatars bool) {
	{{
		leading := ui.LeadingIcon
		if avatars {
			leading = ui.LeadingAvatar
		}
	}}
	@ui.List(ui.ListProps{Label: "Items", Leading: leading}) {
		for _,row:=range rows {
			{{
				p := ui.ListItemProps{Label: row[1], Supporting: row[2], Metadata: row[3], Avatar: row[0], LeadingKind: leading}
				if !avatars {
					p.Leading = ui.Icon(row[0])
				}
			}}
			@ui.ListRow(p)
		}
	}
}

templ sceneField(id string, label string, value string, help string, invalid bool) {
	@ui.TextField(ui.TextFieldProps{ID: id, Label: label, Value: value, Supporting: help, Invalid: invalid, Placeholder: label})
}

templ sceneCollection(family string, titles []string) {
	<div class="scene-art-grid tokens-layout-grid" id={ map[bool]string{true: "scene-results-search-results", false: "scene-results-" + family}[family == "chip"] }>
		for i,title:=range titles {
			@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card"}}) {
				@ui.CardMedia(string(staticURL("paintings/"+sceneCollectionPainting(family, i))), "Landscape from the collection", templ.Attributes{"width": "1200", "height": "800"})
				@ui.CardBody(nil) {
					<h2 class="md-card-headline">{ title }</h2>
					<p class="md-card-supporting-text">{ []string{"18 works · On view until 12 December","24 works · Collection highlights","12 works · New acquisitions","32 works · Permanent collection"}[i%4] }</p>
				}
			}
		}
	</div>
}

templ sceneMail(archived bool) {
	@sceneDataRows(sceneInboxRows(archived), true)
	if !archived {
		<p class="md-typescale-body-small scene-list-end">All caught up · Last synced at 9:30</p>
	}
}

templ sceneNavigation(c componentCase) {
	@useComponentAssets("navigation")
	if c.Family=="nav-drawer" {
		@ui.Drawer(c.ID()+"-drawer", false, "Mail folders") {
			<div class="scene-account"><span class="md-typescale-title-medium">Maya Chen</span><span class="md-typescale-body-medium">maya@example.com</span></div>
			@ui.NavigationItems() {
				for i,label:=range []string{"Inbox","Starred","Sent","Drafts","Archive","Trash"} {
					@ui.NavigationItem(ui.NavigationItemProps{Label: label, Icon: []string{"mail", "star", "send", "edit", "archive", "delete"}[i], Count: []string{"8", "", "", "3", "", ""}[i], Attrs: c.NavigationItem(i)})
				}
			}
			<output class="tokens-visually-hidden" id={ c.ID() + "-selection" }></output>
		}
	} else {
		@ui.NavigationSurface(c.Attributes(), false, templ.Attributes{"aria-label": "Learning platform"}) {
			<header>
				@sceneIcon("menu", "Navigation menu")
			</header>
			@ui.NavigationItems() {
				for i,label:=range []string{"My courses","Explore","Saved","Profile"} {
					@ui.Button(c.NavigationItem(i)) {
						@navigationItemContents(c, i, label, []string{"home", "search", "star", "person"}[i])
					}
				}
			}
			<output class="tokens-visually-hidden" id={ c.ID() + "-selection" }></output>
		}
	}
}

templ sceneScreenContent(c componentCase) {
	<div class="scene-page tokens-layout-content" data-scene-task={ c.Family } id={ c.ID() + "-screen" }>
		if !sceneHasOwnHeading(c.Family) {
			<header class="scene-task-heading">
				<h1 class="md-typescale-headline-medium">{ c.sceneTitle() }</h1>
				if c.Family=="badge" {
					@sceneIcon("edit", "New message")
				}
				if c.Family=="nav-drawer" || c.Family=="extended-fab" {
					@sceneIcon("search", "Search mail")
				}
			</header>
		}
		switch c.Family {
			case "appbar":
				<div class="scene-inline-actions">
					<span class="md-typescale-title-medium">Continue learning</span>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	View all
}
				</div>
				@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card scene-course-feature"}}) {
					@ui.CardMedia(string(staticURL("paintings/"+scenePainting(c.Family, "coast"))), "Coastal landscape", templ.Attributes{})
					@ui.CardBody(nil) {
						<h2 class="md-card-headline">Landscape painting: light and atmosphere</h2>
						<p class="md-card-supporting-text">Lesson 3 of 8 · 12 minutes remaining</p>
						<div class="md-card-actions">
							@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
								Resume lesson
							}
						</div>
					}
				}
				<h2 class="md-typescale-title-large">Your courses</h2>
				@sceneDataRows([][4]string{{"palette", "Color foundations", "6 of 10 lessons completed", "60%"}, {"image", "Composition in practice", "2 of 8 lessons completed", "25%"}, {"edit", "Drawing from observation", "Not started", "8 lessons"}, {"photo_camera", "Understanding exposure", "4 of 6 lessons completed", "67%"}}, false)
			case "badge":
				<div class="scene-inline-actions">
					@sceneFilter("All", true)
					@sceneFilter("Unread", false)
				</div>
				@useComponentAssets("badge")
				@ui.List(ui.ListProps{Leading: ui.LeadingAvatar, Attrs: templ.Attributes{"class": "scene-conversations"}}) {
					for i,name:=range []string{"Maya Chen","Studio group","Alex Morgan","Jamie Park","Robin Ellis","Book club","Sam Rivera","Lea Wong"} {
						@ui.ListRow(ui.ListItemProps{Label: name, Avatar: name[:1], LeadingKind: ui.LeadingAvatar, Supporting: []string{"See you by the entrance at 10?", "Maya: The new timetable is ready", "Sent you the revised print proofs", "Thanks! That works for me", "Do you have the workshop notes?", "Sam: Next Thursday at 7", "You: I’ll check and get back to you", "The exhibition closes on Sunday"}[i], Trailing: sceneMessageTail(i)})
					}
				}
				{{ bar := componentCase{Family: "nav-bar", Variant: "vertical", State: "enabled", Selected: true, instanceID: "scene-messaging-nav"} }}
				@useComponentAssets("navigation")
				<div class="scene-message-destinations">
					@ui.NavigationSurface(bar.Attributes(), false, templ.Attributes{"aria-label": "Messaging"}) {
						@ui.NavigationItems() {
							for i,label:=range []string{"Chats","Updates","Calls"} {
								@ui.NavigationItem(sceneMessageDestination(bar, i, label))
							}
						}
						<output class="tokens-visually-hidden" id={ bar.ID() + "-selection" }></output>
					}
				</div>
			case "bottom-sheet":
				<div class="scene-place-photo">
					@sceneArtwork(c.Family, "coast")
				</div>
				<h2 class="md-typescale-headline-small">Art and local history</h2>
				<p class="md-typescale-body-large">Free admission · 4.7 from 320 visits</p>
				@sceneDataRows([][4]string{{"location_on", "12 Riverside Road", "North entrance, beside the park", ""}, {"schedule", "Open today until 18:00", "Last entry at 17:30", ""}, {"star", "Saved to Places to visit", "Private collection", ""}}, false)
				<div class="scene-modal-shade scene-bottom-overlay">
					@sheetSurface(c) {
						@ui.SheetHeader(ui.SheetProps{ID: c.ID(), Title: "Routes to Riverside Museum"})
						@ui.SheetBody() {
							@sceneDataRows([][4]string{{"directions_walk", "Walk via Riverside Road", "1.8 km · Mostly flat", "24 min"}, {"directions_bus", "Bus 12 · Museum stop", "Departs 9:42 · Every 15 min", "18 min"}, {"directions_bike", "Cycle via the park", "2.1 km · Cycle lanes", "9 min"}}, false)
						}
						@ui.SheetActions() {
							@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
								Start walking route
							}
						}
					}
				</div>
			case "button-group":
				<div class="scene-player">
					<div class="scene-album-art">
						@sceneArtwork(c.Family, "coast")
					</div>
					<h2 class="md-typescale-headline-small">Field recordings · Green River</h2>
					<p class="md-typescale-body-large">Sound archive · Episode 12</p>
					<div class="scene-player-seek">
						@specimenSlider(componentCase{Family: "slider", Variant: "continuous", Control: "single", Orientation: "horizontal", Size: "xsmall", State: "enabled"})
						<div class="scene-inline-actions md-typescale-body-small"><span>12:24</span><span>31:00</span></div>
					</div>
					@useComponentAssets("button-group")
					<div { sceneNamedAttributes(c,"Playback")... }>
						@ui.Button(c.GroupButton(0)) {
							@materialSymbol("skip_previous")
							<span>Previous</span>
						}
						@ui.Button(c.GroupButton(1)) {
							@materialSymbol("pause")
							<span>Pause</span>
						}
						@ui.Button(c.GroupButton(2)) {
							@materialSymbol("skip_next")
							<span>Next</span>
						}
					</div>
					<div class="scene-inline-actions">
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
							Playback speed: 1×
						}
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
							Queue · 4
						}
					</div>
				</div>
			case "button":
				<header class="scene-store-header">
					<span class="md-typescale-title-large">Gallery Editions</span>
					<nav aria-label="Shop">
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
							Prints
						}
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
							Framing
						}
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
							About
						}
					</nav>@sceneIcon("shopping_bag", "Shopping bag")
				</header>
				<p class="md-typescale-body-medium">Prints / Landscapes / Coastal study</p>
				<div class="scene-product-grid tokens-layout-grid">
					<div class="scene-product-art">
						@sceneArtwork(c.Family, "coast")
					</div>
					<section>
						<h1 class="md-typescale-headline-large">Coastal study</h1>
						<p class="md-typescale-body-large">Fine art paper · Archival pigment print</p>
						<p class="md-typescale-headline-small">€48</p>
						<p class="md-typescale-body-large">A coastal landscape from the public-domain collection, printed to order on textured, acid-free paper.</p>
						<h2 class="md-typescale-title-medium">Size</h2>
						<div class="scene-inline-options">
							@sceneFilter("30 × 40 cm", true)
							@sceneFilter("50 × 70 cm", false)
						</div>
						<h2 class="md-typescale-title-medium">Frame</h2>
						<div class="scene-inline-options">
							@sceneFilter("Unframed", true)
							@sceneFilter("Oak", false)
							@sceneFilter("Black", false)
						</div>
						<div class="scene-inline-options">
							@ui.Button(c.Attributes()) {
								@materialSymbol("add")
								<span>Add to bag · €48</span>
							}
							@ui.Button(c.thumbnailVariant("outlined").Attributes()) {
								Save for later
							}
						</div>
						<p class="md-typescale-body-medium">Ships in 3–5 working days. Free delivery on orders over €75.</p>
						@ui.Divider("full", templ.Attributes{"class": "md-divider"})
						<h2 class="md-typescale-title-medium">Paper and care</h2>
						<p class="md-typescale-body-large">230 gsm matte paper. Keep away from direct sunlight and frame behind glass.</p>
					</section>
				</div>
			case "card":
				<div class="scene-inline-actions">
					<h2 class="md-typescale-title-large">Current exhibitions</h2>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	Filter
}
				</div>
				@sceneCollection(c.Family, []string{"Coast and countryside", "Landscapes across Europe", "Light on the water", "From the archive"})
			case "carousel":
				<h2 class="md-typescale-title-large">Featured collections</h2>@carouselSurface(c, false)
				<h2 class="md-typescale-title-large">At the museum</h2>@sceneDataRows([][4]string{{"image", "Landscapes across Europe", "Gallery 4 · Until 12 December", ""}, {"palette", "Works on paper", "Gallery 2 · New display", ""}, {"schedule", "Plan your visit", "Open today, 10:00–18:00", ""}, {"confirmation_number", "Tickets and admission", "Permanent collection is free", ""}}, false)
			case "checkbox":
				<p class="md-typescale-body-large">Friday, 6 November</p>
				<div class="scene-inline-actions"><h2 class="md-typescale-title-medium">Preparation</h2><span class="md-typescale-body-medium">2 of 7 complete</span></div>
				<ul class="scene-task-list">
					for i,label:=range []string{"Confirm artwork list","Book installation team","Send invitations","Print exhibition labels","Arrange refreshments","Check lighting","Prepare opening remarks"} {
						<li>
							@checkboxChoice(c.sceneInstance(i).thumbnailSelected(i < 2), label)
							<span class="md-typescale-body-small">{ []string{"Completed yesterday","Completed today","Due today","Tomorrow","Thu, 5 Nov","Fri, 6 Nov","Fri, 6 Nov"}[i] }</span>
						</li>
					}
				</ul>
				@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
					@materialSymbol("add")
					<span>Add task</span>
				}
			case "chip", "search":
				@sceneSearch(c)
				<div class="scene-inline-options scene-result-filters">
					@componentSpecimen(componentCase{Family: "chip", Variant: "filter", State: "enabled", Selected: true, illustrationLabels: [3]string{"Landscape"}})
					@componentSpecimen(componentCase{Family: "chip", Variant: "filter", State: "enabled", Selected: true, illustrationLabels: [3]string{"In collection"}, instanceID: "collection-filter"})
					@componentSpecimen(componentCase{Family: "chip", Variant: "filter", State: "enabled", illustrationLabels: [3]string{"On display"}, instanceID: "display-filter"})
				</div>
				<div class="scene-inline-actions">
					<h2 class="md-typescale-title-medium">24 results for “landscape”</h2>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	Sort: Relevance
}
				</div>
				@sceneCollection("chip", []string{"River landscapes", "Painting the seasons", "Across the countryside", "Light and reflection"})
			case "date", "time":
				<div class="scene-form-stack">
					if c.Family=="date" {
						@sceneField("event-title", "Event title", "Exhibition planning", "", false)
						@sceneField("event-date", "Date", "Wednesday, 21 October 2026", "", false)
						@sceneField("event-time", "Time", "10:00–11:00", "", false)
						@sceneField("event-location", "Location", "Meeting room 2", "", false)
						@sceneField("event-people", "Guests", "Maya Chen, Alex Morgan", "", false)
						@sceneField("event-notes", "Notes", "Review the artwork list and installation schedule.", "", false)
					} else {
						<p class="md-typescale-display-medium scene-alarm-time">10:10 <span class="md-typescale-title-large">AM</span></p>
						@sceneField("alarm-label", "Label", "Morning break", "", false)
						<h2 class="md-typescale-title-medium">Repeat</h2>
						<div class="scene-inline-options">
							for _,day:=range []string{"M","T","W","T","F","S","S"} {
								@sceneFilter(day, true)
							}
						</div>
						@sceneDataRows([][4]string{{"music_note", "Sound", "Soft chimes", ""}, {"snooze", "Snooze", "10 minutes", ""}}, false)
					}
				</div>
				<div class="scene-modal-shade scene-picker-overlay">
					@componentSpecimen(c)
				</div>
			case "dialog", "fab-menu":
				<div class="scene-inline-actions">
					<p class="md-typescale-body-large">My files / Exhibition 2026</p>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	Sort: Name
}
				</div>
				@sceneFiles(c.Family)
				if c.Family=="dialog" {
					<div class="scene-modal-shade scene-dialog-overlay">
						@ui.Modal(ui.DialogProps{ID: c.ID() + "-panel", TitleID: c.ID() + "-heading", DescriptionID: c.ID() + "-support", Title: "Delete “Budget draft.xlsx”?", Description: "This file will move to Trash. You can restore it for 30 days.", Attrs: c.DialogPanel(), Actions: sceneDeleteDialogActions(c)})
					</div>
				} else {
					<div class="scene-fab-anchor">
						@componentSpecimen(c)
					</div>
				}
			case "divider":
				@sceneDataRows([][4]string{{"person", "Maya Chen", "maya@example.com", "Edit"}, {"lock", "Password and security", "Updated 12 October", ""}}, false)
				@ui.Divider("full", c.Attributes())
				<h2 class="md-typescale-title-medium">Notifications</h2>@sceneDataRows([][4]string{{"notifications", "Push notifications", "Messages and reminders", "On"}, {"mail", "Email preferences", "Weekly summary", ""}}, false)
				@ui.Divider("full", c.sceneInstance(1).Attributes())
				<h2 class="md-typescale-title-medium">Storage and data</h2>@sceneDataRows([][4]string{{"storage", "Storage used", "1.2 GB of 15 GB", ""}, {"download", "Offline content", "3 collections available offline", ""}, {"delete", "Clear cache", "128 MB of temporary files", ""}}, false)
			case "extended-fab", "nav-drawer", "snackbar":
				<div class="scene-inline-actions"><span class="md-typescale-title-medium">{ map[bool]string{true:"Primary",false:"Today"}[c.Family=="extended-fab"] }</span><span class="md-typescale-body-medium">{ map[bool]string{true:"8 unread",false:"7 messages"}[c.Family!="snackbar"] }</span></div>
				@sceneMail(c.Family == "snackbar")
				if c.Family=="extended-fab" {
					@sceneCreateButton("Compose", "edit", true)
				}
				if c.Family=="snackbar" {
					@useComponentAssets("messages")
					<div class="scene-snackbar-anchor">
						@ui.SnackbarMessage(ui.SnackbarProps{Text: "Conversation archived", Inline: true, HideDismiss: true, Attrs: c.Attributes(), Action: sceneSnackbarAction(c)})
					</div>
				}
			case "fab":
				<p class="md-typescale-body-medium">Pinned</p>
				@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card scene-note-card"}}) {
					@ui.CardBody(nil) {
						<h2 class="md-card-headline">Installation checklist</h2>
						<p class="md-card-supporting-text">Check hanging heights, print labels, test the lighting. Gallery opens at 10.</p><span class="md-typescale-label-medium">Today, 8:45</span>
					}
				}
				<h2 class="md-typescale-title-medium">All notes</h2>
				@sceneDataRows([][4]string{{"description", "Meeting notes · 28 October", "Final artwork list approved. Follow up with…", "Yesterday"}, {"description", "Books to find", "Color and Light; Ways of Seeing; Interaction…", "Tue"}, {"description", "Workshop ideas", "Try short drawing exercises before the tour.", "Mon"}, {"description", "Print specifications", "A3, 230 gsm matte, 12 copies for the preview.", "24 Oct"}, {"description", "Visitor feedback", "More seating in the second gallery.", "22 Oct"}}, false)
				@sceneCreateButton("New note", "add", false)
			case "icon":
				<header class="scene-viewer-bar">
					<div class="scene-inline-options">
						@sceneIcon("arrow_back", "Back to collection")
						<h1 class="md-typescale-title-medium">Valley study.jpg</h1><span class="md-typescale-body-medium">12 of 24</span>
					</div>
					<div class="scene-inline-options">
						@ui.Button(sceneNamedAttributes(c, "Favorite")) {
							@materialSymbol("star")
						}
						@ui.Button(sceneNamedAttributes(c.thumbnailVariant("standard").sceneInstance(1), "Rotate left")) {
							@materialSymbol("rotate_left")
						}
						@ui.Button(sceneNamedAttributes(c.thumbnailVariant("standard").sceneInstance(2), "Download")) {
							@materialSymbol("download")
						}
						@sceneIcon("more_vert", "More options")
					</div>
				</header>
				<div class="scene-image-viewer">
					@sceneIcon("chevron_left", "Previous image")
					<div>
						@sceneArtwork(c.Family, "coast")
					</div>@sceneIcon("chevron_right", "Next image")
				</div>
				<div class="scene-inline-actions">
					<span class="md-typescale-body-medium">2400 × 1600 · JPEG · 3.8 MB</span>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
	Details
}
				</div>
			case "list":
				<p class="md-typescale-title-medium">Today</p>
				@sceneDataRows([][4]string{{"description", "Exhibition guide.pdf", "2.4 MB · Downloaded at 9:21", "Open"}, {"image", "Gallery plan.png", "860 KB · Downloaded at 9:15", "Open"}, {"folder_zip", "Artwork references.zip", "82 MB · 34 MB downloaded", "41%"}, {"description", "Workshop notes.pdf", "1.1 MB · Downloaded at 8:42", "Open"}}, false)
				<h2 class="md-typescale-title-medium">Yesterday</h2>@sceneDataRows([][4]string{{"table_chart", "Budget draft.xlsx", "128 KB · Downloaded at 16:05", "Open"}, {"image", "Installation view.jpg", "3.8 MB · Downloaded at 14:30", "Open"}, {"description", "Visitor survey.pdf", "420 KB · Downloaded at 11:10", "Open"}}, false)
			case "loading":
				<div class="scene-older-messages">
					@componentSpecimen(c)
				</div>
				<p class="scene-chat-date md-typescale-label-medium">Yesterday</p>
				<div class="scene-chat"><p class="scene-chat-in md-typescale-body-large">Have you had a chance to review the installation plan?<small>16:42</small></p><p class="scene-chat-out md-typescale-body-large">Yes! The spacing in gallery 2 looks good. Could we move the bench closer to the window?<small>16:45 · Read</small></p><p class="scene-chat-in md-typescale-body-large">That should work. I’ll update the plan before tomorrow’s meeting.<small>16:46</small></p><p class="scene-chat-out md-typescale-body-large">Thanks. I’ll bring the label proofs too.<small>16:48 · Read</small></p><p class="scene-chat-in md-typescale-body-large">Perfect, see you at 10.<small>16:49</small></p></div>
				<div class="scene-chat-compose">
					@sceneIcon("add", "Attach")
					<span class="md-typescale-body-large">Message Maya</span>@sceneIcon("send", "Send message")
				</div>
			case "menu":
				@sceneDocument(c)
			case "nav-bar":
				<div class="scene-inline-actions">
					<h2 class="md-typescale-title-medium">Playlists</h2>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	New playlist
}
				</div>
				@sceneDataRows([][4]string{{"queue_music", "On repeat", "24 tracks · Updated today", ""}, {"queue_music", "Instrumental focus", "38 tracks · 2 hr 14 min", ""}, {"queue_music", "Field recordings", "12 recordings · 4 hr 20 min", ""}}, false)
				<h2 class="md-typescale-title-medium">Recently played</h2>@sceneDataRows([][4]string{{"music_note", "Summer air", "Water house · 4:14", ""}, {"music_note", "Slow down", "Water house · 7:28", ""}, {"music_note", "Family tree", "Water house · 3:43", ""}}, false)
				<div class="scene-now-playing">
					<span>
						@materialSymbol("music_note")
					</span>
					<div><span class="md-typescale-label-large">Summer air</span><p class="md-typescale-body-small">Water house</p></div>@sceneIcon("pause", "Pause playback")
				</div>
				@useComponentAssets("navigation")
				<div class="scene-bottom-navigation">
					@ui.NavigationSurface(sceneNamedAttributes(c, "Music destinations"), false) {
						@ui.NavigationItems() {
							for i,label:=range []string{"Library","Browse","Radio","Search"} {
								@ui.Button(c.NavigationItem(i)) {
									@navigationItemContents(c, i, label, []string{"library_music", "explore", "radio", "search"}[i])
								}
							}
						}
						<output class="tokens-visually-hidden" id={ c.ID() + "-selection" }></output>
					}
				</div>
			case "nav-rail":
				<div class="scene-learning-layout tokens-layout-grid">
					<article>
						<div class="scene-lesson-art">
							@sceneArtwork(c.Family, "coast")
						</div>
						<h2 class="md-typescale-headline-medium">Landscape composition</h2>
						<p class="md-typescale-body-large">Lesson 3 · Framing the subject</p>
						<p class="md-typescale-body-large">Explore how foreground, middle ground and distance guide the viewer through a landscape. In this lesson, compare three arrangements and make a study of your own.</p>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
	Continue lesson · 7:28
}
						<h3 class="md-typescale-title-medium">Your notes</h3>
						<p class="md-typescale-body-large">Use a darker foreground to frame the lighter middle distance. Keep the horizon below the centre for this study.</p>
					</article>
					<aside>
						<h2 class="md-typescale-title-large">Lessons</h2>@sceneDataRows([][4]string{{"check_circle", "1. Seeing the landscape", "Completed", "4:14"}, {"check_circle", "2. Choosing a viewpoint", "Completed", "6:20"}, {"play_circle", "3. Framing the subject", "In progress", "7:28"}, {"play_circle", "4. Light and shadow", "Not started", "8:12"}, {"play_circle", "5. Color relationships", "Not started", "5:43"}, {"play_circle", "6. Your final study", "Not started", "9:10"}}, false)
					</aside>
				</div>
			case "progress":
				<div class="scene-transfer-summary"><h2 class="md-typescale-title-large">3 transfers · 1 active</h2><p class="md-typescale-body-large">Saving to Downloads / Exhibition references</p></div>
				<article class="scene-transfer">
					<div class="scene-inline-actions">
						<h3 class="md-typescale-title-medium">Artwork references.zip</h3>
						<div>
							@sceneIcon("pause", "Pause transfer")
							@sceneIcon("close", "Cancel transfer")
						</div>
					</div>
					<p class="md-typescale-body-large">82 MB of 205 MB · 4.2 MB/s · About 30 seconds remaining</p>@componentSpecimen(c)
				</article>
				@sceneDataRows([][4]string{{"check_circle", "Exhibition guide.pdf", "2.4 MB · Completed at 9:21", "Open folder"}, {"schedule", "Installation photos.zip", "128 MB · Waiting for current transfer", "Queued"}}, false)
			case "radio":
				@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card"}}) {
					@ui.CardBody(nil) {
						<h2 class="md-card-headline">Order #1048</h2>
						<p class="md-card-supporting-text">Coastal study · 30 × 40 cm · Unframed</p>
						<p class="md-typescale-title-large">€48.00</p>
					}
				}
				<h2 class="md-typescale-title-medium">Delivery method</h2>
				<div class="scene-delivery-options">
					for i,label:=range []string{"Standard delivery","Express delivery","Collect in store"} {
						<div>
							@radioChoice(c, i, label)
							<p class="md-typescale-body-medium">{ []string{"3–5 working days · €4.90","1–2 working days · €9.90","Ready tomorrow · Free"}[i] }</p>
						</div>
					}
				</div>
				@ui.Divider("full", templ.Attributes{"class": "md-divider"})
				<div class="scene-inline-actions md-typescale-title-medium"><span>Total, including delivery</span><span>€52.90</span></div>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("medium")}) {
	Continue to payment
}
			case "segmented":
				<div class="scene-calendar-controls">
					<div class="scene-inline-options">
						@sceneIcon("chevron_left", "Previous week")
						<h2 class="md-typescale-title-large">26–30 October 2026</h2>@sceneIcon("chevron_right", "Next week")
					</div>@componentSpecimen(c)
				</div>
				<div class="scene-week-calendar">
					<div class="scene-calendar-hours md-typescale-label-medium">
						for _,hour:=range []string{"09:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00"} {
							<span>{ hour }</span>
						}
					</div>
					for i,day:=range []string{"Mon 26","Tue 27","Wed 28","Thu 29","Fri 30"} {
						<section>
							<h3 class="md-typescale-label-large">{ day }</h3>
							<div class={ "scene-calendar-event scene-event-" + fmt.Sprint(i) }><strong class="md-typescale-label-large">{ []string{"Planning","Studio visit","Research","Design review","Team lunch"}[i] }</strong><span class="md-typescale-body-small">{ []string{"9:00–10:00","11:00–12:00","10:00–11:30","9:00–10:00","12:00–13:00"}[i] }</span></div>
							if i==1 || i==3 {
								<div class="scene-calendar-event scene-event-late"><strong class="md-typescale-label-large">Workshop</strong><span class="md-typescale-body-small">14:00–15:30</span></div>
							}
						</section>
					}
				</div>
			case "side-sheet":
				<p class="md-typescale-body-medium">Collection / Architecture / 6 photos</p>
				<div class="scene-photo-library">
					for i:=range 6 {
						<figure class={ templ.KV("scene-photo-selected", i == 0) }><img src={ staticURL("paintings/" + carouselPaintings[i]) } alt="Landscape in the photo library"/><figcaption class="md-typescale-label-medium">{ []string{"Harbour view.jpg","River study.jpg","Coastal cliffs.jpg","Green River.jpg","Lake view.jpg","Fishing boats.jpg"}[i] }</figcaption></figure>
					}
				</div>
				<aside class="scene-side-panel">
					@sheetSurface(c) {
						@ui.SheetHeader(ui.SheetProps{ID: c.ID(), Title: "Harbour view.jpg"})
						@ui.SheetBody() {
							<img class="scene-sheet-thumbnail" src={ staticURL("paintings/" + carouselPaintings[0]) } alt="Selected harbour view"/>
							<dl class="scene-metadata"><dt>Collection</dt><dd>Architecture</dd><dt>Added</dt><dd>21 October 2026</dd><dt>Dimensions</dt><dd>2400 × 1600</dd><dt>File size</dt><dd>3.8 MB · JPEG</dd><dt>Owner</dt><dd>Maya Chen</dd></dl>
						}
						@ui.SheetActions() {
							@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
								Download
							}
						}
					}
				</aside>
			case "slider":
				<div class="scene-edit-photo">
					@sceneArtwork(c.Family, "coast")
				</div>
				<div class="scene-adjustments">
					<div class="scene-inline-actions">
						<h2 class="md-typescale-title-large">Adjustments</h2>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
	Reset
}
					</div>
					for i,label:=range []string{"Exposure","Contrast","Saturation"} {
						<div>
							<div class="scene-inline-actions md-typescale-title-medium"><span>{ label }</span><span>40</span></div>@specimenSlider(c.sceneInstance(i))
						</div>
					}
				</div>
				<div class="scene-inline-actions">
					@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
						Cancel
					}
					@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
						Save a copy
					}
				</div>
			case "split":
				<div class="scene-email-composer">
					<div class="scene-compose-line">
						<span class="md-typescale-label-large">To</span>@specimenChip(componentCase{Family: "chip", Variant: "input", State: "enabled", illustrationLabels: [3]string{"Alex Morgan <alex@example.com>"}, instanceID: "scene-recipient"})
					</div>
					<div class="scene-compose-line"><span class="md-typescale-label-large">Subject</span><span class="md-typescale-body-large">Exhibition installation plan</span></div>
					<div class="scene-email-body md-typescale-body-large">
						<p>Hi Alex,</p>
						<p>I’ve attached the updated installation plan for next week. The artwork list is final, and the labels are ready for proofing.</p>
						<p>Could you confirm the team’s arrival time on Wednesday? We can start in gallery 2 while the lighting is being adjusted in gallery 1.</p>
						<p>Thanks,<br/>Maya</p>
						<div class="scene-attachment">
							@materialSymbol("description")
							<div><strong>Installation plan.pdf</strong><p class="md-typescale-body-small">2.4 MB</p></div>@sceneIcon("close", "Remove attachment")
						</div>
					</div>
					<div class="scene-compose-footer">
						@ui.SplitHost() {
							@splitSurface(c, "Send", "send")
							@ui.SplitMenu(c.ID(), "Sending options") {
								<li>
									@ui.MenuItem(templ.Attributes{"data-split-option": ""}, "Schedule send", nil, nil)
								</li>
								<li>
									@ui.MenuItem(templ.Attributes{"data-split-option": ""}, "Save as draft", nil, nil)
								</li>
							}
						}
						<div class="scene-inline-options">
							@sceneIcon("attach_file", "Attach file")
							@sceneIcon("image", "Insert image")
							@sceneIcon("link", "Insert link")
						</div>@sceneIcon("delete", "Discard draft")
					</div>
				</div>
			case "switch":
				<p class="md-typescale-body-large">Choose how you hear about activity in your account.</p>
				<div class="scene-switch-settings">
					for i,label:=range []string{"Push notifications","Direct messages","Mentions and replies","Weekly email summary","Product updates"} {
						<section>
							<div><h2 class="md-typescale-title-medium">{ label }</h2><p class="md-typescale-body-medium">{ []string{"Allow notifications on this device","When someone sends you a message","Activity in conversations you follow","A summary every Monday morning","New features and announcements"}[i] }</p></div>@switchChoice(c.sceneInstance(i).thumbnailSelected(i < 3), label)
						</section>
					}
				</div>
			case "tabs":
				<div { c.Attributes()... }>
					@tabsBar(c)
					@ui.TabPanel(c.ID()+"-panel-0", c.ID()+"-tab-0", !(false)) {
						@sceneDataRows([][4]string{{"shopping_bag", "Order #1048 · Maya Chen", "Coastal study · Processing", "€48.00"}, {"shopping_bag", "Order #1047 · Alex Morgan", "Landscape set · Ready to ship", "€96.00"}, {"shopping_bag", "Order #1046 · Robin Ellis", "River study · Processing", "€36.00"}, {"shopping_bag", "Order #1045 · Jamie Park", "Framed print · Awaiting payment", "€84.00"}, {"shopping_bag", "Order #1044 · Sam Rivera", "Exhibition poster · Packed", "€24.00"}, {"shopping_bag", "Order #1043 · Lea Wong", "Coastal study · Ready to ship", "€48.00"}, {"shopping_bag", "Order #1042 · Kim Anders", "Landscape set · Processing", "€96.00"}}, false)
					}
					for i,label:=range []string{"Completed orders","Cancelled orders"} {
						@ui.TabPanel(fmt.Sprintf("%s-panel-%d", c.ID(), i+1), fmt.Sprintf("%s-tab-%d", c.ID(), i+1), !(true)) {
							<p class="md-typescale-body-large">{ label }</p>
						}
					}
				</div>
			case "field":
				<div class="scene-address-form">
					<p class="md-typescale-body-large">Where should we send your order?</p>
					<div class="scene-form-grid">
						@sceneField("shipping-first", "First name", "Maya", "", false)
						@sceneField("shipping-last", "Last name", "Chen", "", false)
						<div class="scene-field-full">
							@sceneField("shipping-address", "Street address", "12 Riverside Road", "", false)
						</div>
						<div class="scene-field-full">
							@sceneField("shipping-unit", "Apartment, suite, etc. (optional)", "Apartment 4", "", false)
						</div>@sceneField("shipping-city", "City", "Stockholm", "", false)
						@sceneField("shipping-postal", "Postal code", "11", "Enter a five-digit postal code.", true)
						<div class="scene-field-full">
							@sceneField("shipping-country", "Country", "Sweden", "", false)
						</div>
						<div class="scene-field-full">
							@sceneField("shipping-phone", "Phone number", "+46 70 123 45 67", "For delivery updates only.", false)
						</div>
					</div>
					<div class="scene-inline-actions">
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
							Back to bag
						}
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
							Continue to delivery
						}
					</div>
				</div>
			case "toolbar":
				<header class="scene-drawing-header">
					<div class="scene-inline-options">
						@sceneIcon("arrow_back", "Back to drawings")
						<h1 class="md-typescale-title-medium">Harbour study</h1><span class="md-typescale-body-medium">Saved</span>
					</div>
					<div>
						@sceneIcon("undo", "Undo")
						@sceneIcon("redo", "Redo")
					</div>
				</header>
				<div class="scene-drawing-canvas">
					<div class="scene-drawing-paper">
						@sceneArtwork(c.Family, "coast")
					</div>
				</div>
				@useComponentAssets("toolbar")
				<div class="scene-drawing-tools">
					<div { sceneNamedAttributes(c,"Drawing tools")... } role="toolbar">
						for i,icon:=range []string{"edit","brush","ink_eraser","crop","palette"} {
							@ui.Button(templ.Attributes{"class": "md-icon-button md-toolbar-item", "data-size": "small", "aria-label": []string{"Pencil", "Brush", "Eraser", "Crop", "Color"}[i], "aria-pressed": fmt.Sprint(i == 1)}) {
								@materialSymbol(icon)
							}
						}
					</div>
				</div>
				<p class="scene-drawing-status md-typescale-body-small">Brush · 12 px · 100% opacity</p>
			case "tooltip":
				@sceneSpreadsheet(c)
		}
	</div>
}

templ sceneCreateButton(label, icon string, extended bool) {
	<div class="scene-fab-anchor">@ui.FAB(ui.FABProps{Label: label, Icon: icon, Extended: extended, Variant: "primary"})
</div>
}

templ sceneSearch(c componentCase) {
	@useComponentAssets("search")
	{{ search := componentCase{Family: "search", Variant: "docked", Control: "contained", Shape: "icon", Width: "clear", State: "enabled", instanceID: "scene-results-search"} }}
	<div class="scene-query">
		<div { search.Attributes()... }>
			<div { search.SearchPanel()... }>
				@searchBarValue(search, "Search the collection", "landscape")
			</div>
		</div>
	</div>
}

templ sceneFiles(family string) {
	<div class="scene-files">
		<div class="scene-file-columns md-typescale-label-large"><span>Name</span><span>Modified</span><span>Size</span></div>
		for i,name:=range []string{"Artwork references","Installation photos","Budget draft.xlsx","Exhibition guide.pdf","Gallery plan.png","Installation plan.pdf","Press release.docx","Visitor survey.pdf"} {
			<div class={ "scene-file-row",templ.KV("scene-file-row-selected",family=="dialog" && i==2) }>
				<div>
					@materialSymbol([]string{"folder", "folder", "table_chart", "description", "image", "description", "description", "description"}[i])
					<span class="md-typescale-body-large">{ name }</span>
				</div><span class="md-typescale-body-medium">{ []string{"Today, 9:12","Yesterday","Today, 8:45","28 Oct","28 Oct","27 Oct","26 Oct","25 Oct"}[i] }</span><span class="md-typescale-body-medium">{ []string{"12 items","24 items","128 KB","2.4 MB","860 KB","2.4 MB","240 KB","420 KB"}[i] }</span>
			</div>
		}
	</div>
}

templ sceneDocument(c componentCase) {
	@documentCommandBar(true)
	@documentPaper()
}

templ sceneSpreadsheet(c componentCase) {
	@useComponentAssets("messages")
	<header class="scene-sheet-app-header">
		<div><h1 class="md-typescale-title-large">Exhibition budget</h1><p class="md-typescale-body-small">Saved to My files · Edited today at 9:24</p></div>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("tonal"), Size: ui.Size("small")}) {
	Share
}
	</header>
	@sceneEditorMenus(true)
	@sceneEditorFormatting(true)
	<div class="scene-formula-bar md-typescale-body-medium"><span>B4</span><span>fx</span><span>Installation team</span></div>
	<table class="scene-spreadsheet md-typescale-body-large">
		<thead>
			<tr>
				<th></th>
				for _,col:=range []string{"A","B","C","D","E","F"} {
					<th scope="col">{ col }</th>
				}
			</tr>
		</thead>
		<tbody>
			<tr><th scope="row">1</th><td>Category</td><td>Item</td><td>Quantity</td><td>Unit cost</td><td>Total</td><td>Status</td></tr>
			for i,row:=range [][6]string{{"Print","Exhibition guides","200","€1.20","€240.00","Confirmed"},{"Print","Artwork labels","32","€2.50","€80.00","Confirmed"},{"Installation","Installation team","2","€320.00","€640.00","Booked"},{"Installation","Lighting adjustment","1","€180.00","€180.00","Booked"},{"Events","Opening refreshments","1","€240.00","€240.00","Estimated"},{"Events","Tour materials","40","€1.50","€60.00","Confirmed"},{"Publicity","Posters","50","€3.00","€150.00","In print"},{"Publicity","Invitations","100","€0.80","€80.00","Sent"},{"","Total","","","€1,670.00",""}} {
				<tr>
					<th scope="row">{ fmt.Sprint(i+2) }</th>
					for j,value:=range row {
						<td class={ templ.KV("scene-active-cell", i == 2 && j == 1) }>{ value }</td>
					}
				</tr>
			}
			for i:=range 5 {
				<tr>
					<th scope="row">{ fmt.Sprint(i+11) }</th>
					for range 6 {
						<td></td>
					}
				</tr>
			}
		</tbody>
	</table>
	<footer class="scene-spreadsheet-tabs">
		@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("tonal"), Size: ui.Size("small")}) {
			Budget
		}
		@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("text"), Size: ui.Size("small")}) {
			Suppliers
		}
		@sceneIcon("add", "Add sheet")
	</footer>
}

templ sceneFilter(label string, selected bool) {
	@ui.Chip(ui.ChipProps{Label: label, Variant: "filter", Selected: selected})
}

templ sceneEditorMenus(sheet bool) {
	<nav class="scene-editor-menus md-typescale-body-medium" aria-label="Application menus">
		for _,label:=range []string{"File","Edit","View","Insert","Format","Tools","Help"} {
			@ui.Button(templ.Attributes{"type": "button"}) {
				{ label }
			}
		}
	</nav>
}

templ sceneEditorFormatting(sheet bool) {
	<div class="scene-editor-formatting" role="toolbar" aria-label="Formatting">
		<div role="group" aria-label="History">
			@sceneIcon("undo", "Undo")
			@sceneIcon("redo", "Redo")
			@sceneIcon("print", "Print")
		</div>
		<span class="scene-tool-separator" aria-hidden="true"></span>
		<label class="scene-editor-select md-typescale-body-medium"><select aria-label="Zoom"><option>100%</option></select></label>
		<span class="scene-tool-separator" aria-hidden="true"></span>
		if !sheet {
			<label class="scene-editor-select md-typescale-body-medium"><select aria-label="Paragraph style"><option>Normal text</option></select></label>
		}
		<label class="scene-editor-select md-typescale-body-medium"><select aria-label="Font"><option>Arial</option></select></label>
		<div role="group" aria-label="Font size" class="scene-editor-size">
			@sceneIcon("remove", "Decrease font size")
			<input aria-label="Font size" value="11" inputmode="numeric"/>
			@sceneIcon("add", "Increase font size")
		</div>
		<span class="scene-tool-separator" aria-hidden="true"></span>
		<div role="group" aria-label="Text style">
			if sheet {
				<span class="scene-tooltip-target">
					@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Bold", Attrs: templ.Attributes{"aria-describedby": "scene-bold-tooltip"}, Size: ui.Size("small")}) {
						@materialSymbol("format_bold")
					}
					<span class="md-tooltip" data-variant="plain" role="tooltip" id="scene-bold-tooltip"><p>Bold (Ctrl+B)</p></span>
				</span>
			} else {
				@sceneIcon("format_bold", "Bold")
			}
			@sceneIcon("format_italic", "Italic")
			@sceneIcon("format_underlined", "Underline")
		</div>
		<span class="scene-tool-separator" aria-hidden="true"></span>
		<div role="group" aria-label="Paragraph alignment">
			@sceneIcon("format_align_left", "Align left")
			@sceneIcon("format_align_center", "Align centre")
			@sceneIcon("format_list_bulleted", "Bulleted list")
		</div>
		<span class="scene-editor-toolbar-spacer"></span>
		<label class="scene-editor-select md-typescale-body-medium"><select aria-label="Document mode"><option>Editing</option></select></label>
	</div>
}

templ sceneDeleteDialogActions(c componentCase) {
	@ui.Button(c.DialogAction(false)) {
		Cancel
	}
	@ui.Button(c.DialogAction(true)) {
		Move to Trash
	}
}

func sceneMessageDestination(bar componentCase, i int, label string) ui.NavigationItemProps {
	p := navigationExampleItem(bar, i, label, []string{"chat", "notifications", "call"}[i])
	p.Attrs["aria-label"] = label + []string{"", ", 12 unread notifications", ", 1 new notification"}[i]
	if i == 1 {
		p.Badge = "labeled"
		p.BadgeText = "12"
	}
	if i == 2 {
		p.Badge = "small"
	}
	return p
}

templ sceneSnackbarAction(c componentCase) {
	@ui.Button(c.FeedbackAttributes("md-button md-text-button md-feedback-action")) {
		Undo
	}
}

templ sceneMessageTail(i int) {
	<span class="scene-message-tail">
		<span>{ []string{"9:24","9:18","8:42","Yesterday","Yesterday","Tue","Tue","Mon"}[i] }</span>
		if i<3 {
			@ui.Badge("labeled", []string{"2", "5", "1"}[i], templ.Attributes{"aria-label": []string{"2 unread messages", "5 unread messages", "1 unread message"}[i]})
		}
	</span>
}
