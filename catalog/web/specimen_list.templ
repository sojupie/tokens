package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenList(c componentCase) {
	@playgroundList(c)
}

templ listContents(c componentCase, index int) {
	@listItemContents(c, index, listItemContent{Label: c.ListLabel(index), Supporting: c.ListSupporting(), Overline: "Overline", Avatar: "A", Metadata: "100+"})
}

templ listItemContents(c componentCase, index int, content listItemContent) {
	{{
		props := ui.ListItemProps{Label: content.Label, Supporting: content.Supporting, Avatar: content.Avatar, LeadingKind: ui.ListLeading(c.Width), SingleLine: c.Size == "one-line"}
		if c.ListText == "overline" {
			props.Overline = content.Overline
		}
		if c.ListTrailing == "" || c.ListTrailing == "text" {
			props.Metadata = content.Metadata
		}
		if content.Badge != "" {
			props.Badge = ui.Badge("small", "", nil)
		}
		props.ImageSrc = staticURL("paintings/" + listContentImage(content.Image, index))
		if c.Width != "avatar" && c.Width != "image" {
			props.Leading = listLeadingContent(c, index, content)
		}
		if c.ListTrailing == "checkbox" || c.ListTrailing == "radio" || c.ListTrailing == "switch" || c.ListTrailing == "icon" || (c.Control == "expand" && index < 3) {
			props.Trailing = listTrailingContent(c, index)
		}
	}}
	@ui.ListContent(props)
}

templ listLeadingContent(c componentCase, index int, content listItemContent) {
	switch c.Width {
		case "checkbox","radio":
			@listSelectionControl(c, index)
		case "icon":
			@ui.Icon(listContentIcon(content.Icon))
		case "video":
			<svg viewBox="0 0 100 56" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="100" height="56" fill="var(--md-sys-color-tertiary-container)"></rect><path d="m42 16 20 12-20 12Z" fill="var(--md-sys-color-on-tertiary-container)"></path></svg>
	}
}

templ listTrailingContent(c componentCase, index int) {
	if c.ListTrailing=="checkbox"||c.ListTrailing=="radio"||c.ListTrailing=="switch" {
		@listSelectionControl(c, index)
	}
	if c.Control=="expand"&&index<3 {
		@ui.ListIcon("expand_more", true)
	} else if c.ListTrailing=="icon" {
		@ui.ListIcon("chevron_right", false)
	}
}

// Reuse the checkbox, radio and switch renderers without nesting an input in a button.
templ listSelectionControl(c componentCase, index int) {
	{{ p := ui.ChoiceProps{Attrs: c.ListControlAttributes(index), InputAttrs: c.ListControlInput(index)} }}
	switch c.ListNativeKind() {
		case "radio":
			@ui.RadioControl(p)
		case "checkbox":
			@ui.CheckboxControl(p)
		case "switch":
			@ui.SwitchControl(p)
	}
}

templ listExampleBefore(c componentCase, index int) {
	if c.Control=="reveal" {
		@ui.Button(c.ListUtility(index, true)) {
			@ui.Icon("check")
		}
	}
}

templ listExampleAfter(c componentCase, index int) {
	if c.Control=="reorder" {
		@ui.Button(c.ListUtility(index, false)) {
			@ui.Icon("drag_handle")
		}
	}
	if c.Control=="reveal" {
		@ui.Button(c.ListUtility(index, false)) {
			@ui.Icon("more_horiz")
		}
	}
}

func listExampleExpanded(c componentCase, index int) templ.Component {
	if c.Control == "expand" {
		return listExampleChildren(c, index)
	}
	return nil
}

templ listExampleChildren(c componentCase, index int) {
	for child:=3;child<5;child++ {
		<li>
			@ui.Button(c.ListItem(child)) {
				@listContents(c, child)
			}
		</li>
	}
}
