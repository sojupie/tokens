package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ specimenList(c componentCase) {
	@useComponentAssets("list")
	<div class={ "md-list-demo", templ.KV("md-sheet-demo",c.Control=="reorder") } data-interactive="true">
		<ul { c.ListContainerAttributes()... }>
			for index := range 3 {
				<li role={ c.ListRowRole() } data-list-row data-list-label={ c.ListLabel(index) } data-list-expanded={ fmt.Sprint(c.Control == "expand" && c.Expanded && index == 0) }>
					<div class="md-list-row">
						if c.Control=="reveal" {
							<button { c.ListUtility(index,true)... }>@materialSymbol("check")
</button>
						}
						if c.ListNativeKind()!="" {
							<div { c.ListItem(index)... }>@listContents(c, index)
</div>
						} else {
							<button { c.ListItem(index)... }>@listContents(c, index)
</button>
						}
						if c.Control=="reorder" {
							<button { c.ListUtility(index,false)... }>@materialSymbol("drag_handle")
</button>
						}
						if c.Control=="reveal" {
							<button { c.ListUtility(index,false)... }>@materialSymbol("more_horiz")
</button>
						}
					</div>
					if c.Control=="expand" {
						<ul class="md-list-expand-content" aria-label={ c.ListLabel(index) + " items" } id={ fmt.Sprintf("%s-children-%d", c.ID(), index) } hidden?={ !(c.Expanded&&index==0) }>
							<li><button { c.ListItem(3)... }>@listContents(c, 3)
</button></li>
							<li><button { c.ListItem(4)... }>@listContents(c, 4)
</button></li>
						</ul>
					}
				</li>
			}
		</ul>
		if c.Control=="reorder" {
			@useComponentAssets("sheet")
			<dialog class="md-sheet md-bottom-sheet md-list-reorder-sheet" data-control="standard" data-variant="expanded" data-list-reorder-sheet id={ c.ID() + "-reorder" } aria-label="Reorder item" tabindex="-1">
				<div class="md-sheet-content">
					<div class="md-sheet-body">
						<div class="md-list" data-variant="standard" data-size="one-line" data-shape="baseline" data-width="icon">
							<button { c.ListMoveAction(0,"up")... }><span class="md-list-leading md-list-icon">@materialSymbol("arrow_upward")
</span><span class="md-list-body"><span class="md-list-label">Move up</span></span></button>
							<button { c.ListMoveAction(0,"down")... }><span class="md-list-leading md-list-icon">@materialSymbol("arrow_downward")
</span><span class="md-list-body"><span class="md-list-label">Move down</span></span></button>
						</div>
					</div>
					<output class="tokens-visually-hidden" data-list-move-status aria-live="polite"></output>
				</div>
			</dialog>
		}
		<output class="md-typescale-body-small" aria-live="polite"></output>
	</div>
}

templ listContents(c componentCase, index int) {
	@listItemContents(c, index, listItemContent{Label: c.ListLabel(index), Supporting: c.ListSupporting(), Overline: "Overline", Avatar: "A", Metadata: "100+"})
}

templ listItemContents(c componentCase, index int, content listItemContent) {
 {{ props:=ui.ListItemProps{Label:content.Label,Supporting:content.Supporting,Avatar:content.Avatar,LeadingKind:ui.ListLeading(c.Width),SingleLine:c.Size=="one-line"};if c.ListText=="overline" {props.Overline=content.Overline};if c.ListTrailing==""||c.ListTrailing=="text" {props.Metadata=content.Metadata};if content.Badge!="" {props.Badge=ui.Badge("small","",nil)};props.ImageSrc=staticURL("paintings/"+listContentImage(content.Image,index));if c.Width!="avatar"&&c.Width!="image" {props.Leading=listLeadingContent(c,index,content)};if c.ListTrailing=="checkbox"||c.ListTrailing=="radio"||c.ListTrailing=="switch"||c.ListTrailing=="icon"||(c.Control=="expand"&&index<3) {props.Trailing=listTrailingContent(c,index)} }}
 @ui.ListContent(props)
}

templ listLeadingContent(c componentCase,index int,content listItemContent) {
 switch c.Width {
 case "checkbox","radio":
 @listSelectionControl(c,index)
 case "icon":
 @ui.Icon(listContentIcon(content.Icon))
 case "video":
 <svg viewBox="0 0 100 56" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="100" height="56" fill="var(--md-sys-color-tertiary-container)"></rect><path d="m42 16 20 12-20 12Z" fill="var(--md-sys-color-on-tertiary-container)"></path></svg>
 }
}

templ listTrailingContent(c componentCase,index int) {
 if c.ListTrailing=="checkbox"||c.ListTrailing=="radio"||c.ListTrailing=="switch" {
 @listSelectionControl(c,index)
 }
 if c.Control=="expand"&&index<3 {
 <span class="md-list-expand-icon">@ui.Icon("expand_more")</span>
 } else if c.ListTrailing=="icon" {
 <span class="md-list-trailing-icon">@ui.Icon("chevron_right")</span>
 }
}

// Reuse the checkbox, radio and switch renderers without nesting an input in a button.
templ listSelectionControl(c componentCase, index int) {
 {{ p:=ui.ChoiceProps{Attrs:c.ListControlAttributes(index),InputAttrs:c.ListControlInput(index)} }}
 switch c.ListNativeKind() {
 case "radio":
 @ui.RadioControl(p)
 case "checkbox":
 @ui.CheckboxControl(p)
 case "switch":
 @ui.SwitchControl(p)
 }
}
