package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenBadge(c componentCase) {
	@useComponentAssets("badge")
	@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: c.BadgeLabel(), Attrs: templ.Attributes{"type": "button", "class": "tokens-badge-example", "data-badge-placement": c.BadgePlacement, "dir": c.BadgeDirection}, Size: ui.Size("small")}) {
		@ui.BadgeAnchor() {
			@materialSymbol("notifications")
			if c.BadgePlacement!="trailing" {
				@ui.Badge(c.Variant, c.BadgeText(), nil)
			}
		}
		if c.BadgePlacement=="trailing" {
			<span>Notifications</span>
			@ui.Badge(c.Variant, c.BadgeText(), nil)
		}
	}
}
