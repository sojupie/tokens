package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenSnackbar(c componentCase) {
	if c.State=="interactive" {
		<div data-snackbar-demo>
			@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: templ.Attributes{"data-snackbar-open": true, "aria-describedby": c.ID() + "-shortcut"}}) {
				Show snackbar
			}
			@ui.SnackbarMessage(ui.SnackbarProps{Variant: c.Variant, Attrs: c.Attributes(), Duration: 6000, Action: snackbarExampleActions(c)}) {
				@snackbarExampleText(c)
			}
			<p class="md-typescale-body-small" id={ c.ID() + "-shortcut" }>Press F6 to focus the snackbar action.</p>
			<output class="md-typescale-body-small" aria-live="polite"></output>
		</div>
	} else {
		@ui.SnackbarMessage(ui.SnackbarProps{Variant: c.Variant, Attrs: c.Attributes(), Inline: true, Action: snackbarExampleActions(c)}) {
			@snackbarExampleText(c)
		}
	}
}

templ snackbarContents(c componentCase) {
	@ui.FeedbackText() {
		@snackbarExampleText(c)
	}
	@snackbarExampleActions(c)
}

templ snackbarExampleText(c componentCase) {
	if c.Variant=="two-lines" {
		<span>Message sent.</span>
		<br/>
		<span>You can undo this action.</span>
	} else {
		Message sent
	}
}

templ snackbarExampleActions(c componentCase) {
	@ui.Button(templ.Attributes{"data-snackbar-action": true}, c.FeedbackAttributes("md-button md-text-button md-feedback-action")) {
		Undo
	}
}
