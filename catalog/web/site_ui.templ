package web

import "github.com/sojupie/tokens/forge/components/ui"

templ catalogSelect(id, name, label, selected string, choices []catalogChoice) {
	@ui.SelectField(ui.SelectProps{ID: id, Name: name, Label: label, Value: selected, Options: catalogOptions(choices), Outlined: true, Attrs: templ.Attributes{"class": "tokens-catalog-select"}, MenuAttrs: templ.Attributes{"class": "tokens-catalog-menu"}})
}

templ filterPill(id, name, label, selected string, choices []catalogChoice, showLabel bool) {
	@ui.SelectField(ui.SelectProps{ID: id, Name: name, Label: label, Value: selected, Options: catalogOptions(choices), HideLabel: !showLabel, Attrs: templ.Attributes{"class": "tokens-preview-filter"}, MenuAttrs: templ.Attributes{"class": "tokens-catalog-menu"}})
}

templ previewFilter(control previewControl) {
	@filterPill("preview-"+control.Name, "preview."+control.Name, control.Label, control.Selected, previewChoices(control), true)
}
