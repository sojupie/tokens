package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ specimenNavRail(c componentCase) {
	@playgroundNavRail(c)
}

templ specimenNavBar(c componentCase) {
	if c.State=="interactive" && c.Variant=="modal" {
		<div data-navigation-demo>
			@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: templ.Attributes{"data-navigation-open": true, "aria-haspopup": "dialog", "aria-controls": c.ID() + "-modal"}}) {
				Open navigation
			}
			@ui.NavigationSurface(navigationExampleAttrs(c, true), true) {
				@navigationContents(c)
			}
		</div>
	} else if c.Family=="nav-bar" {
		<div class="tokens-navbar-preview" data-navbar-demo style={ c.NavBarPreviewStyle() }>
			if c.State=="interactive" {
				<section class="tokens-navbar-screen" id={ c.ID() + "-screen" } aria-label="Destination content">
					for i,label:=range c.NavigationLabels() {
						<div data-navbar-page={ label } tabindex="0" hidden?={ c.NavigationItem(i)["aria-current"]!="page" }>
							<h3 class="md-typescale-title-large">{ label }</h3>
							<p class="md-typescale-body-medium">{ map[string]string{"Home":"Recently opened documents","Files":"Documents in your workspace","Saved":"Items you saved for later","Recent":"Your latest activity","Settings":"Workspace preferences"}[label] }</p>
							<ul class="md-typescale-body-medium">
								for _,item:=range navBarPageItems(label) {
									<li>{ item }</li>
								}
							</ul>
						</div>
					}
				</section>
			}
			@ui.NavigationSurface(navigationExampleAttrs(c, false), false) {
				@navigationContents(c)
			}
		</div>
	} else {
		@ui.NavigationSurface(navigationExampleAttrs(c, false), false) {
			@navigationContents(c)
		}
	}
}

templ navigationDestinations(c componentCase, labels []string) {
	@useComponentAssets("navigation")
	if c.Family=="nav-rail" && (c.RailMenu()||c.RailFAB()) {
		<header>
			if c.RailMenu() {
				@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: c.NavigationToggleLabel(), Attrs: templ.Attributes{"class": "md-rail-menu", "type": "button", "data-width": "default", "data-navigation-expand": true, "aria-expanded": fmt.Sprint(c.Variant == "expanded")}, Size: ui.Size("small"), Shape: ui.ButtonShape("round")}) {
					<span data-navigation-menu-icon>
						@materialSymbol("menu")
					</span>
					<span data-navigation-collapse-icon>
						@materialSymbol("menu_open")
					</span>
				}
			}
			if c.RailFAB() {
				@useComponentAssets("fab")
				@ui.Button(c.NavigationFAB()) {
					@materialSymbol("edit")
					<span>Create</span>
				}
			}
		</header>
	}
	if c.Family=="nav-drawer" {
		<h3>Library</h3>
	}
	@ui.NavigationItems() {
		for i,label:=range labels {
			if i==4 && c.Family=="nav-drawer" {
				@ui.Divider("full", nil)
				<h3>Workspace</h3>
			}
			if i==4 && c.Family=="nav-rail" {
				<h3 class="md-nav-section">Library</h3>
			}
			@ui.NavigationItem(navigationExampleItem(c, i, label, c.NavigationIcon(i)))
		}
	}
	<output class="tokens-visually-hidden" id={ c.ID() + "-selection" } aria-live="polite"></output>
}

templ navigationItemContents(c componentCase, i int, label, icon string) {
	@ui.NavigationItemContent(navigationExampleItem(c, i, label, icon))
}

templ navigationContents(c componentCase) {
	@navigationDestinations(c, c.NavigationLabels())
}

func navigationExampleAttrs(c componentCase, modal bool) templ.Attributes {
	a := c.Attributes()
	a["aria-label"] = "Navigation preview"
	if modal {
		a["id"] = c.ID() + "-modal"
		a["data-navigation-modal"] = ""
	}
	return a
}

templ navigationExampleSurface(c componentCase) {
	@ui.NavigationSurface(navigationExampleAttrs(c, false), false) {
		@navigationContents(c)
	}
}

func navigationExampleItem(c componentCase, i int, label, icon string) ui.NavigationItemProps {
	p := ui.NavigationItemProps{Label: label, Icon: icon, Attrs: c.NavigationItem(i), Secondary: c.Family == "nav-rail" && c.NavSecondary == "expanded-only" && i >= 4}
	if c.NavigationHasBadge(i) {
		p.Badge = c.NavBadge
		p.BadgeText = "3"
		p.BadgeLabel = c.NavigationBadgeLabel()
	}
	if c.Family == "nav-drawer" {
		p.Count = fmt.Sprint(i + 1)
	}
	return p
}
