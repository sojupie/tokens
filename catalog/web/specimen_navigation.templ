package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ specimenNavRail(c componentCase) {
	<div { c.RailFrame()... }>
		<div class="md-navigation-slot">
			<div class="md-navigation-surface">
				<nav { c.Attributes()... } aria-label="Primary navigation">
					@navigationContents(c)
				</nav>
			</div>
		</div>
		<button class="md-navigation-scrim" type="button" tabindex="-1" data-navigation-dismiss aria-label="Collapse navigation" hidden></button>
		<div class="md-rail-body">
			<header>
				<button class="md-icon-button md-standard-icon-button md-rail-external-menu" type="button" data-size="small" data-shape="round" data-width="default" data-navigation-expand aria-label="Expand navigation" aria-expanded="false">
					@materialSymbol("menu")
				</button><span>Workspace</span>
			</header>
			<section class="md-rail-screen" id={ c.ID() + "-screen" }>
				<h3 data-navigation-title tabindex="-1">
					if c.Selected {
						Home
					} else {
						Files
					}
				</h3>
				<p data-navigation-description>Documents and collections in your workspace.</p>
				for _, label := range []string{"Project notes","Weekend plans","Reading list","Ideas","References","Shared documents","Drafts","Resources","Planning","Archive"} {
					<article>
						<span>
							@materialSymbol("folder")
						</span>
						<div><strong>{ label }</strong><p>Updated recently</p></div>
					</article>
				}
			</section>
		</div>
	</div>
}

templ specimenNavBar(c componentCase) {
	if c.State=="interactive" && c.Variant=="modal" {
		<div data-navigation-demo>
			<button type="button" class="md-button md-outlined-button" data-navigation-open aria-haspopup="dialog" aria-controls={ c.ID() + "-modal" }>Open navigation</button>
			<dialog { c.Attributes()... } id={ c.ID() + "-modal" } data-navigation-modal aria-label="Navigation preview">
				@navigationContents(c)
			</dialog>
		</div>
	} else if c.Family=="nav-bar" {
		<div class="tokens-navbar-preview" data-navbar-demo style={ c.NavBarPreviewStyle() }>
			if c.State=="interactive" {
				<section class="tokens-navbar-screen" id={ c.ID() + "-screen" } aria-label="Destination content">
					for i,label:=range c.NavigationLabels() {
						<div data-navbar-page={ label } tabindex="0" hidden?={ c.NavigationItem(i)["aria-current"]!="page" }>
							<h3 class="md-typescale-title-large">{ label }</h3>
							<p class="md-typescale-body-medium">{ map[string]string{"Home":"Recently opened documents","Files":"Documents in your workspace","Saved":"Items you saved for later","Recent":"Your latest activity","Settings":"Workspace preferences"}[label] }</p>
							<ul class="md-typescale-body-medium">
								for _,item:=range navBarPageItems(label) {
									<li>{ item }</li>
								}
							</ul>
						</div>
					}
				</section>
			}
			<nav { c.Attributes()... } aria-label="Navigation preview">@navigationContents(c)
</nav>
		</div>
	} else {
		<nav { c.Attributes()... } aria-label="Navigation preview">@navigationContents(c)
</nav>
	}
}

templ navigationDestinations(c componentCase, labels []string) {
	@useComponentAssets("navigation")
	if c.Family=="nav-rail" && (c.RailMenu()||c.RailFAB()) {
		<header>
			if c.RailMenu() {
				<button class="md-icon-button md-standard-icon-button md-rail-menu" type="button" data-size="small" data-shape="round" data-width="default" data-navigation-expand aria-label={ c.NavigationToggleLabel() } aria-expanded={ fmt.Sprint(c.Variant == "expanded") }>
					<span data-navigation-menu-icon>
						@materialSymbol("menu")
					</span>
					<span data-navigation-collapse-icon>
						@materialSymbol("menu_open")
					</span>
				</button>
			}
			if c.RailFAB() {
				@useComponentAssets("fab")
				<button { c.NavigationFAB()... }>
					@materialSymbol("edit")
					<span>Create</span>
				</button>
			}
		</header>
	}
	if c.Family=="nav-drawer" {
		<h3>Library</h3>
	}
	<div class="md-nav-items">
		for i,label:=range labels {
			if i==4 && c.Family=="nav-drawer" {
				<hr/>
				<h3>Workspace</h3>
			}
			if i==4 && c.Family=="nav-rail" {
				<h3 class="md-nav-section">Library</h3>
			}
			<button { c.NavigationItem(i)... } data-navigation-secondary?={ c.Family=="nav-rail"&&i>=4 }>
				@navigationItemContents(c, i, label, c.NavigationIcon(i))
			</button>
		}
	</div>
	<output class="tokens-visually-hidden" id={ c.ID() + "-selection" } aria-live="polite"></output>
}

templ navigationItemContents(c componentCase,i int,label,icon string){
 {{ p:=ui.NavigationItemProps{Label:label,Icon:icon};if c.NavigationHasBadge(i){p.Badge=c.NavBadge;p.BadgeText="3";p.BadgeLabel=c.NavigationBadgeLabel()};if c.Family=="nav-drawer"{p.Count=fmt.Sprint(i+1)} }}
 @ui.NavigationItemContent(p)
}

templ navigationContents(c componentCase) {
	@navigationDestinations(c, c.NavigationLabels())
}
