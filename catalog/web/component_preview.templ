package web

import "github.com/sojupie/tokens/forge/components/ui"

templ componentPreviewView(page componentPreview) {
	<section class="tokens-section" data-playground-environment id="component-preview" data-component-assets aria-labelledby="preview-heading">
		@componentAssetScope() {
			<h2 class="md-typescale-title-medium" id="preview-heading">Playground</h2>
			<form hx-boost="false" method="get" action={ page.Action } hx-get={ page.Action } hx-target="#component-preview" hx-select="#component-preview" hx-swap="outerHTML" hx-replace-url="true" hx-trigger="change" hx-sync="this:replace" class="tokens-gallery-filters">
				for _, hidden := range page.Hidden {
					<input type="hidden" name={ hidden.Name } value={ hidden.Value }/>
				}
				for _, control := range page.Controls {
					@previewSelect(control)
				}
				<noscript>
					@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Type: "submit"}) {
						Apply
					}
				</noscript>
			</form>
			if len(page.Cases) > 0 && page.Cases[0].Family == "slider" {
				<p class="md-typescale-body-small">Inset icons apply to standard single sliders in medium, large, and extra-large sizes. “On interaction” shows the value when a handle is hovered, focused, or pressed.</p>
			}
			if page.HasFullScreenCarousel() {
				<p class="md-typescale-body-small">Portrait full-screen frames apply below 840px. Larger frames stay landscape.</p>
			}
			<div class="tokens-preview-grid" data-playground-specimens>
				for _, c := range page.Cases {
					<figure class="tokens-component-example">
						<figcaption class="md-typescale-body-small">{ page.Caption(c) }</figcaption>
						@componentSpecimen(c)
					</figure>
				}
			</div>
			if len(page.Cases) == 0 {
				<p>This combination is not implemented in the playground.</p>
			}
		}
	</section>
}

templ previewSelect(control previewControl) {
	@previewFilter(control)
}
