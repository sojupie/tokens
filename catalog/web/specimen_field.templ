package web
import "github.com/sojupie/tokens/forge/components/ui"
templ specimenField(c componentCase){
 {{ p:=ui.FieldProps{TextFieldProps:ui.TextFieldProps{ID:c.ID(),Label:c.FieldLabel(),Supporting:c.FieldSupporting(),Filled:c.Variant=="filled",Invalid:c.Invalid,Disabled:c.State=="disabled",Attrs:c.Attributes(),InputAttrs:c.FieldInput()},Kind:map[bool]string{true:"text",false:c.Family}[c.Family=="field"],MenuIcons:c.Shape=="icons",HelpAttrs:c.FieldHelpAttributes()};if c.Shape=="affixes"{p.Prefix="$";p.Suffix="/kg";p.PrefixDescription="US dollars";p.SuffixDescription="per kilogram"};for _,value:=range fieldOptions{p.Options=append(p.Options,ui.Option{Value:value,Label:value})};if c.Width=="populated"{p.Value="Input text";if c.Family!="field"{p.Value=fieldOptions[1]}} }}
 @ui.Field(p)
}
templ outlinedFieldFrame(label string){ @ui.FieldOutline(label) }
