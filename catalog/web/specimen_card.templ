package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenCard(c componentCase) {
 @ui.CardButton(ui.CardProps{Variant:c.Variant,Headline:"The Turmoil of Conflict",Supporting:"Joan of Arc series, IV · Louis Maurice Boutet de Monvel",ImageSrc:staticURL("paintings/"+cardPainting),ImageAlt:"Joan of Arc riding among mounted knights in battle",Attrs:c.Attributes()})
}
