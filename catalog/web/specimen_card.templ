package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenCard(c componentCase) {
 @ui.CardButton(ui.CardProps{Variant:c.Variant,Headline:"The Turmoil of Conflict",ImageSrc:staticURL("paintings/"+cardPainting),ImageAlt:"Joan of Arc riding among mounted knights in battle",Attrs:c.Attributes()}) {
  <span class="md-card-supporting-text">Joan of Arc series, IV<br/>Louis Maurice Boutet de Monvel</span>
 }
}
