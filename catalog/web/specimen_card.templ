package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenCard(c componentCase) {
 @ui.CardButton(ui.CardProps{Variant:c.Variant,Headline:"Along the coast",Supporting:"Discover a route along the shoreline, starting at the old harbour.",ImageSrc:staticURL("paintings/"+cardPainting),ImageAlt:"A landscape along the coast",Attrs:c.Attributes()})
}
