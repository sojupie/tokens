package render

import webassets "github.com/sojupie/tokens/catalog/web/assets"

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

templ SpecimenCard(c webview.ComponentCase) {
 @ui.CardButton(ui.CardProps{Variant:c.Variant,Headline:"Blue Morning",ImageSrc:webassets.StaticURL("paintings/"+webview.CardPainting),ImageAlt:"Workers beside the East River in blue morning light",Attrs:c.Attributes()}) {
  <span class="md-card-supporting-text">1909<br/>George Bellows</span>
 }
}
