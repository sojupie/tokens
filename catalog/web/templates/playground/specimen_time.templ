package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

templ PickerFieldDimensions(page webview.ComponentPreview) {
	@PlaygroundSliderGrid() {
		if page.Cases[0].Family == "scroll-field" {
			@PreviewDimension("height", "Field height", 140, 360, 1)
			@PreviewDimension("gap", "Option spacing", 0, 32, 1)
		} else {
			if page.HasExpressiveTimeFields() {
				@PreviewDimension("height", "Field height", 140, 360, 4)
			}
			if page.HasTimeScroll() {
				@PreviewDimension("gap", "Option spacing", 0, 32, 1)
			}
		}
	}
}

templ SpecimenTime(c webview.ComponentCase) {
	{{ p:=c.TimePickerProps(); p.Attrs=c.Attributes(); p.Name="time" }}
	if p.IsInline() {
		@PreviewWidthScene("tokens-time-preview") {
			<div class="tokens-picker-height-guide">
				@ui.TimePicker(p)
			</div>
		}
	} else {
		@ui.TimePicker(p)
	}
}

// Time picker anatomy; the host owns its opener and surrounding application.
templ TimePickerPanel(c webview.ComponentCase) {
	@ui.TimePickerPanel(c.TimePickerProps())
}

templ SpecimenScrollField(c webview.ComponentCase) {
	{{ primary := c.ScrollFieldProps(); secondary := c.ScrollFieldSecondary() }}
	@PreviewWidthScene("tokens-scroll-preview") {
		if primary.DirectEntry {
			<div class="tokens-scroll-field-actions">
				if c.ScrollScene == "room" {
					@ui.ScrollFieldModeButton([]string{primary.ID, secondary.ID}, primary.TextEntryOpen(), ui.IconButtonProps{Disabled: primary.Disabled})
				} else {
					@ui.ScrollFieldModeButton([]string{primary.ID}, primary.TextEntryOpen(), ui.IconButtonProps{Disabled: primary.Disabled})
				}
			</div>
		}
		<div class="tokens-scroll-field-specimen tokens-picker-height-guide" role="group" aria-label="Scroll field preview">
			<div>@ui.ScrollField(primary)</div>
			if c.ScrollScene == "room" {
				<div>@ui.ScrollField(secondary)</div>
			}
		</div>
	}
}
