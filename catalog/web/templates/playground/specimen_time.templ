package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

templ SpecimenTime(c webview.ComponentCase) {
	{{ p:=c.TimePickerProps(); p.Attrs=c.Attributes(); p.Name="time" }}
	@ui.TimePicker(p)
}

// Time picker anatomy; the host owns its opener and surrounding application.
templ TimePickerPanel(c webview.ComponentCase) {
	@ui.TimePickerPanel(c.TimePickerProps())
}
