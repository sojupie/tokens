package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

templ SpecimenButton(c webview.ComponentCase) {
	@ui.Action(ui.ButtonProps{Variant:ui.ButtonVariant(c.Variant),Size:ui.Size(c.Size),Shape:ui.ButtonShape(c.Shape),Color:ui.ColorFamily(c.Color),Disabled:c.State=="disabled",Attrs:c.Attributes()}) {
		@webview.MaterialSymbol("check")
		<span>Button</span>
	}
}
