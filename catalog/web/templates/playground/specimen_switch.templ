package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

templ SpecimenSwitch(c webview.ComponentCase) {
	@SwitchChoice(c, "Allow notifications")
}

templ SwitchChoice(c webview.ComponentCase, label string) {
	@webview.UseComponentAssets("switch")
	@SelectionExample(c.ID(), label) {
@SwitchSurface(c,label,c.ID()+"-label")
	}
}

templ SwitchSurface(c webview.ComponentCase,label string,labelID ...string) {
 {{ props:=ui.ChoiceProps{ID:c.ID()+"-input",Label:label,Checked:c.Selected,Disabled:c.State=="disabled",Invalid:c.Invalid,Indeterminate:c.Variant=="indeterminate",Attrs:c.Attributes()};if len(labelID)>0 {props.LabelledBy=labelID[0]} }}
 @ui.SwitchControl(props)
}
