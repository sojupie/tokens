package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ SpecimenNavRail(c webview.ComponentCase) {
	@PlaygroundNavRail(c)
}

templ SpecimenNavBar(c webview.ComponentCase) {
	if c.State=="interactive" && c.Variant=="modal" {
		<div data-navigation-demo>
			@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: templ.Attributes{"data-navigation-open": true, "aria-haspopup": "dialog", "aria-controls": c.ID() + "-modal"}}) {
				Open navigation
			}
			@ui.NavigationSurface(NavigationExampleAttrs(c, true), true) {
				@NavigationContents(c)
			}
		</div>
	} else if c.Family=="nav-bar" {
		<div class="tokens-navbar-preview" data-navbar-demo style={ c.NavBarPreviewStyle() }>
			if c.State=="interactive" {
				<section class="tokens-navbar-screen" id={ c.ID() + "-screen" } aria-label="Destination content">
					for i,label:=range c.NavigationLabels() {
						<div data-navbar-page={ label } tabindex="0" hidden?={ c.NavigationItem(i)["aria-current"]!="page" }>
							<h3 class="md-typescale-title-large">{ label }</h3>
							<p class="md-typescale-body-medium">{ map[string]string{"Home":"Recently opened documents","Files":"Documents in your workspace","Saved":"Items you saved for later","Recent":"Your latest activity","Settings":"Workspace preferences"}[label] }</p>
							<ul class="md-typescale-body-medium">
								for _,item:=range webview.NavBarPageItems(label) {
									<li>{ item }</li>
								}
							</ul>
						</div>
					}
				</section>
			}
			@ui.NavigationSurface(NavigationExampleAttrs(c, false), false) {
				@NavigationContents(c)
			}
		</div>
	} else {
		@ui.NavigationSurface(NavigationExampleAttrs(c, false), false) {
			@NavigationContents(c)
		}
	}
}

templ NavigationDestinations(c webview.ComponentCase, labels []string) {
	@webview.UseComponentAssets("navigation")

	if c.Family=="nav-drawer" {
		<h3>Library</h3>
	}
	@ui.NavigationItems() {
		@NavigationDestinationItems(c, labels)
	}
	<output class="tokens-visually-hidden" id={ c.ID() + "-selection" } aria-live="polite"></output>
}

templ NavigationItemContents(c webview.ComponentCase, i int, label, icon string) {
	@ui.NavigationItemContent(NavigationExampleItem(c, i, label, icon))
}

templ NavigationContents(c webview.ComponentCase) {
	@NavigationDestinations(c, c.NavigationLabels())
}

func NavigationExampleAttrs(c webview.ComponentCase, modal bool) templ.Attributes {
	a := c.Attributes()
	a["aria-label"] = "Navigation preview"
	if modal {
		a["id"] = c.ID() + "-modal"
		a["data-navigation-modal"] = ""
	}
	return a
}

templ NavigationExampleSurface(c webview.ComponentCase) {
 if c.Family == "nav-rail" {
  @NavigationRailSurface(c,c.NavigationLabels())
 } else {
  @ui.NavigationSurface(NavigationExampleAttrs(c,false),false) { @NavigationContents(c) }
 }
}

func NavigationExampleItem(c webview.ComponentCase, i int, label, icon string) ui.NavigationItemProps {
	p := ui.NavigationItemProps{Label: label, Icon: icon, Attrs: c.NavigationItem(i), Secondary: c.Family == "nav-rail" && i >= 4}
	if c.NavigationHasBadge(i) {
		p.Badge = c.NavBadge
		p.BadgeText = "3"
		p.BadgeLabel = c.NavigationBadgeLabel()
	}
	if c.Family == "nav-drawer" {
		p.Count = fmt.Sprint(i + 1)
	}
	return p
}

// Immersive navigation keeps the same control mounted above the moving panes.
templ PersistentRailToggle(c webview.ComponentCase) {
	if c.NavCollapse == "hidden" {
		@ui.RailToggle(c.Variant == "expanded", templ.Attributes{"class":"md-rail-toggle"})
	}
}


templ NavigationDestinationItems(c webview.ComponentCase, labels []string) {
		for i,label:=range labels {
			if i==4 && c.Family=="nav-drawer" {
				@ui.Divider("full", nil)
				<h3>Workspace</h3>
			}
			if i==4 && c.Family=="nav-rail" {
				<h3 class="md-nav-section">Library</h3>
			}
			@ui.NavigationItem(NavigationExampleItem(c, i, label, c.NavigationIcon(i)))
		}
}

templ NavigationRailSurface(c webview.ComponentCase, labels []string) {
 @ui.NavigationRail(c.RailProps()) { @NavigationDestinationItems(c, labels) }
 <output class="tokens-visually-hidden" id={ c.ID() + "-selection" } aria-live="polite"></output>
}
