package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

import (
	"github.com/sojupie/tokens/source/publish"
	"strconv"
	"strings"
)

func changeSummaryAttrs(snapshot string, group webview.ChangeGroup) templ.Attributes {
	attrs := templ.Attributes{
		"class":                "md-card md-outlined-card tokens-change-summary",
		"data-change-summary":  "",
		"data-change-subject":  group.Subject,
		"data-change-snapshot": snapshot,
	}
	if group.CountsJSON != "" {
		attrs["data-change-counts"] = group.CountsJSON
	}
	if group.Hidden {
		attrs["hidden"] = true
	}
	return attrs
}

func changeCardAttrs(change webview.LabeledChange) templ.Attributes {
	attrs := templ.Attributes{
		"class":                "tokens-change-card tokens-change-disclosure",
		"data-change-card":     "",
		"data-change-snapshot": change.SnapshotID,
		"data-change-type":     change.Type,
		"data-change-search":   change.Search,
	}
	if change.Hidden {
		attrs["hidden"] = true
	}
	return attrs
}

func changeFilterFormAttrs(filters webview.ChangeFilters, action string) templ.Attributes {
	attrs := templ.Attributes{
		"class":               "tokens-change-filters",
		"method":              "get",
		"action":              action,
		"aria-label":          "Filter changes",
		"hx-boost":            "false",
		"data-change-filters": filters.LocalMode,
	}
	if filters.SearchVersion != "" {
		attrs["data-change-search-version"] = filters.SearchVersion
	}
	if filters.DataVersion != "" {
		attrs["data-change-data-version"] = filters.DataVersion
	}
	if filters.LocalMode == "snapshot" || filters.LocalMode == "query" {
		attrs["data-change-mounted-snapshot"] = filters.Snapshot
		attrs["data-change-mounted-type"] = filters.Type
	}
	return attrs
}

func changeResetAttrs(filters webview.ChangeFilters) templ.Attributes {
	attrs := templ.Attributes{"data-change-reset": ""}
	if filters.LocalMode != "server" {
		attrs["hx-boost"] = "false"
	}
	return attrs
}

func changePageLinkAttrs(filters webview.ChangeFilters, targetPage int) templ.Attributes {
	if filters.DataVersion == "" {
		return nil
	}
	return templ.Attributes{
		"data-change-page": strconv.Itoa(targetPage),
		"hx-boost":         "false",
	}
}

func changePageCount(total int) int {
	if total <= 0 {
		return 1
	}
	return (total + 49) / 50
}

templ ChangesPage(state publish.PublishedState, subject string, baseURL string, filters webview.ChangeFilters, counts string, batches []webview.ChangeTimelineBatch, page int, total int, hasPrevious bool, hasNext bool) {
	@Layout(webview.TimelineTitle(subject)) {
		<header class="tokens-history-intro">
			<h1 class="md-typescale-headline-medium">{ webview.ChangePageHeading(ctx, subject) }</h1>
			<p class="md-typescale-body-large">Dates show when Catalog detected changes. Coverage changes mark sources captured for only one side of a comparison.</p>
			<p class="tokens-metadata">{ webview.HistoryCoverage(state.Snapshots) }</p>
		</header>
		@ChangeHistoryView(state, subject, baseURL, filters, counts, batches, page, total, hasPrevious, hasNext)
	}
}

templ ChangeHistoryView(state publish.PublishedState, subject string, baseURL string, filters webview.ChangeFilters, counts string, batches []webview.ChangeTimelineBatch, page int, total int, hasPrevious bool, hasNext bool) {
	<div id="tokens-change-history" class="tokens-change-history" data-component-assets>
		@webview.ComponentAssetScope() {
			if len(state.Changes) > 0 {
				@webview.UseComponentAssets("card")
			}
			@ChangeFilterForm(filters, baseURL)
			if subject != "" && (total > 0 || (filters.LocalMode != "server" && len(state.Changes) > 0)) {
				<div class="tokens-history-counts" data-change-counts-banner hidden?={ total == 0 }>
					<p class="tokens-metadata" data-change-page-summary>Showing page { page } of { changePageCount(total) } · { total } total changes</p>
					<p class="tokens-change-counts" data-change-type-summary>{ counts }. One token can have changes in several settings.</p>
				</div>
			}
			if len(state.Changes) == 0 {
				if len(state.Snapshots) < 2 {
					<p>At least two snapshots are needed to detect changes.</p>
				} else {
					<p>No changes were detected in the retained snapshot history.</p>
				}
			} else if filters.LocalMode != "server" {
				<p data-change-empty hidden?={ total > 0 }>No changes match these filters.</p>
			} else if total == 0 {
				<p>No changes match these filters.</p>
			}
			<div class="tokens-change-results" data-change-results>
				for _, batch := range batches {
					<section class="tokens-section tokens-timeline-batch" data-change-snapshot={ batch.SnapshotID } hidden?={ batch.Hidden }>
						<header class="tokens-observation-heading">
							<h2 class="md-typescale-title-large">Observed <time datetime={ batch.DetectedAt }>{ webview.ObservationDate(batch.DetectedAt) }</time></h2>
							if batch.PreviousAt != "" {
								<p class="tokens-metadata">Compared with { webview.ObservationDate(batch.PreviousAt) }</p>
							}
						</header>
						<div class="tokens-observation-records">
							for _, group := range batch.Groups {
								if subject == "" {
									@webview.UseComponentAssets("card")
									@ui.CardSurface(ui.CardProps{Variant: "outlined", Attrs: changeSummaryAttrs(batch.SnapshotID, group)}) {
										<h3 class="md-typescale-title-medium">
											if group.URL != "" {
												<a class="tokens-link" href={ group.URL }>{ group.Label }</a>
											} else {
												{ group.Label }
											}
										</h3>
										<p data-change-count>
											if group.Count == 1 {
												1 item changed
											} else {
												{ group.Count } items changed
											}
										</p>
										@ui.ButtonLink(string(webview.GroupChangelogURL(baseURL, group, batch.SnapshotID)), ui.ButtonProps{Variant: ui.ButtonVariant("text"), Attrs: templ.Attributes{"data-change-group-link": "", "data-change-snapshot": batch.SnapshotID}}) {
											View changes
											@webview.MaterialSymbol("chevron_right")
										}
									}
								} else {
									if group.URL != "" {
										<p class="tokens-change-component-link">
											@ui.ButtonLink(string(group.URL), ui.ButtonProps{Variant: ui.ButtonVariant("outlined")}) {
												Browse tokens
												@webview.MaterialSymbol("arrow_forward")
											}
										</p>
									}
									@ChangeRecordList(group.Changes)
								}
							}
						</div>
					</section>
				}
				if hasPrevious || hasNext {
					<nav class="tokens-pagination" aria-label="Change log pages">
						if hasPrevious {
							@ui.ButtonLink(string(webview.ChangesPageURL(baseURL, page-1)), ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: changePageLinkAttrs(filters, page-1)}) {
								Previous
							}
						}
						<span class="md-typescale-body-small">Page { page }</span>
						if hasNext {
							@ui.ButtonLink(string(webview.ChangesPageURL(baseURL, page+1)), ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Attrs: changePageLinkAttrs(filters, page+1)}) {
								Next
							}
						}
					</nav>
				}
			</div>
			if filters.DataVersion != "" {
				<template data-change-chevron>@webview.MaterialSymbol("chevron_right")</template>
				<template data-change-arrow>@webview.MaterialSymbol("arrow_forward")</template>
			}
		}
	</div>
}

templ ChangeFilterForm(filters webview.ChangeFilters, baseURL string) {
	{{ action := strings.SplitN(baseURL, "?", 2)[0] }}
	<form { changeFilterFormAttrs(filters, action)... }>
		<div class="tokens-change-pill-group">
			if !filters.FixedSubject {
				@FilterPill("history-subject", "subject", "Component or style", filters.Subject, webview.HistoryChoices("All components and styles", filters.Subjects), false)
			}
			@FilterPill("history-snapshot", "snapshot", "Observed", filters.Snapshot, webview.HistoryChoices("All dates", filters.Snapshots), false)
			@FilterPill("history-type", "type", "Change", filters.Type, webview.HistoryChangeTypes(), false)
			<div class="tokens-change-filter-actions">
				<noscript>
					@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Type: "submit"}) {
						Apply filters
					}
				</noscript>
				@ui.ButtonLink(action, ui.ButtonProps{Variant: ui.ButtonVariant("text"), Attrs: changeResetAttrs(filters)}) {
					Reset
				}
			</div>
		</div>
		@ui.SearchBarSurface(ui.SearchProps{ID: "history-query", Name: "q", Value: filters.Query, Label: "Search token names", Placeholder: "Token name", Actions: "clear", PanelAttrs: templ.Attributes{"class":"tokens-history-search"}})
	</form>
}

templ ChangeRecordList(changes []webview.LabeledChange) {
	for _, change := range changes {
		@webview.UseComponentAssets("card")
		<details { (ui.CardProps{Variant:"outlined",Attrs:changeCardAttrs(change)}).Attributes()... }>
			<summary class="tokens-change-heading">
				@webview.MaterialSymbol("chevron_right")
				<h4>{ change.Name }</h4>
				<span class="tokens-change-status md-typescale-label-large" data-change-type={ change.Type }>{ webview.ChangeTypeLabel(change.Type) }</span>
				if context := webview.ChangeContext(change.ChangeView); context != "" {
					<span class="tokens-change-context tokens-change-context-summary">{ context }</span>
				}
			</summary>
			if len(change.Hierarchy) > 0 {
				<ol class="tokens-change-hierarchy" aria-label="Token hierarchy">
					for index, part := range change.Hierarchy {
						<li>
							if index > 0 {
								@webview.MaterialSymbol("chevron_right")
							}
							{ part }
						</li>
					}
				</ol>
			}
			<table class="tokens-change-table">
				<thead><tr><th scope="col">Property</th><th scope="col">Previous value</th><th scope="col">New value</th></tr></thead>
				<tbody>
					for _, value := range webview.ChangedValues(change.ChangeView) {
						<tr><th scope="row">{ value.Field }</th><td>{ value.Before }</td><td>{ value.After }</td></tr>
					}
				</tbody>
			</table>
		</details>
	}
}
