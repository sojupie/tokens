package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

import (
	"github.com/sojupie/tokens/source/publish"
	"strings"
)

templ ChangesPage(state publish.PublishedState, subject string, baseURL string, filters webview.ChangeFilters, counts string, changes []publish.ChangeView, page int, total int, hasPrevious bool, hasNext bool) {
	@Layout(webview.TimelineTitle(subject)) {
		<header class="tokens-history-intro">
			<h1 class="md-typescale-headline-medium">{ webview.ChangePageHeading(ctx, subject) }</h1>
			<p class="md-typescale-body-large">Dates show when we detected changes, not when Material published them.</p>
			<p class="tokens-metadata">{ webview.HistoryCoverage(state.Snapshots) }</p>
		</header>
		@ChangeFilterForm(filters, baseURL)
		if total > 0 && subject != "" {
			<div class="tokens-history-counts">
				<p class="tokens-metadata">Showing page { page } of { (total + 49) / 50 } · { total } total changes</p>
				<p class="tokens-change-counts">{ counts }. One token can have changes in several settings.</p>
			</div>
		}
		if len(changes) == 0 {
			if len(state.Snapshots) < 2 {
				<p>At least two snapshots are needed to detect changes.</p>
			} else if len(state.Changes) > 0 {
				<p>No changes match these filters.</p>
			} else {
				<p>No changes were detected in the retained snapshot history.</p>
			}
		}
		for _, batch := range webview.ChangeBatches(changes, state.Snapshots) {
			<section class="tokens-section tokens-timeline-batch">
				<header class="tokens-observation-heading">
					<h2 class="md-typescale-title-large">Observed <time datetime={ batch.DetectedAt }>{ webview.ObservationDate(batch.DetectedAt) }</time></h2>
					if batch.PreviousAt != "" {
						<p class="tokens-metadata">Compared with { webview.ObservationDate(batch.PreviousAt) }</p>
					}
				</header>
				<div class="tokens-observation-records">
					for _, group := range webview.ChangeGroups(batch.Changes, state.Subjects) {
						if subject == "" {
							@webview.UseComponentAssets("card")
							@ui.CardSurface(ui.CardProps{Variant: "outlined", Attrs: templ.Attributes{"class": "md-card md-outlined-card tokens-change-summary"}}) {
								<h3 class="md-typescale-title-medium">
									if group.URL != "" {
										<a class="tokens-link" href={ group.URL }>{ group.Label }</a>
									} else {
										{ group.Label }
									}
								</h3>
								<p>
									if webview.ChangedItemCount(group.Changes) == 1 {
										1 item changed
									} else {
										{ webview.ChangedItemCount(group.Changes) } items changed
									}
								</p>
								@ui.ButtonLink(string(webview.GroupChangelogURL(baseURL, group, batch.Changes[0].SnapshotID)), ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
									View changes
									@webview.MaterialSymbol("chevron_right")
								}
							}
						} else {
							if group.URL != "" {
								<p class="tokens-change-component-link">
									@ui.ButtonLink(string(group.URL), ui.ButtonProps{Variant: ui.ButtonVariant("outlined")}) {
										Browse tokens
										@webview.MaterialSymbol("arrow_forward")
									}
								</p>
							}
							@ChangeRecordList(group.Changes)
						}
					}
				</div>
			</section>
		}
		if hasPrevious || hasNext {
			<nav class="tokens-pagination" aria-label="Change log pages">
				if hasPrevious {
					@ui.ButtonLink(string(webview.ChangesPageURL(baseURL, page-1)), ui.ButtonProps{Variant: ui.ButtonVariant("outlined")}) {
						Previous
					}
				}
				<span class="md-typescale-body-small">Page { page }</span>
				if hasNext {
					@ui.ButtonLink(string(webview.ChangesPageURL(baseURL, page+1)), ui.ButtonProps{Variant: ui.ButtonVariant("outlined")}) {
						Next
					}
				}
			</nav>
		}
	}
}

templ ChangeFilterForm(filters webview.ChangeFilters, baseURL string) {
	<form class="tokens-change-filters" method="get" action={ strings.SplitN(baseURL, "?", 2)[0] } aria-label="Filter changes" hx-boost="false" hx-get={ strings.SplitN(baseURL, "?", 2)[0] } hx-target=".tokens-main" hx-select=".tokens-main" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change, input changed delay:250ms from:input[type='search'], submit" hx-sync="this:replace">
		<div class="tokens-change-pill-group">
			if !filters.FixedSubject {
				@FilterPill("history-subject", "subject", "Component or style", filters.Subject, webview.HistoryChoices("All components and styles", filters.Subjects), false)
			}
			@FilterPill("history-snapshot", "snapshot", "Observed", filters.Snapshot, webview.HistoryChoices("All dates", filters.Snapshots), false)
			@FilterPill("history-type", "type", "Change", filters.Type, []webview.CatalogChoice{{Value: "", Label: "All changes"}, {Value: "changed", Label: "Updated"}, {Value: "added", Label: "Added"}, {Value: "removed", Label: "Removed"}}, false)
			<div class="tokens-change-filter-actions">
				<noscript>
					@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Type: "submit"}) {
						Apply filters
					}
				</noscript>
				@ui.ButtonLink(string(strings.SplitN(baseURL, "?", 2)[0]), ui.ButtonProps{Variant: ui.ButtonVariant("text")}) {
					Reset
				}
			</div>
		</div>
		@ui.TextField(ui.TextFieldProps{ID: "history-query", Name: "q", Type: "search", Value: filters.Query, Label: "Token name"})
	</form>
}

templ ChangeRecordList(changes []webview.LabeledChange) {
	for _, change := range changes {
		@webview.UseComponentAssets("card")
		<details { (ui.CardProps{Variant:"outlined",Attrs:templ.Attributes{"class":"tokens-change-card tokens-change-disclosure"}}).Attributes()... }>
			<summary class="tokens-change-heading">
				@webview.MaterialSymbol("chevron_right")
				<h4>{ change.Name }</h4>
				<span class="tokens-change-status md-typescale-label-large" data-change-type={ change.Type }>{ webview.ChangeTypeLabel(change.Type) }</span>
				if context := webview.ChangeContext(change.ChangeView); context != "" {
					<span class="tokens-change-context tokens-change-context-summary">{ context }</span>
				}
			</summary>
			if len(change.Hierarchy) > 0 {
				<ol class="tokens-change-hierarchy" aria-label="Token hierarchy">
					for index, part := range change.Hierarchy {
						<li>
							if index > 0 {
								@webview.MaterialSymbol("chevron_right")
							}
							{ part }
						</li>
					}
				</ol>
			}
			<table class="tokens-change-table">
				<thead><tr><th scope="col">Property</th><th scope="col">Previous value</th><th scope="col">New value</th></tr></thead>
				<tbody>
					for _, value := range webview.ChangedValues(change.ChangeView) {
						<tr><th scope="row">{ value.Field }</th><td>{ value.Before }</td><td>{ value.After }</td></tr>
					}
				</tbody>
			</table>
		</details>
	}
}
