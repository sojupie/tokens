package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

import "github.com/sojupie/tokens/source/publish"

templ SubjectListPage(snapshot publish.SnapshotView, subjects []publish.SubjectView, styles bool, query string, thumbnails map[string]webview.ComponentCase) {
	@Layout("Published Material Design 3 subjects") {
		<header class="tokens-subject-heading">
			if styles {
				<h1 class="md-typescale-headline-medium">Styles and token sources</h1>
				@SiteDownloadButton()
			} else {
				<h1 class="md-typescale-headline-medium">Components</h1>
				@SiteDownloadButton()
			}
		</header>
		<div data-nosnippet><p class="tokens-metadata">Current snapshot: <code class="tokens-code">{ snapshot.ID }</code></p></div>
		<form hx-boost="false" class="tokens-search-form" method="get" action={ webview.SubjectListPath(styles) } role="search">
			@ui.TextField(ui.TextFieldProps{ID: "subject-search", Name: "q", Type: "search", Value: query, Label: "Search by name or slug", InputAttrs: templ.Attributes{"autocomplete": "off", "hx-get": webview.SubjectListPath(styles), "hx-target": "#subject-list", "hx-trigger": "input changed delay:250ms", "hx-push-url": "true", "hx-sync": "this:replace"}})
		</form>
		<div id="subject-list" aria-live="polite">
			@SubjectCardGrid(subjects, thumbnails, styles)
		</div>
	}
}

templ SubjectCardGrid(subjects []publish.SubjectView, thumbnails map[string]webview.ComponentCase, styles bool) {
	<ul class="tokens-card-grid tokens-layout-grid">
		for _, subject := range subjects {
			if (subject.Key.Kind!=publish.SubjectComponent)==styles {
				@SubjectCard(subject, thumbnails, styles)
			}
		}
		if len(subjects)==0 {
			<li class="tokens-empty md-typescale-body-large">No matching subjects.</li>
		}
	</ul>
}

templ SubjectCard(subject publish.SubjectView, thumbnails map[string]webview.ComponentCase, styles bool) {
	<li class="tokens-component-tile">
		<div class="tokens-component-thumbnail">
			if image,ok:=webview.ThumbnailIllustration(ctx,webview.SubjectURL(subject)); ok {
				@ThumbnailPicture(image)
			} else {
				<span data-thumbnail-missing aria-hidden="true">@webview.MaterialSymbol("widgets")</span>
			}
		</div>
		<a class="tokens-component-tile-link" href={ webview.SubjectURL(subject) }>
			<span class="md-typescale-title-medium">{ webview.SubjectName(subject) }</span>
			<small class="md-typescale-body-small">{ len(subject.Tokens) } tokens</small>
		</a>
	</li>
}
