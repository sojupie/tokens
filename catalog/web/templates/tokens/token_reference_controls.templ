package render

import webview "github.com/sojupie/tokens/catalog/web/internal/presentation"

import "github.com/sojupie/tokens/forge/components/ui"

// The browser clones this template. Icons keep using the table's shared SVG paths.
templ TokenReferenceChrome() {
	<template class="tokens-reference-chrome">
		<header>
			<h3 class="md-typescale-title-large"></h3>
			@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Close token details", Attrs: templ.Attributes{"class": "tokens-icon-button tokens-popover-close", "popovertargetaction": "hide"}}) {
				@templ.Raw(webview.TokenTableSymbol("close"))
			}
		</header>
		<div class="tokens-popup-value"></div>
		<div class="tokens-reference-resolved"><span class="tokens-reference-type">Color</span></div>
		<p class="tokens-reference-status" role="status" aria-live="polite"></p>
		@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "", Attrs: templ.Attributes{"class": "tokens-icon-button", "data-copy-reference": ""}}) {
			@templ.Raw(webview.TokenTableSymbol("content_copy"))
		}
	</template>
}
