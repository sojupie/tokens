package web

import "github.com/sojupie/tokens/forge/components/ui"

import "github.com/sojupie/tokens/source/publish"

// These are editorial scenes, not additional playground implementations. Every
// focal control is rendered by the same specimens and token bindings as the lab.
templ illustrationPage(subject publish.SubjectView, c componentCase, theme string, contrast string, thumbnail bool, review bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ theme } data-contrast={ contrast }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>{ subjectName(subject) } illustration</title>
			<link rel="stylesheet" href="/theme.css"/>
			<link rel="stylesheet" href={ staticURL("site.css") }/>
			<link rel="stylesheet" href={ staticURL("app.css") }/>
			<link rel="stylesheet" href={ staticURL("buttons.css") }/>
			<link rel="stylesheet" href={ staticURL("components.css") }/>
			<link rel="stylesheet" href={ staticURL("bundles/common.css") }/>
			<link rel="stylesheet" href={ staticURL("illustrations.css") }/>
			<link rel="stylesheet" href={ staticURL("scene-screens.css") }/>
			<script src={ staticURL("motion.js") } defer></script>
			<script src={ staticURL("buttons.js") } defer></script>
			<script src={ staticURL("components.js") } defer></script>
			<script src={ staticURL("fields.js") } defer></script>
			<script src={ staticURL("date-picker.js") } defer></script>
			<script src={ staticURL("time-picker.js") } defer></script>
			<script src={ staticURL("progress.js") } defer></script>
			<script src={ staticURL("carousel.js") } defer></script>
			if !review {
				<script src={ staticURL("illustration-ready.js") } defer></script>
			}
			<script src={ staticURL("scene-review.js") } defer></script>
		</head>
		<body class="tokens-illustration-body" data-composition={ map[bool]string{true: "thumbnail", false: "scene"}[thumbnail] } data-scene-review?={ review }>
			@componentAssetScope() {
				@useComponentAssets("card")
				@useComponentAssets("fab")
				<main data-component-assets class="tokens-illustration" data-family={ c.Family } data-style={ subject.Key.Slug }>
					<div class="scene-orbit scene-orbit-one"></div>
					<div class="scene-orbit scene-orbit-two"></div>
					if thumbnail {
						<div class="scene-thumbnail-capture">
							<div class="tokens-component-thumbnail" data-preview-ready>
								<div class="tokens-component-thumbnail-scene" inert>
									if subject.Key.Kind==publish.SubjectComponent {
										@componentThumbnail(c)
									} else {
										@styleThumbnail(subject)
									}
								</div>
							</div>
						</div>
					} else if c.Family=="overview" {
						@overviewScene(c.Control)
					} else if subject.Key.Kind != publish.SubjectComponent && subject.Key.Slug != "" {
						@styleScene(subject)
					} else {
						<div class="scene-capture" style={ sceneFrameStyle(c) }>
							@sceneScreen(c)
						</div>
					}
				</main>
			}
		</body>
	</html>
}

templ sceneArtwork(scene string, kind string) {
	<img class={ "scene-art scene-art-" + kind } src={ staticURL("paintings/" + scenePainting(scene, kind)) } alt="" width="1200" height="800"/>
}

templ styleScene(subject publish.SubjectView) {
	<section class="scene-style-window">
		<h1>{ subjectName(subject) }</h1>
		switch subject.Key.Slug {
			case "typography/type-scale":
				<div class="scene-type">
					<span class="md-typescale-display-large">Take the<br/>long way.</span>
					<div>
						<h2 class="md-typescale-headline-medium">A day worth keeping.</h2>
						<p class="md-typescale-body-large">Leave the familiar behind. Find a path by the water, a quiet café, or a new corner of the city.</p>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
	Start exploring
}
					</div>
				</div>
			case "motion/overview":
				<div class="scene-motion">
					<svg viewBox="0 0 600 300"><path class="scene-motion-axis" d="M40 20V260H580"></path><path class="scene-motion-curve" d="M40 260C100 260 150 25 580 25"></path><circle cx="330" cy="53" r="20"></circle></svg>
					<div>
						<span class="scene-stamp">
							@materialSymbol("arrow_forward")
						</span>
						<h2>From here<br/>to somewhere new.</h2>
					</div>
				</div>
			case "shape/corner-radius":
				<div class="scene-shape-grid">
					<div>
						@sceneArtwork(subject.Key.Slug, "coast")
					</div>
					<div>
						@materialSymbol("star")
					</div>
					<div>
						@materialSymbol("arrow_forward")
					</div>
					<div>
						@sceneArtwork(subject.Key.Slug, "hills")
					</div>
				</div>
			case "spacing":
				<div class="scene-space-grid">
					for _,size:=range []string{"8","16","24"} {
						<div class={ "scene-spacing-example scene-spacing-" + size }>
							<span class="scene-overline">{ size+"dp" }</span>
							<article>
								<h2>A little room.</h2>
								<p>Space to breathe.</p>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("tonal"), Size: ui.Size("small")}) {
	Explore
}
							</article>
						</div>
					}
				</div>
			default:
				<div class="scene-elevation">
					@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card"}}) {
						<h2>Places to come back to.</h2>@sceneArtwork(subject.Key.Slug, "coast")
					}
					@ui.CardSurface(ui.CardProps{Variant: "elevated", Attrs: templ.Attributes{"class": "md-card md-elevated-card"}}) {
						<h2>Make room for another.</h2>
						<p>Save something worth keeping.</p>
						@ui.Button(templ.Attributes{"class": "md-fab md-button", "data-size": "default", "data-variant": "primary"}) {
							@materialSymbol("add")
						}
					}
				</div>
		}
	</section>
}

templ subjectIllustration(image Illustration) {
	<figure class="tokens-subject-illustration">
		<picture>
			for _,variant := range []string{"dark-high","dark-medium","dark-default","light-high","light-medium"} {
				<source data-image-appearance={ variant } srcset={ illustrationFileURL(image.Files[variant]) } media="not all"/>
			}
			<img src={ illustrationFileURL(image.Files["light-default"]) } alt={ image.Alt } width="1200" height="630" decoding="async" fetchpriority="high"/>
		</picture>
		@illustrationImageTheme()
	</figure>
}

templ overviewScene(kind string) {
	<section class="scene-overview">
		if kind=="/styles" {
			<h1>Styles</h1>
			<div class="scene-overview-foundations"><div><span class="md-typescale-display-large">Aa</span><h2>Type with a clear hierarchy.</h2><p class="md-typescale-body-large">From the first headline to the smallest detail.</p></div><div class="scene-overview-colors"><span></span><span></span><span></span><span></span></div></div>
			<div class="scene-overview-shapes"><span></span><span></span><span></span><span></span></div>
		} else if kind=="/components" {
			<h1>Components</h1>
			<p class="scene-overview-intro">Controls and patterns, ready to explore.</p>
			<div class="scene-overview-gallery">
				<section>
					<h2>Actions</h2>
					<div class="scene-overview-button-row">
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("medium")}) {
							Save
						}
						@ui.IconButtonContent(ui.IconButtonProps{Variant: "tonal", Label: "Edit", Size: ui.Size("medium")}) {
							@materialSymbol("edit")
						}
					</div>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Size: ui.Size("small")}) {
	Get directions
}
				</section>
				<section>
					<h2>Choices</h2>@componentSpecimen(componentCase{Family: "chip", Variant: "filter", State: "enabled", Selected: true, illustrationLabels: [3]string{"Near the water"}})
					<div class="scene-overview-options">
						@checkboxChoice(componentCase{Family: "checkbox", State: "enabled", Selected: true}, "Save for later")
						@switchChoice(componentCase{Family: "switch", State: "enabled", Selected: true}, "Notifications")
					</div>
				</section>
				@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card scene-overview-place"}}) {
					@sceneArtwork("card", "hills")
					<div><h2>Into the hills</h2><p>A little further from the city.</p></div>
				}
			</div>
		} else {
			<h1>{ map[string]string{"/":"Material Design 3","/components":"Components"}[kind] }</h1>
			<p class="scene-overview-intro">{ map[string]string{"/":"Explore the details that bring an interface together.","/components":"Controls and patterns, ready to explore."}[kind] }</p>
			<div class="scene-overview-components">
				@ui.CardSurface(ui.CardProps{Variant: "filled", Attrs: templ.Attributes{"class": "md-card md-filled-card scene-overview-place"}}) {
					@sceneArtwork("card", "coast")
					<div>
						<h2>Along the coast</h2>
						<p>A route for the weekend.</p>@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("small")}) {
	View route
}
					</div>
				}
				<div class="scene-overview-controls">
					<h2>Make it yours</h2>
					<div class="scene-overview-button-row">
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("filled"), Size: ui.Size("medium")}) {
							Save
						}
						@ui.Action(ui.ButtonProps{Variant: ui.ButtonVariant("outlined"), Size: ui.Size("medium")}) {
							Cancel
						}
					</div>
					@componentSpecimen(componentCase{Family: "chip", Variant: "filter", State: "enabled", Selected: true, illustrationLabels: [3]string{"Near the water"}})
					<div class="scene-overview-options">
						@switchChoice(componentCase{Family: "switch", State: "enabled", Selected: true}, "Notifications")
						@switchChoice(componentCase{Family: "switch", State: "enabled"}, "Download on Wi-Fi")
					</div>
				</div>
			</div>
		}
	</section>
}

templ thumbnailPicture(image Illustration) {
	<picture class="tokens-thumbnail-image">
		for _,variant := range []string{"dark-high","dark-medium","dark-default","light-high","light-medium"} {
			<source data-image-appearance={ variant } srcset={ illustrationFileURL(image.Files[variant]) } media="not all"/>
		}
		<img src={ illustrationFileURL(image.Files["light-default"]) } alt={ image.Name + " component preview" } width="720" height="450" loading="lazy" decoding="async"/>
	</picture>
	@illustrationImageTheme()
}
