package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ specimenCarousel(c componentCase) {
	@carouselSurface(c, true)
}

templ carouselSurface(c componentCase, demonstration bool) {
	{{ p := ui.CarouselProps{Label: "Example carousel", Attrs: c.Attributes()}
if demonstration {
	p.Header = carouselExampleHeader(c)
	p.Actions = carouselExampleActions(c)
	p.Controls = carouselExampleControls()
} }}
	@ui.Carousel(p, 6) {
		for index:=range 6 {
			@ui.CarouselItem(ui.CarouselItemProps{Index: index, Count: 6, ImageSrc: staticURL("paintings/" + carouselPaintings[index%len(carouselPaintings)]), SlotAttrs: c.CarouselSlot(index), Attrs: c.CarouselItem(index)}) {
				if demonstration {
					<span class="md-carousel-number" aria-hidden="true">{ fmt.Sprint(index+1) }</span>
				}
			}
		}
	}
}

templ carouselExampleHeader(c componentCase) {
	if c.Variant!="full-screen"&&c.CarouselAction=="header-arrow" {
		@ui.CarouselHeader() {
			<h3 class="md-typescale-title-large">Featured items</h3>@ui.IconButton(ui.IconButtonProps{Label: "Show all featured items", Icon: "arrow_forward"})
		}
	}
}

templ carouselExampleActions(c componentCase) {
	if c.Variant!="full-screen"&&c.CarouselAction!="none"&&c.CarouselAction!="header-arrow" {
		@ui.CarouselAction() {
			@ui.Action(ui.ButtonProps{Variant: ui.Text}) {
				Show all
			}
		}
	}
}

templ carouselExampleControls() {
	@ui.CarouselControls(1, 6)
}

templ carouselArtwork(index int) {
	<img src={ staticURL("paintings/" + carouselPaintings[index%len(carouselPaintings)]) } alt="" width="1200" height="800" draggable="false"/>
}
