package web
import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"
templ specimenCarousel(c componentCase){ @carouselSurface(c,true) }
templ carouselSurface(c componentCase,demonstration bool){
 {{p:=ui.CarouselProps{Label:"Example carousel",Attrs:c.Attributes()};if demonstration {p.Header=carouselExampleHeader(c);p.Actions=carouselExampleActions(c);p.Controls=carouselExampleControls()}}}
 @ui.Carousel(p,6){
 for index:=range 6 {
 @ui.CarouselItem(ui.CarouselItemProps{Index:index,Count:6,ImageSrc:staticURL("paintings/"+carouselPaintings[index%len(carouselPaintings)]),SlotAttrs:c.CarouselSlot(index),Attrs:c.CarouselItem(index)}){
 if demonstration  {
<span class="md-carousel-number" aria-hidden="true">{fmt.Sprint(index+1)}</span>
}
 }
 }
 }
}
templ carouselExampleHeader(c componentCase){
 if c.Variant!="full-screen"&&c.CarouselAction=="header-arrow"  {
<header class="md-carousel-header"><h3 class="md-typescale-title-large">Featured items</h3>@ui.IconButton(ui.IconButtonProps{Label:"Show all featured items",Icon:"arrow_forward"})</header>
 }
}
templ carouselExampleActions(c componentCase){
 if c.Variant!="full-screen"&&c.CarouselAction!="none"&&c.CarouselAction!="header-arrow"  {
<div class="md-carousel-all-action">@ui.Action(ui.ButtonProps{Variant:ui.Text}){Show all}</div>
 }
}
templ carouselExampleControls(){
 <div class="md-carousel-controls">@ui.IconButton(ui.IconButtonProps{Label:"Previous item",Icon:"chevron_left",Attrs:templ.Attributes{"data-carousel-step":"-1"}})<output class="md-typescale-label-medium" aria-live="polite">Item 1 of 6</output>@ui.IconButton(ui.IconButtonProps{Label:"Next item",Icon:"chevron_right",Attrs:templ.Attributes{"data-carousel-step":"1"}})</div>
}
templ carouselArtwork(index int){<img src={staticURL("paintings/"+carouselPaintings[index%len(carouselPaintings)])} alt="" width="1200" height="800" draggable="false"/>}
