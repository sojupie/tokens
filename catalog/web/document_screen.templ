package web

import "fmt"
import "github.com/sojupie/tokens/forge/components/ui"

templ documentCommandBar(menuOpen bool) {
	<div class="scene-document-chrome" data-menu-example data-app-initial-menu?={ menuOpen }>
		@useComponentAssets("common")
		<header class="scene-document-header">
			<div class="scene-inline-options">
				@sceneIcon("arrow_back", "Back to documents")
				<div><h1 class="md-typescale-title-large">Exhibition installation plan</h1><p class="md-typescale-body-small">All changes saved</p></div>
			</div>
			<div class="scene-document-menu-anchor">
				@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Document actions", Attrs: templ.Attributes{"data-menu-open": "installation-menu", "aria-haspopup": "menu", "aria-expanded": "false", "aria-controls": "installation-menu"}, Size: ui.Size("small")}) {
					@materialSymbol("more_vert")
				}
				@ui.Menu("installation-menu", "Document actions", true) {
					for i,label:=range []string{"Rename","Make a copy","Download PDF","Version history","Move to Trash"} {
						<li role="none">
							@ui.MenuItem(templ.Attributes{"disabled": i == 3, "data-app-document-action": fmt.Sprint(i)}, label, materialSymbol([]string{"edit", "content_copy", "download", "history", "delete"}[i]), nil)
						</li>
					}
				}
			</div>
		</header>
		@sceneEditorMenus(false)
		@sceneEditorFormatting(false)
		<output class="tokens-visually-hidden" data-menu-output aria-live="polite"></output>
	</div>
}

templ documentPaper() {
	<article class="scene-document-paper"><h2 class="md-typescale-headline-medium">Installation schedule</h2><p class="md-typescale-body-large">4–6 November 2026</p><h3 class="md-typescale-title-large">Wednesday · Gallery preparation</h3><p class="md-typescale-body-large">The installation team arrives at 9:00. Start in gallery 2 while lighting is adjusted in gallery 1. Keep the central walkway clear for deliveries.</p><h3 class="md-typescale-title-large">Artwork and labels</h3><p class="md-typescale-body-large">Check each work against the final artwork list. Labels should be proofed before mounting; place them consistently beside each work at the agreed height.</p><ul class="md-typescale-body-large"><li>Confirm hanging heights with the curator.</li><li>Check lighting after all works are installed.</li><li>Leave time for a final walk-through on Thursday.</li></ul><h3 class="md-typescale-title-large">Opening day</h3><p class="md-typescale-body-large">Visitor services arrive at 8:30. Doors open at 10:00, with the first guided tour at 11:30. Printed guides will be available at reception.</p></article>
}
