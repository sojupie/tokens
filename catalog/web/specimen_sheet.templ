package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenBottomSheet(c componentCase) {
	@playgroundBottomSheet(c)
}

// Playground configuration is adapted to the shared sheet surface.
templ sheetSurface(c componentCase) {
	@ui.SheetSurface(ui.SheetProps{ID: c.ID(), Kind: ui.SheetKind(map[bool]string{true: "side", false: "bottom"}[c.Family == "side-sheet"]), Modal: c.Control == "modal", Inline: c.State != "interactive", Hidden: c.State == "interactive", Minimized: c.Family == "bottom-sheet" && c.Variant == "minimized", Attrs: c.SheetAttributes(), HandleAttrs: c.SheetHandle()}) {
		{ children... }
	}
}

templ sheetExampleContents(c componentCase) {
	@ui.SheetHeader(ui.SheetProps{ID: c.ID(), Title: "Details", CloseAttrs: templ.Attributes{"aria-label": "Close sheet", "data-sheet-initial-focus": c.Family == "side-sheet", "autofocus": c.Family == "side-sheet" && c.Control == "modal" && c.State == "interactive"}})
	@ui.SheetBody() {
		<p class="md-typescale-body-medium">Supporting text</p>
		@ui.TextField(ui.TextFieldProps{ID: c.ID() + "-name", Name: "name", Label: "Name", Value: "Sample", Placeholder: "Name"})
	}
	@ui.SheetActions() {
		@ui.Button(c.SheetAction(0)) {
			Cancel
		}
		@ui.Button(c.SheetAction(1)) {
			Done
		}
	}
}
