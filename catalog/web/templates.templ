package web

import (
	"strings"
 "fmt"
	"github.com/sojupie/tokens/source/publish"
)

templ layout(title string) {
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		@initialThemeScript()
		<script src={ staticURL("theme.js") } defer></script>
		<link rel="stylesheet" href={ themeURL(ctx) }/>
		<link rel="stylesheet" href={ staticURL("app.css") }/>
		<link rel="stylesheet" href={ staticURL("token-table.css") }/>
        <link rel="stylesheet" href={ staticURL("buttons.css") }/>
        <link rel="stylesheet" href={ staticURL("components.css") }/>
        <script src={ staticURL("buttons.js") } defer></script>
		<script src={ staticURL("htmx.min.js") } defer></script>
		<script src={ staticURL("token-table.js") } defer></script>
		<script src={ staticURL("webmcp.js") } defer></script>
		<script src={ staticURL("prefetch.js") } defer></script>
		<link rel="icon" type="image/webp" sizes="250x250" href={ staticURL("logo-250x250.webp") }/>
		<link rel="apple-touch-icon" href={ staticURL("logo-250x250.png") }/>
		<title>{ pageTitle(ctx, title) } · Token Catalog</title>
		<meta name="description" content={ metadata(ctx).Description }/>
		if metadata(ctx).AgentDiscovery {
			<link rel="describedby" href="/agents.json" type="application/json"/>
			<link rel="describedby" href="/llms.txt" type="text/plain"/>
			<link rel="service-desc" href="/openapi.json" type="application/json"/>
			<link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json"/>
			<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json"/>
		}
		if metadata(ctx).JSONAlternate != "" {
			<link rel="alternate" href={ templ.SafeURL(metadata(ctx).JSONAlternate) } type="application/json" title="Token data for this view"/>
		}
		if metadata(ctx).Canonical != "" {
			<link rel="canonical" href={ templ.SafeURL(metadata(ctx).Canonical) }/>
		}
		if metadata(ctx).NoIndex {
			<meta name="robots" content="noindex, follow"/>
		}
	</head>
	<body class="tokens-body">
		<header class="tokens-site-header">
			<nav class="tokens-primary-nav" aria-label="Primary">
				<a class="tokens-brand md-typescale-headline-medium" href="/"><img class="tokens-brand-logo" src={ staticURL("logo-250x250.webp") } alt="" width="40" height="40"/>Token Catalog</a>
				<div class="tokens-nav-links">
					<a class="tokens-nav-link md-typescale-label-large" href="/components">Components</a>
					<a class="tokens-nav-link md-typescale-label-large" href="/styles">Styles and token sources</a>
					<a class="tokens-nav-link md-typescale-label-large" href="/changes">Change log</a>
                    if metadata(ctx).AgentDiscovery {
                        <a class="tokens-nav-link md-typescale-label-large" href="/for-agents">Use with your agent</a>
                    }
				</div>
				<div class="tokens-theme-controls" role="group" aria-label="Site appearance">
					<button class="md-icon-button md-standard-icon-button" type="button" data-app-theme aria-label="Dark mode" aria-pressed="false" title="Dark mode" disabled>
						<span data-theme-icon="light">
							@materialSymbol("dark_mode")
						</span>
						<span data-theme-icon="dark" hidden>
							@materialSymbol("light_mode")
						</span>
					</button>
					<div class="tokens-contrast-buttons" role="group" aria-label="Contrast">
						<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="default" aria-label="Standard contrast" aria-pressed="true" title="Standard contrast" disabled>
							@materialSymbol("brightness_low")
						</button>
						<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="medium" aria-label="Medium contrast" aria-pressed="false" title="Medium contrast" disabled>
							@materialSymbol("brightness_medium")
						</button>
						<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="high" aria-label="High contrast" aria-pressed="false" title="High contrast" disabled>
							@materialSymbol("brightness_high")
						</button>
					</div>
				</div>
			</nav>
		</header>
		<main class="tokens-main">
			{ children... }
		</main>
		<footer class="tokens-site-footer">
			<div class="tokens-footer-content">
				<div>
					<p class="md-typescale-title-medium">Token Catalog</p>
					<p class="md-typescale-body-medium">Browse Material Design 3 tokens and track their changes.</p>
					<p class="md-typescale-body-medium">Independent project. Not affiliated with Google.</p>
                    @siteDownloadMenu()
				</div>
				<div>
					<p class="md-typescale-title-medium">For humans</p>
					<a class="tokens-link md-typescale-body-medium" href="https://github.com/sojupie/tokens">GitHub</a>
                    <a class="tokens-link md-typescale-body-medium" href="/components">Browse components</a>
                    <a class="tokens-link md-typescale-body-medium" href="/for-agents">Give this to your agent</a>
				</div>
                if metadata(ctx).AgentDiscovery {
                    <div>
                        <p class="md-typescale-title-medium">For agents</p>
                        <a class="tokens-link md-typescale-body-medium" href="/llms-full.txt">API and data reference</a>
                    </div>
                }
                <div>
                    <p class="md-typescale-title-medium">About</p>
					<p class="md-typescale-body-medium">Made by Olle Marmenlind</p>
					<a class="tokens-link md-typescale-body-medium" href="https://marmenlind.com">marmenlind.com</a>
				</div>
			</div>
		</footer>
	</body>
</html>
}

templ overviewPage(snapshot publish.SnapshotView, subjects []publish.SubjectView) {
@layout("Material Design 3 Tokens and Change History") {
		<header class="tokens-subject-heading">
			<h1 class="md-typescale-headline-medium">Material Design 3 tokens and change history</h1>
		</header>
		<p class="md-typescale-body-large">Browse Material Design 3 components and styles. Compare token values by context, follow named references, download JSON and review observed changes.</p>
		@siteDownloadButton("all")
		<div data-nosnippet>
			<p class="md-typescale-body-large">Current snapshot: <code class="tokens-code">{ snapshot.ID }</code></p>
			<p class="tokens-metadata">Detected: { snapshot.CreatedAt }</p>
		</div>

        if metadata(ctx).AgentDiscovery {
            <div class="tokens-audience-grid">
                <section class="md-card md-elevated-card tokens-card-content" aria-labelledby="human-heading">
                    <h2 class="md-typescale-title-medium" id="human-heading">Browse tokens</h2>
                    <p>Browse components and styles, compare values, and download the tokens you need.</p>
                    <a class="md-button md-outlined-button" href="/components">Browse components</a>
                </section>
                <section class="md-card md-elevated-card tokens-card-content" aria-labelledby="agent-heading">
                    <h2 class="md-typescale-title-medium" id="agent-heading">Use with your agent</h2>
                    <p>Give your coding agent access to the same token data through a prompt, skill, or MCP.</p>
                    <a class="md-button md-tonal-button" href="/for-agents">Give this to your agent</a>
                </section>
            </div>
        }
        <section class="tokens-section" aria-labelledby="components-heading">
			<h2 class="md-typescale-title-medium" id="components-heading">Components</h2>
			<ul class="tokens-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind == publish.SubjectComponent {
						<li><a class="md-card md-outlined-card md-interactive-card tokens-card" href={ subjectURL(subject) }>{ subject.Name } <small class="md-typescale-body-small">({ len(subject.Tokens) } tokens)</small></a></li>
					}
				}
			</ul>
		</section>

		<section class="tokens-section" aria-labelledby="styles-heading">
			<h2 class="md-typescale-title-medium" id="styles-heading">Styles and token sources</h2>
			<ul class="tokens-card-grid">
				for _, subject := range subjects {
					if subject.Key.Kind != publish.SubjectComponent {
						<li><a class="md-card md-outlined-card md-interactive-card tokens-card" href={ subjectURL(subject) }>{ subject.Name } <small class="md-typescale-body-small">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></a></li>
					}
				}
			</ul>
		</section>
}
}

templ subjectListPage(snapshot publish.SnapshotView, subjects []publish.SubjectView, styles bool, query string) {
@layout("Published Material Design 3 subjects") {
		<header class="tokens-subject-heading">
		if styles {
			<h1 class="md-typescale-headline-medium">Styles and token sources</h1>
			@siteDownloadButton("styles")
		} else {
			<h1 class="md-typescale-headline-medium">Components</h1>
			@siteDownloadButton("components")
		}
		</header>
		<div data-nosnippet><p class="tokens-metadata">Current snapshot: <code class="tokens-code">{ snapshot.ID }</code></p></div>
		<form class="tokens-search-form" method="get" action={ subjectListPath(styles) } role="search">
			<label class="md-typescale-body-medium" for="subject-search">Search by name or slug</label>
			<input class="md-outlined-text-field tokens-search-input" id="subject-search" type="search" name="q" value={ query } autocomplete="off"
				hx-get={ subjectListPath(styles) }
				hx-target="#subject-list"
				hx-trigger="input changed delay:250ms"
				hx-push-url="true"/>
		</form>
		<div id="subject-list" class="md-card md-outlined-card tokens-list-panel">
			@subjectList(subjects)
		</div>
}
}

templ siteDownloadButton(scope string) {
	<div class="tokens-token-download">
		<button class="md-button md-outlined-button" type="button" data-site-download-open={ scope } aria-haspopup="dialog" aria-controls="tokens-site-download">Download JSON</button>
	</div>
}

templ siteDownloadMenu() {
	<div class="tokens-token-download">
		<button class="md-button md-outlined-button" type="button" data-download-open aria-haspopup="dialog" aria-controls="tokens-site-download">Download JSON</button>
		<div data-nosnippet><dialog class="md-dialog" id="tokens-site-download" aria-labelledby="tokens-site-download-title">
			<form method="get" action="/downloads/tokens.json">
				<h2 id="tokens-site-download-title">Download tokens</h2>
				<fieldset>
					<legend>What should the file include?</legend>
					<label class="tokens-download-option"><input class="md-radio" type="radio" name="scope" value="components"/><span><strong>Components</strong><small>Every component, token set and supported context.</small></span></label>
					<label class="tokens-download-option"><input class="md-radio" type="radio" name="scope" value="styles"/><span><strong>Styles and token sources</strong><small>All style and foundation tokens, with every supported context.</small></span></label>
					<label class="tokens-download-option"><input class="md-radio" type="radio" name="scope" value="all" checked/><span><strong>All tokens</strong><small>Everything in the current publication, including components and styles.</small></span></label>
				</fieldset>
				<footer><button class="md-button md-text-button" type="button" data-download-cancel>Cancel</button><button class="md-button md-filled-button" type="submit">Download JSON</button></footer>
			</form>
		</dialog></div>
		<noscript>
			<a class="tokens-link" href="/downloads/tokens.json?scope=components">Download components</a>
			<a class="tokens-link" href="/downloads/tokens.json?scope=styles">Download styles</a>
			<a class="tokens-link" href="/downloads/tokens.json?scope=all">Download all tokens</a>
		</noscript>
	</div>
}

templ subjectList(subjects []publish.SubjectView) {
	<ul class="tokens-subject-list">
		for _, subject := range subjects {
			<li class="tokens-list-item"><a class="tokens-link" href={ subjectURL(subject) }>{ subject.Name }</a> <small class="md-typescale-body-small">{ subjectKindLabel(subject.Key.Kind) } · { len(subject.Tokens) } tokens</small></li>
		}
		if len(subjects) == 0 {
			<li class="tokens-empty md-typescale-body-large">No matching subjects.</li>
		}
	</ul>
}

templ subjectPage(subject publish.SubjectView, changes []publish.ChangeView, browser tokenBrowser) {
    @subjectPageComponent(subject, changes, browser)
}

templ tokenSetPicker(subject publish.SubjectView, browser tokenBrowser) {
	<button class="md-filter-chip tokens-token-set" data-selected="true" type="button" popovertarget="tokens-token-set-menu" aria-label={ "Token set: " + tokenSetLabel(browser.Selected) }>
		<span class="tokens-context-label" title={ tokenSetLabel(browser.Selected) }>{ tokenSetLabel(browser.Selected) }</span>
		@materialSymbol("expand_more")
	</button>
	<nav class="md-menu tokens-token-set-menu" id="tokens-token-set-menu" popover="auto" aria-label="Token sets">
		<a class="md-menu-item tokens-token-set-overview" href={ subjectURL(subject) }>{ subject.Name } overview</a>
		for _, group := range tokenSetMenuGroups(browser.Sets) {
			<section>
				<h3 class="md-typescale-title-medium">{ group.Label }</h3>
				<ul>
					for _, set := range group.Sets {
						<li>
							<a class="md-menu-item" href={ tokenSetLinkURL(subject, set, browser) } aria-current={ currentTokenSet(set.Key == browser.Selected.Key) }>
								@materialSymbol("check")
								{ tokenSetMenuLabel(set) }
							</a>
						</li>
					}
				</ul>
			</section>
		}
	</nav>
}

templ changesPage(state publish.PublishedState, subject string, baseURL string, filters changeFilters, counts string, changes []publish.ChangeView, page int, total int, hasPrevious bool, hasNext bool) {
@layout(timelineTitle(subject)) {
		<h1 class="md-typescale-headline-medium">{ timelineTitle(subject) }</h1>
		<p class="tokens-metadata">{ historyCoverage(state.Snapshots) }</p>
		<p class="md-typescale-body-medium">Dates show when we detected changes, not when Material published them.</p>
		@changeFilterForm(filters, baseURL)
		if total > 0 && subject != "" {
			<p class="tokens-metadata">Showing page { page } of { (total + 49) / 50 } · { total } total changes</p>
			<p class="tokens-change-counts">{ counts }. One token can have changes in several settings.</p>
		}
		if len(changes) == 0 {
			if len(state.Snapshots) < 2 {
				<p>At least two snapshots are needed to detect changes.</p>
			} else if len(state.Changes) > 0 {
				<p>No changes match these filters.</p>
			} else {
				<p>No changes were detected in the retained snapshot history.</p>
			}
		}
		for _, batch := range changeBatches(changes, state.Snapshots) {
			<section class="tokens-section tokens-timeline-batch">
				<h2 class="md-typescale-title-medium">Observed <time datetime={ batch.DetectedAt }>{ observationDate(batch.DetectedAt) }</time></h2>
				if batch.PreviousAt != "" {
					<p class="tokens-metadata">Compared with { observationDate(batch.PreviousAt) }</p>
				}
		for _, group := range changeGroups(batch.Changes, state.Subjects) {
			if subject == "" {
				<article class="tokens-change-summary">
					<h3 class="md-typescale-title-medium">
						if group.URL != "" {
							<a class="tokens-link" href={ group.URL }>{ group.Label }</a>
						} else {
							{ group.Label }
						}
					</h3>
					<p>
						if changedItemCount(group.Changes) == 1 {
							1 item changed
						} else {
							{ changedItemCount(group.Changes) } items changed
						}
					</p>
					<a class="tokens-link" href={ groupChangelogURL(baseURL, group, batch.Changes[0].SnapshotID) }>
						View changes
						@materialSymbol("chevron_right")
					</a>
				</article>
			} else {
				if group.URL != "" {
					<p><a class="tokens-link" href={ group.URL }>Browse tokens</a></p>
				}
				@changeRecordList(group.Changes)
			}
		}
			</section>
		}
		if hasPrevious || hasNext {
			<nav class="tokens-pagination" aria-label="Change log pages">
				if hasPrevious {
					<a class="tokens-link" href={ changesPageURL(baseURL, page - 1) }>Previous</a>
				}
				<span class="md-typescale-body-small">Page { page }</span>
				if hasNext {
					<a class="tokens-link" href={ changesPageURL(baseURL, page + 1) }>Next</a>
				}
			</nav>
		}
}
}

templ changeFilterForm(filters changeFilters, baseURL string) {
	<form class="tokens-change-filters" method="get" action={ strings.SplitN(baseURL, "?", 2)[0] }>
		if !filters.FixedSubject {
			<label>Component or style<span class="md-outlined-select"><select name="subject"><option value="">All components and styles</option>
				for _, option := range filters.Subjects {
					<option value={ option.Value } selected?={ option.Value == filters.Subject }>{ option.Label }</option>
				}
			</select><span data-slot="trailing-icon">@materialSymbol("expand_more")</span></span></label>
		}
		<label>Observed<span class="md-outlined-select"><select name="snapshot"><option value="">All dates</option>
			for _, option := range filters.Snapshots {
				<option value={ option.Value } selected?={ option.Value == filters.Snapshot }>{ option.Label }</option>
			}
		</select><span data-slot="trailing-icon">@materialSymbol("expand_more")</span></span></label>
		<label>Change<span class="md-outlined-select"><select name="type">
			<option value="">All changes</option>
			<option value="changed" selected?={ filters.Type == "changed" }>Updated</option>
			<option value="added" selected?={ filters.Type == "added" }>Added</option>
			<option value="removed" selected?={ filters.Type == "removed" }>Removed</option>
		</select><span data-slot="trailing-icon">@materialSymbol("expand_more")</span></span></label>
		<label>Token name<input class="md-outlined-text-field" type="search" name="q" value={ filters.Query } placeholder="e.g. width or font"/></label>
		<div class="tokens-change-filter-actions">
			<button class="md-button md-filled-button" type="submit">Apply filters</button>
			<a class="tokens-link" href={ strings.SplitN(baseURL, "?", 2)[0] }>Reset</a>
		</div>
	</form>
}

templ changeRecordList(changes []labeledChange) {
		for _, change := range changes {
			<details class="md-card md-outlined-card tokens-change-card tokens-change-disclosure">
				<summary class="tokens-change-heading">
					@materialSymbol("chevron_right")
					<h4>{ change.Name }</h4>
					<span class="tokens-change-status" data-change-type={ change.Type }>{ changeTypeLabel(change.Type) }</span>
					if context := changeContext(change.ChangeView); context != "" {
						<span class="tokens-change-context tokens-change-context-summary">{ context }</span>
					}
				</summary>
				if len(change.Hierarchy) > 0 {
					<ol class="tokens-change-hierarchy" aria-label="Token hierarchy">
						for index, part := range change.Hierarchy {
							<li>
								if index > 0 {
									@materialSymbol("chevron_right")
								}
								{ part }
							</li>
							}
					</ol>
				}
				<table class="tokens-change-table">
					<thead><tr><th scope="col">Property</th><th scope="col">Previous value</th><th scope="col">New value</th></tr></thead>
					<tbody>
						for _, value := range changedValues(change.ChangeView) {
							<tr><th scope="row">{ value.Field }</th><td>{ value.Before }</td><td>{ value.After }</td></tr>
						}
					</tbody>
				</table>
			</details>
		}
}


templ forAgentsPage(prompt string, mcpURL string) {
    @layout("Give this to your agent") {
        <header class="tokens-section">
            <h1 class="md-typescale-headline-medium">Give this to your agent</h1>
            <p class="md-typescale-body-large">Use Material Design 3 token data in your coding agent. No account or API key is required.</p>
        </header>
        <div class="tokens-handoff-grid">
            <section class="md-card md-elevated-card tokens-card-content" aria-labelledby="skill-heading">
                <h2 class="md-typescale-title-medium" id="skill-heading">Install the skill</h2>
                <p>For clients that support Agent Skills. Choose your agent in the installer.</p>
                <pre id="agent-skill" class="md-card md-outlined-card tokens-code-block" tabindex="0" aria-labelledby="skill-heading"><code>npx skills add sojupie/tokens --skill token-catalog</code></pre>
                <button class="md-button md-filled-button" type="button" data-copy-target="agent-skill" hidden>Copy install command</button>
                <p class="tokens-copy-status" data-copy-status aria-live="polite"></p>
                <a class="tokens-link" href="https://github.com/sojupie/tokens/blob/main/skills/token-catalog/SKILL.md">Read the skill</a>
            </section>
            <section class="md-card md-filled-card tokens-card-content tokens-secondary-option" aria-labelledby="prompt-heading">
                <h2 class="md-typescale-title-medium" id="prompt-heading">Copy a prompt</h2>
                <pre id="agent-prompt" class="md-card md-outlined-card tokens-code-block" tabindex="0" aria-labelledby="prompt-heading"><code>{ prompt }</code></pre>
                <button class="md-button md-elevated-button" type="button" data-copy-target="agent-prompt" hidden>Copy prompt</button>
                <p class="tokens-copy-status" data-copy-status aria-live="polite"></p>
            </section>
            <section class="md-card md-filled-card tokens-card-content tokens-secondary-option" aria-labelledby="mcp-heading">
                <h2 class="md-typescale-title-medium" id="mcp-heading">Connect with MCP</h2>
                <p>Add this URL as a Streamable HTTP server in your client.</p>
                <pre id="agent-mcp" class="md-card md-outlined-card tokens-code-block" tabindex="0" aria-labelledby="mcp-heading"><code>{ mcpURL }</code></pre>
                <button class="md-button md-elevated-button" type="button" data-copy-target="agent-mcp" hidden>Copy MCP URL</button>
                <p class="tokens-copy-status" data-copy-status aria-live="polite"></p>
                <p>Start with <code>list_subjects</code>, then use <code>get_tokens</code> with the returned kind and slug.</p>
            </section>
        </div>
        <section class="tokens-section" aria-labelledby="reference-heading">
            <h2 class="md-typescale-title-medium" id="reference-heading">API reference</h2>
            <p>Request parameters, response formats, and download scopes.</p>
            <a class="tokens-link" href="/llms-full.txt">API and data reference</a>
            <a class="tokens-link" href="/openapi.json">OpenAPI schema</a>
        </section>
        <script src={ staticURL("agent-handoff.js") } defer></script>
    }
}

templ buttonGalleryPage(page buttonGallery) {
 @layout("Material Design 3 buttons") {
  <h1 class="md-typescale-headline-medium">Buttons</h1>
  <p class="md-typescale-body-medium">{ fmt.Sprint(page.Mapped) } source tokens mapped. Press a button to try its shape animation and ripple.</p>
  <form class="tokens-gallery-filters" method="get">
   @gallerySelect("variant", "Variant", append([]string{"all"}, page.Variants...), page.Filters["variant"])
   @gallerySelect("size", "Size", append([]string{"all"}, page.Sizes...), page.Filters["size"])
   @gallerySelect("shape", "Shape", []string{"all","round","square"}, page.Filters["shape"])
   @gallerySelect("selection", "Selection", []string{"all","plain","unselected","selected"}, page.Filters["selection"])
   @gallerySelect("state", "State", []string{"all","enabled","hovered","focused","pressed","disabled"}, page.Filters["state"])
   <button type="submit" class="md-button md-filled-button">Apply</button>
  </form>
  <div class="tokens-button-gallery">
   for _, c := range page.Cases {
    <article class="md-card md-outlined-card tokens-button-example">
     <p class="md-typescale-body-small">{ c.Label() }</p>
     <button { c.Attributes()... }>@materialSymbol("check")<span>Button</span></button>
    </article>
   }
  </div>
 }
}

templ gallerySelect(name string, label string, options []string, selected string) {
 <label class="md-typescale-body-medium">{ label }
  <span class="md-outlined-select"><select name={ name }>
   for _, option := range options {
    <option value={ option } selected?={ option==selected }>{ option }</option>
   }
  </select><span data-slot="trailing-icon">@materialSymbol("expand_more")</span></span>
 </label>
}

templ componentGalleryPage(page componentGallery) {
 @layout("Material Design 3 Component Gallery") {
  <section class="tokens-section">
   <h1 class="md-typescale-headline-medium">Material Design 3 component gallery</h1>
   <p>{ fmt.Sprint(page.Mapped) } mapped source tokens · { fmt.Sprint(page.Excluded) } documented exclusions · { fmt.Sprint(len(page.Cases)) } configurations</p>
   <form method="get" class="tokens-gallery-filters">
    @gallerySelect("family", "Family", []string{"all","card","icon","chip","radio","field","select","menu","dialog","divider"}, page.Family)
    <button class="md-button md-outlined-button" type="submit">Apply filters</button>
   </form>
   <div class="tokens-component-gallery">
    for _, c := range page.Cases {
     <figure class="tokens-component-example">
      <figcaption class="md-typescale-body-small">{ c.Label() }</figcaption>
      switch c.Family {
       case "card":
        <a href={ "#"+c.ID() } { c.Attributes()... }><span>Card title</span><p>Supporting text</p><span data-slot="icon">@materialSymbol("check")</span></a>
       case "icon":
        <button { c.Attributes()... }>@materialSymbol("check")</button>
       case "chip":
        <label { c.Attributes()... }><input class="tokens-visually-hidden" type="checkbox" checked?={ c.Selected } disabled?={ c.State=="disabled" }/><span class="md-chip-face">@materialSymbol("check")<span>Filter chip</span></span></label>
       case "radio":
        <input { c.Attributes()... }/>
       case "field":
        <div { c.Attributes()... }><label for={ c.ID() } data-slot="label">Label</label><input id={ c.ID() } aria-describedby={ c.ID()+"-help" } placeholder="Input text" disabled?={ c.State=="disabled" } aria-invalid={ fmt.Sprint(c.Invalid) }/><small id={ c.ID()+"-help" } data-slot="supporting-text">Supporting text</small></div>
       case "select":
        <span { c.Attributes()... }><select aria-label="Select value" disabled?={ c.State=="disabled" } aria-invalid={ fmt.Sprint(c.Invalid) }><option>Selected value</option><option>Another value</option></select><span data-slot="trailing-icon">@materialSymbol("expand_more")</span></span>
       case "menu":
        <nav class="md-menu" data-variant={ c.Variant } aria-label={ c.Label() }><section><h3>Section</h3><a href={ "#"+c.ID() } { c.Attributes()... }>@materialSymbol("check")<span>Menu item</span><small data-slot="trailing-supporting-text">⌘K</small></a></section></nav>
       case "dialog":
        <section { c.Attributes()... }><h2>Dialog headline</h2><p>Supporting text</p><footer><button class="md-button md-text-button" type="button">Cancel</button><button class="md-button md-text-button" type="button">Confirm</button></footer></section>
       case "divider":
        <hr { c.Attributes()... }/>
      }
     </figure>
    }
   </div>
  </section>
 }
}
