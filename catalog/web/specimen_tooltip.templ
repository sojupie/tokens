package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenTooltip(c componentCase) {
	@useComponentAssets("messages")
	if c.State=="interactive" {
		<div class="md-tooltip-demo">
			if c.Variant=="plain" {
				<button class="md-icon-button md-standard-icon-button" type="button" aria-label="Details" aria-describedby={ c.ID() + "-tip" }>
					@materialSymbol("info")
				</button>
				@ui.Tooltip(ui.TooltipProps{ID: c.ID() + "-tip", Variant: "plain", Text: "More information", Attrs: c.Attributes()})
			} else {
				<button class="md-button md-outlined-button" type="button" popovertarget={ c.ID() + "-tip" } aria-haspopup="dialog">Show details</button>
				@ui.Tooltip(tooltipExampleProps(c, false))
			}
		</div>
	} else {
		@ui.Tooltip(tooltipExampleProps(c, true))
	}
}

templ tooltipExampleAction(c componentCase) {
	if c.Variant=="rich" {
		<button { c.FeedbackAttributes("md-button md-text-button md-feedback-action")... } data-size="xsmall" data-tooltip-close>Got it</button>
	}
}

func tooltipExampleProps(c componentCase, inline bool) ui.TooltipProps {
	title := ""
	if c.Variant == "rich" {
		title = "Details"
	}
	return ui.TooltipProps{ID: c.ID() + "-tip", Variant: c.Variant, Title: title, Text: "More information about this action.", Inline: inline, Attrs: c.Attributes(), Actions: tooltipExampleAction(c)}
}
