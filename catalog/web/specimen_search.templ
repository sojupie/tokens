package web

import "github.com/sojupie/tokens/forge/components/ui"

templ specimenSearch(c componentCase) {
	@playgroundSearch(c)
}

templ searchScene(c componentCase) {
	@useComponentAssets("list")
	@useComponentAssets("search")
	<div class="md-search-scene">
		<section class="md-search-page">
			if c.Variant=="adaptive" {
				<h3 data-search-folder-title>Inbox</h3>
				<div class="md-list-demo md-search-messages">
					@ui.List(ui.ListProps{Attrs: c.SearchMessageList()}) {
						for index,label:=range searchExamples {
							@ui.ListRowFrame(ui.ListRowFrameProps{Attrs: templ.Attributes{"data-list-row": "", "data-list-label": label}, ContentAttrs: c.SearchMessageItem(index, label), Content: searchExampleMessage(index, label)})
						}
					}
					<output class="tokens-visually-hidden" aria-live="polite"></output>
				</div>
			} else {
				<h3 data-search-page-title>Component library</h3>
				<p data-search-page-description>Find controls and patterns for your next screen.</p>
				<article><strong>Buttons and actions</strong><p>Choose how people take action.</p></article>
				<article><strong>Content and navigation</strong><p>Organize information and help people find it.</p></article>
				<article><strong>Inputs and selection</strong><p>Collect information and show available choices.</p></article>
			}
		</section>
		if c.Variant!="adaptive" {
			@searchScrim()
		}
		@searchView(c)
		if c.Shape=="menu" {
			@ui.NavigationSurface(c.SearchNavigationPanel(), true) {
				@navigationContents(c.SearchNavigation())
			}
		}
	</div>
}

templ searchCompositionNavigation(c componentCase) {
	@useComponentAssets("navigation")
	@useComponentAssets("fab")
	@ui.NavigationSurface(c.SearchMailNavigation(), false) {
		<header>
			@ui.Button(c.SearchCompose()) {
				@materialSymbol("edit")
			}
		</header>
		@ui.NavigationItems() {
			for index,label:=range []string{"Inbox","Chat","Spaces"} {
				@ui.Button(c.SearchMailDestination(index)) {
					@navigationItemContents(searchMailNavigation(), index, label, []string{"mail", "chat", "groups"}[index])
				}
			}
		}
		<output class="tokens-visually-hidden" aria-live="polite"></output>
	}
}

templ searchScrim() {
	@ui.SearchScrim()
}

templ searchView(c componentCase) {
	@ui.SearchView(c.searchProps("Search tokens", c.SearchQuery(), true)) {
		for _,label:=range searchExamples {
			@ui.SearchResult(label)
		}
	}
}

templ searchBar(c componentCase, label string) {
	@searchBarValue(c, label, c.SearchQuery())
}

templ searchBarValue(c componentCase, label, value string) {
	@searchBarContent(c, label, value, true)
}

templ searchBarContent(c componentCase, label, value string, disclosure bool) {
	@ui.SearchBar(c.searchProps(label, value, disclosure), label, value, disclosure)
}

templ searchBarSurface(c componentCase, label, value string) {
	@ui.SearchBarSurface(c.searchProps(label, value, false))
}

templ searchExampleOptions(id string) {
	@ui.CheckboxField(ui.ChoiceProps{ID: id + "-exact-names", Label: "Match exact names", InputAttrs: templ.Attributes{"data-search-exact": true}})
}

templ searchExampleMessage(index int, label string) {
	@listItemContents(searchMessageList(), index, listItemContent{Label: label, Supporting: "Review the latest component updates and examples.", Overline: "Design team", Avatar: "D", Metadata: "09:30"})
}
