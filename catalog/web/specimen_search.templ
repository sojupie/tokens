package web

import "fmt"

templ specimenSearch(c componentCase) {
	<div { c.Attributes()... }>
		if c.Variant=="adaptive" {
			<label class="md-search-composition-size">Composition width <input type="range" min="320" max="1200" value="1200" step="1" data-search-composition-width/><output data-search-composition-width-label>Fit to available space</output></label>
			<div class="md-search-workspace">
				<div class="md-search-app">
					<div class="md-search-mail-navigation">
						@searchCompositionNavigation(c)
					</div>
					@searchScene(c)
					<section { c.SearchMessageSurface()... } aria-label="Message"><button type="button" class="md-icon-button md-standard-icon-button md-search-message-back" data-size="small" data-shape="round" data-search-message-back aria-label="Back to inbox">@materialSymbol("arrow_back")
</button><h3 data-search-page-title tabindex="-1">Buttons</h3><p class="md-search-mail-sender">Design team · 09:30</p><p>Hello,</p><p data-search-page-description>Review the latest component updates and examples.</p><p>The updated examples are ready for review. Let us know what you think.</p><button { c.SearchReply()... }>@materialSymbol("reply")
<span>Reply</span></button></section>
					@searchScrim()
				</div>
			</div>
		} else {
			@searchScene(c)
		}
		<output class="md-typescale-body-small" data-search-feedback aria-live="polite"></output>
	</div>
}

templ searchActions(c componentCase) {
	<div class="md-search-actions">
		if c.SearchHasAction("clear") {
			<span class="md-search-action-target" hidden?={ c.SearchQuery()=="" } data-search-clear-target><button class="md-icon-button md-standard-icon-button md-search-action" data-size="small" data-shape="round" type="button" aria-label="Clear search" data-search-clear>@materialSymbol("close")
</button></span>
		}
		if c.SearchHasAction("settings") {
			<span class="md-search-action-target"><button class="md-icon-button md-standard-icon-button md-search-action" data-size="small" data-shape="round" type="button" aria-label="Search options" popovertarget={ c.SearchOptionsID() }>@materialSymbol("settings_outline")
</button></span>
			<div class="md-search-options" id={ c.SearchOptionsID() } popover="auto" role="dialog" aria-label="Search options"><label><input type="checkbox" data-search-exact/>Match exact names</label></div>
		}
		if c.SearchHasAction("avatar") {
			<button class="md-icon-button md-standard-icon-button md-search-avatar" data-size="small" data-shape="round" type="button" aria-label="Profile"><span aria-hidden="true">A</span></button>
		}
	</div>
}

templ searchScene(c componentCase) {
	<div class="md-search-scene">
		<section class="md-search-page">
			if c.Variant=="adaptive" {
				<h3 data-search-folder-title>Inbox</h3>
				<div class="md-list-demo md-search-messages">
					<ul { c.SearchMessageList()... }>
						for index,label:=range searchExamples {
							<li data-list-row data-list-label={ label }><div class="md-list-row"><button { c.SearchMessageItem(index,label)... }>@listItemContents(searchMessageList(), index, listItemContent{Label: label, Supporting: "Review the latest component updates and examples.", Overline: "Design team", Avatar: "D", Metadata: "09:30"})
</button></div></li>
						}
					</ul>
					<output class="tokens-visually-hidden" aria-live="polite"></output>
				</div>
			} else {
				<h3 data-search-page-title>Component library</h3>
				<p data-search-page-description>Find controls and patterns for your next screen.</p>
				<article><strong>Buttons and actions</strong><p>Choose how people take action.</p></article>
				<article><strong>Content and navigation</strong><p>Organize information and help people find it.</p></article>
				<article><strong>Inputs and selection</strong><p>Collect information and show available choices.</p></article>
			}
		</section>
		if c.Variant!="adaptive" {
			@searchScrim()
		}
		@searchView(c)
		if c.Shape=="menu" {
			<dialog { c.SearchNavigationPanel()... }>@navigationContents(c.SearchNavigation())
</dialog>
		}
	</div>
}

templ searchCompositionNavigation(c componentCase) {
	<nav { c.SearchMailNavigation()... } aria-label="Example mail navigation">
		<header>
			<button { c.SearchCompose()... }>
				@materialSymbol("edit")
			</button>
		</header>
		<div class="md-nav-items">
			for index,label:=range []string{"Inbox","Chat","Spaces"} {
				<button { c.SearchMailDestination(index)... }>@navigationItemContents(searchMailNavigation(), index, label, []string{"mail", "chat", "groups"}[index])
</button>
			}
		</div>
		<output class="tokens-visually-hidden" aria-live="polite"></output>
	</nav>
}

templ searchScrim() {
	<button class="md-search-scrim" type="button" aria-label="Dismiss search" tabindex="-1" hidden></button>
}

templ searchView(c componentCase) {
	<div { c.SearchPanel()... }>
		<div { c.SearchBar()... }>
			<span class="md-search-leading-slot">
				if c.Shape=="icon" {
					<span class="md-search-leading" aria-hidden="true">@materialSymbol("search")
</span>
				}
				if c.Shape=="menu" {
					<button class="md-icon-button md-standard-icon-button md-search-navigation" data-size="small" data-shape="round" type="button" data-search-navigation aria-label="Open navigation" aria-haspopup="dialog" aria-controls={ c.ID() + "-navigation" }>@materialSymbol("menu")
</button>
				}
				<button class="md-icon-button md-standard-icon-button md-search-back" data-size="small" data-shape="round" type="button" aria-label="Close search" data-search-back hidden?={ !c.Expanded }>@materialSymbol("arrow_back")
</button>
			</span>
			<input type="search" class="md-search-input" aria-label="Search tokens" aria-expanded={ fmt.Sprint(c.Expanded) } aria-controls={ c.ID() + "-results" } placeholder="Search tokens" value={ c.SearchQuery() } autocomplete="off" readonly?={ !c.Expanded }/>
			@searchActions(c)
		</div>
		<div class={ "md-search-results",templ.KV("md-elevation",c.SearchElevation=="token") } id={ c.ID() + "-results" } hidden?={ !c.Expanded }>
			<h3 class="md-search-results-heading" data-search-heading tabindex="-1">Suggestions</h3>
			<ul class="md-list" data-size="one-line" data-shape="baseline" aria-label="Search suggestions and results">
				for _, label := range searchExamples {
					<li data-search-result={ label }><button class="md-list-item" type="button"><span class="md-list-leading md-list-icon" aria-hidden="true">@materialSymbol("search")
</span><span class="md-list-body"><span class="md-list-label">{ label }</span></span></button></li>
				}
			</ul>
			<p class="md-typescale-body-medium" data-search-empty hidden>No results</p>
		</div>
		<output class="md-search-status" aria-live="polite"></output>
	</div>
}
