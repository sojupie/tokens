package web

import "github.com/sojupie/tokens/forge/site"

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"historyCacheSize":0,"historyRestoreAsHxRequest":false}'/>
			@initialThemeScript()
			<script src={ staticURL("theme.js") } defer></script>
			<link rel="stylesheet" href={ themeURL(ctx) }/>
			<link rel="stylesheet" href={ staticURL("app.css") }/>
			<link rel="stylesheet" href={ staticURL("token-table.css") }/>
			<link rel="stylesheet" href={ staticURL("buttons.css") }/>
			<link rel="stylesheet" href={ staticURL("bundles/common.css") }/>
			<script src={ staticURL("motion.js") } defer></script>
			<script src={ staticURL("buttons.js") } defer></script>
			<script src={ staticURL("runtime/utils.js") } defer></script>
<script src={staticURL("runtime/navigation.js")} defer></script>
			<script src={ staticURL("fields.js") } defer></script>
			<script src={ staticURL("site-ui.js") } defer></script>
<script src={ staticURL("site.js") } defer></script>
			<script src={ staticURL("menus.js") } defer></script>
			<script src={ staticURL("htmx.min.js") } defer></script>
			<script src={ staticURL("token-table.js") } defer></script>
			<script src={ staticURL("webmcp.js") } defer></script>
			<script src={ staticURL("prefetch.js") } defer></script>
			<script src={ staticURL("asset-loader.js") } data-sources={ componentScriptSources() } data-shapes-version={ loadingGeometry.version } defer></script>
			<link rel="icon" type="image/webp" sizes="250x250" href={ staticURL("logo-250x250.webp") }/>
			<link rel="apple-touch-icon" href={ staticURL("logo-250x250.png") }/>
			<title>{ pageTitle(ctx, title) } | Token Catalog</title>
			<meta name="description" content={ metadata(ctx).Description }/>
			if metadata(ctx).AgentDiscovery {
				<link rel="describedby" href="/agents.json" type="application/json"/>
				<link rel="describedby" href="/llms.txt" type="text/plain"/>
				<link rel="service-desc" href="/openapi.json" type="application/json"/>
				<link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json"/>
				<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json"/>
			}
			if metadata(ctx).JSONAlternate != "" {
				<link rel="alternate" href={ templ.SafeURL(metadata(ctx).JSONAlternate) } type="application/json" title="Token data for this view"/>
			}
			if metadata(ctx).Canonical != "" {
				<link rel="canonical" href={ templ.SafeURL(metadata(ctx).Canonical) }/>
			}
			if metadata(ctx).NoIndex {
				<meta name="robots" content="noindex, follow"/>
			}
		</head>
		<body class="tokens-body" hx-boost="true">
			@componentAssetScope() {
 @useComponentAssets("navigation")
 @site.Header(siteConfig(ctx)) {
						<div class="tokens-theme-controls" role="group" aria-label="Site appearance">
							<button class="md-icon-button md-standard-icon-button" type="button" data-app-theme aria-label="Dark mode" aria-pressed="false" title="Dark mode" disabled>
								<span data-theme-icon="light">
									@materialSymbol("dark_mode")
								</span>
								<span data-theme-icon="dark" hidden>
									@materialSymbol("light_mode")
								</span>
							</button>
							<div class="tokens-contrast-buttons" role="group" aria-label="Contrast">
								<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="default" aria-label="Standard contrast" aria-pressed="true" title="Standard contrast" disabled>
									@materialSymbol("brightness_low")
								</button>
								<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="medium" aria-label="Medium contrast" aria-pressed="false" title="Medium contrast" disabled>
									@materialSymbol("brightness_medium")
								</button>
								<button class="md-icon-button md-filled-icon-button" type="button" data-app-contrast="high" aria-label="High contrast" aria-pressed="false" title="High contrast" disabled>
									@materialSymbol("brightness_high")
								</button>
							</div>
						</div>
 }
 }
			<main class="tokens-main" data-component-assets>
				@componentAssetScope() {
					{ children... }
				}
			</main>
			@site.Footer(siteConfig(ctx)) {
 @componentAssetScope() { @siteDownloadMenu() }
 }
		</body>
	</html>
}
