package web

import "github.com/sojupie/tokens/forge/components/ui"

import "github.com/sojupie/tokens/forge/site"

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"compat":{"suppressInheritanceLogs":true}}'/>
			@initialThemeScript()
			<script src={ staticURL("theme.js") } defer></script>
			<link rel="stylesheet" href={ themeURL(ctx) }/>
			<link rel="stylesheet" href={ staticURL("site.css") }/>
			<link rel="stylesheet" href={ staticURL("app.css") }/>
			<link rel="stylesheet" href={ staticURL("token-table.css") }/>
			<link rel="stylesheet" href={ staticURL("buttons.css") }/>
			<link rel="stylesheet" href={ staticURL("bundles/common.css") }/>
			@siteNavigationStyles()
			<script src={ staticURL("motion.js") } defer></script>
			<script src={ staticURL("buttons.js") } defer></script>
			<script src={ staticURL("runtime/utils.js") } defer></script>
			<script src={ staticURL("runtime/navigation.js") } defer></script>
			<script src={ staticURL("fields.js") } defer></script>
			<script src={ staticURL("site-ui.js") } defer></script>
			<script src={ staticURL("export.js") } defer></script>
			<script src={ staticURL("site.js") } defer></script>
			<script src={ staticURL("menus.js") } defer></script>
			<script src={ staticURL("htmx.min.js") } defer></script>
			<script src={ staticURL("htmx-2-compat.min.js") } defer></script>
			<script src={ staticURL("hx-head.min.js") } defer></script>
			<script src={ staticURL("token-table.js") } defer></script>
			<script src={ staticURL("webmcp.js") } defer></script>
			<script src={ staticURL("prefetch.js") } defer></script>
			<script src={ staticURL("asset-loader.js") } data-sources={ componentScriptSources() } data-shapes-version={ loadingGeometryVersion } defer></script>
			<link rel="icon" type="image/svg+xml" href={ staticURL("logo.svg") }/>
			<link rel="apple-touch-icon" href={ staticURL("logo-250x250.png") }/>
			<title>{ pageTitle(ctx, title) } | Token Catalog</title>
			<meta name="description" content={ metadata(ctx).Description }/>
			if metadata(ctx).ImageURL!="" {
				<meta property="og:type" content="website"/>
				<meta property="og:site_name" content="Token Catalog"/>
				<meta property="og:title" content={ pageTitle(ctx, title) + " | Token Catalog" }/>
				<meta property="og:description" content={ metadata(ctx).Description }/>
				<meta property="og:url" content={ metadata(ctx).ImagePageURL }/>
				<meta property="og:image" content={ metadata(ctx).ImageURL }/>
				<meta property="og:image:width" content="1200"/>
				<meta property="og:image:height" content="630"/>
				<meta property="og:image:type" content="image/jpeg"/>
				<meta property="og:image:alt" content={ metadata(ctx).ImageAlt }/>
				<meta name="twitter:card" content="summary_large_image"/>
				<meta name="twitter:image" content={ metadata(ctx).ImageURL }/>
				<meta name="twitter:image:alt" content={ metadata(ctx).ImageAlt }/>
			}
			if metadata(ctx).AgentDiscovery {
				<link rel="describedby" href="/agents.json" type="application/json"/>
				<link rel="describedby" href="/llms.txt" type="text/plain"/>
				<link rel="service-desc" href="/openapi.json" type="application/json"/>
				<link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json"/>
				<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json"/>
			}
			if metadata(ctx).JSONAlternate != "" {
				<link rel="alternate" href={ templ.SafeURL(metadata(ctx).JSONAlternate) } type="application/json" title="Token data for this view"/>
			}
			if metadata(ctx).Canonical != "" {
				<link rel="canonical" href={ templ.SafeURL(metadata(ctx).Canonical) }/>
			}
			if metadata(ctx).NoIndex {
				<meta name="robots" content="noindex, follow"/>
			}
		</head>
		<body class="tokens-body" hx-boost="true">
			<template hx type="partial" hx-target="#tokens-site-destinations" hx-swap="innerHTML">@site.Destinations(siteConfig(ctx))
</template>
			@componentAssetScope() {
				@useComponentAssets("navigation")
				@site.Header(siteConfig(ctx)) {
					<div class="tokens-theme-controls" role="group" aria-label="Site appearance">
						@ui.IconButtonContent(ui.IconButtonProps{Variant: "standard", Label: "Dark mode", Attrs: templ.Attributes{"type": "button", "data-app-theme": true, "aria-pressed": "false", "title": "Dark mode"}, Disabled: true}) {
							<span data-theme-icon="light">
								@materialSymbol("dark_mode")
							</span>
							<span data-theme-icon="dark" hidden>
								@materialSymbol("light_mode")
							</span>
						}
						<div class="tokens-contrast-buttons" role="group" aria-label="Contrast">
							@ui.IconButtonContent(ui.IconButtonProps{Variant: "filled", Label: "Standard contrast", Attrs: templ.Attributes{"type": "button", "data-app-contrast": "default", "aria-pressed": "true", "title": "Standard contrast"}, Disabled: true}) {
								@materialSymbol("brightness_low")
							}
							@ui.IconButtonContent(ui.IconButtonProps{Variant: "filled", Label: "Medium contrast", Attrs: templ.Attributes{"type": "button", "data-app-contrast": "medium", "aria-pressed": "false", "title": "Medium contrast"}, Disabled: true}) {
								@materialSymbol("brightness_medium")
							}
							@ui.IconButtonContent(ui.IconButtonProps{Variant: "filled", Label: "High contrast", Attrs: templ.Attributes{"type": "button", "data-app-contrast": "high", "aria-pressed": "false", "title": "High contrast"}, Disabled: true}) {
								@materialSymbol("brightness_high")
							}
						</div>
					</div>
				}
			}
			<div class="tokens-layout tokens-layout-site">
				<main class="tokens-main tokens-layout-content" data-component-assets>
					@componentAssetScope() {
						{ children... }
					}
				</main>
				@site.Footer(siteConfig(ctx)) {
					@componentAssetScope() {
						@siteDownloadMenu()
					}
				}
			</div>
		</body>
	</html>
}
