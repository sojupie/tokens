package web

import "github.com/sojupie/tokens/forge/components/ui"

templ tableContextDialog(filters []tokenFilter) {
	@ui.Modal(ui.DialogProps{ID: "tokens-context-picker", TitleID: "tokens-context-title", Title: "See more values", Attrs: templ.Attributes{"class": "tokens-context-dialog tokens-export-dialog"}, Actions: contextDialogActions()}) {
		<p>Compare token values by selecting another context.</p>
		<div class="tokens-context-fields">
			for _, filter := range tableContextFilters(filters, false) {
				@tableContextChoices(filter)
			}
			if extra := tableContextFilters(filters, true); len(extra)>0 {
				<details class="tokens-context-advanced tokens-export-disclosure">
					<summary>
						<span class="tokens-export-disclosure-label"><span class="tokens-export-title">More contexts</span></span><span class="tokens-export-chevron" aria-hidden="true">@materialSymbol("expand_more")</span>
					</summary>
					<div class="tokens-export-context-options">
						for _, filter := range extra {
							@tableContextChoices(filter)
						}
					</div>
				</details>
			}
		</div>
		<p class="tokens-context-status" role="status" aria-live="polite"></p>
	}
}

templ tableContextChoices(filter tokenFilter) {
	if filter.Name=="Audience" {
		@exportChoices(filter.Key, filter.Name, filter.Selected, tableContextOptions(filter), false, audienceContextHelp())
	} else {
		@exportChoices(filter.Key, filter.Name, filter.Selected, tableContextOptions(filter), false)
	}
}

templ audienceContextHelp() {
	@ui.TooltipHost(templ.Attributes{"class": "tokens-context-help"}) {
		@ui.IconButton(ui.IconButtonProps{Label: "What do 1P and 3P mean?", Icon: "info", Size: ui.ExtraSmall, Attrs: templ.Attributes{"popovertarget": "tokens-audience-help", "aria-haspopup": "dialog"}})
		@ui.Tooltip(ui.TooltipProps{ID: "tokens-audience-help", Title: "What do 1P and 3P mean?", Variant: "rich", Body: audienceHelpBody()})
	}
}

templ audienceHelpBody() {
	<p>1P means first-party; 3P means third-party. We interpret <strong>1P Baseline</strong> as the configuration for Google’s own products, and <strong>3P</strong> as the configuration for other developers.</p>
	<p>Material supplies these audience labels but does not define them in the captured data. They are not a baseline-versus-Expressive switch.</p>
}

templ contextDialogActions() {
	@ui.Action(ui.ButtonProps{Variant: ui.Text, Attrs: templ.Attributes{"data-action": "cancel"}}) {
		Cancel
	}
	@ui.Action(ui.ButtonProps{Type: "submit"}) {
		Save
	}
}
