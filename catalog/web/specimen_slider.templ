package web

import "fmt"

templ specimenSlider(c componentCase) {
	@useComponentAssets("slider")
	<div { c.SliderAttributes()... } role="group" aria-label="Slider preview">
		<div class="md-slider-rail" aria-hidden="true">
			<span class="md-slider-inactive md-slider-before"></span><span class="md-slider-active"></span><span class="md-slider-inactive md-slider-after"></span>
			<span class="md-slider-stop md-slider-stop-start"></span><span class="md-slider-stop md-slider-stop-end"></span>
			if c.Variant=="discrete" {
				for _, value := range c.SliderTicks() {
					<span class="md-slider-tick" style={ templ.SafeCSS(fmt.Sprintf("--_slider-tick:%d%%", value)) } data-value={ fmt.Sprint(value) }></span>
				}
			}
			if icon := c.SliderInsetIcon(); icon != "" {
                <span class="md-slider-icon md-slider-leading" data-slider-inset="">@materialSymbol(icon)</span>
            }
		</div>
		for _,handle:=range c.SliderHandles() {
			<div { c.SliderHandle(handle)... }>
				<input { c.SliderInput(handle)... }/>
				<span class="md-slider-thumb" aria-hidden="true"><span class="md-slider-state-layer"></span><span class="md-slider-nub"></span><span class="md-slider-value">{ c.SliderValue(handle) }</span></span>
			</div>
		}
	</div>
}
