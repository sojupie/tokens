# Email alerts for failures and updates needing review.
# Leave all SMTP fields empty to disable email.
# Port 587 requires STARTTLS; port 465 uses TLS from the start.
# Use your provider's SMTP credentials, not necessarily your account password.
TOKENS_SMTP_HOST=
TOKENS_SMTP_PORT=
TOKENS_SMTP_USERNAME=
TOKENS_SMTP_PASSWORD=
TOKENS_SMTP_FROM=
TOKENS_SMTP_TO=

# Optional JSON webhook. Email does not need this.
TOKENS_NOTIFY_WEBHOOK=
