[Unit]
Description=Crawl and publish Material tokens
Wants=network-online.target
After=network-online.target
OnFailure=tokens-update-failure.service

[Service]
Type=oneshot
User=tokens
Group=tokens
StateDirectory=tokens
WorkingDirectory=/var/lib/tokens
EnvironmentFile=-/etc/tokens/update.env
ExecStart=/usr/local/bin/tokens update run --state-dir /var/lib/tokens --page-catalog /etc/tokens/page-catalog.json --chrome-path /usr/bin/chromium --timeout 1h
ExecStartPost=+/usr/bin/systemctl try-restart tokens.service
TimeoutStartSec=75min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
