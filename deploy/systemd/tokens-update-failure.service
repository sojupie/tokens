[Unit]
Description=Notify the administrator when a token update fails
Wants=network-online.target
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/tokens
ExecStart=/usr/bin/docker compose -f /opt/tokens/deploy/compose.yaml run --rm --no-deps --name tokens-update-alert updater update alert --state-dir /var/lib/tokens
ExecStopPost=-/usr/bin/docker stop --time 10 tokens-update-alert
ExecStopPost=-/usr/bin/docker rm -f tokens-update-alert
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
