[Unit]
Description=Material token browser
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/var/lib/tokens/current/tokens.sqlite

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/tokens
ExecStart=/usr/bin/docker compose -f /opt/tokens/deploy/compose.yaml up -d --wait tokens cloudflared
ExecStop=/usr/bin/docker compose -f /opt/tokens/deploy/compose.yaml stop tokens cloudflared
TimeoutStartSec=3min

[Install]
WantedBy=multi-user.target
