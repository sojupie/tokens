[Unit]
Description=Material token browser
After=network.target
ConditionPathExists=/var/lib/tokens/current/tokens.sqlite

[Service]
User=tokens
Group=tokens
WorkingDirectory=/var/lib/tokens
Environment=TOKENS_LISTEN=127.0.0.1:8080
EnvironmentFile=-/etc/tokens/server.env
ExecStart=/usr/local/bin/tokens serve --published /var/lib/tokens/current --listen ${TOKENS_LISTEN} --public-origin https://tokens.marmenlind.com
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
